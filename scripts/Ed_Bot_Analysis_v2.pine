//@version=6
// EdBot v3 — разметка как у Ed (docs + нефть). НЕ EdStory. Стратегия: Ed_Bot_Strategy_v1.pine
indicator("Ed Bot Analysis v4.3", shorttitle="EdBot", overlay=true, max_boxes_count=56, max_lines_count=144, max_labels_count=100)

// ═══════════════════════════════════════════════════════════
//  Профиль «Ed clean» — один клик; «Полный» — все галочки ниже.
// ═══════════════════════════════════════════════════════════
grpProf = "Профиль"
i_profile = input.string("Разметка Ed", "Режим разметки", options=["Разметка Ed", "Ed clean", "Полный", "Только паттерны"], group=grpProf, tooltip="Разметка Ed: структура + один план ▲/▼ (E/SL/TP на графике, подписи — цены). Ed clean: Beluga+карточка. Полный: галочки.")

grp = "На графике (галочка = слой)"
i_sr      = input.bool(true,  "1. Сопр. / Подд. (структура)", group=grp, tooltip="Жёлтый/синий = ближайшие свинги для триггера. Пунктир = контекст lookback.")
i_ctxRng  = input.bool(true,  "1b. Контекст LB (пунктир)", group=grp, tooltip="Hi/Lo всего окна — только ориентир, не триггер сделки.")
i_zone    = input.bool(true,  "2. Зона OB (имп+vol)", group=grp, tooltip="Order block / breaker — одна зона без «кирпичей» (см. 2a).")
i_zoneOne = input.bool(true,  "2a. Только одна зона на экране", group=grp, tooltip="Не рисовать полосу подд. + demand + supply друг на друге.")
i_wedge   = input.bool(true,  "3. △ / клин (PDF-паттерны)", group=grp, tooltip="Восход./нисход./симметр. △ как в шпаргалке: вход=пробой, SL=за противоп. грань, TP=высота базы H.")
i_triPdf  = input.bool(true,  "3b. Уровни Вход/Стоп/Цель △", group=grp, tooltip="Рисует пунктиром цели по measured move (ширина △ at start).")
i_pat     = input.bool(true,  "4. Графический паттерн (2× / ГиП / 1-2-3)", group=grp, tooltip="M/W, голова-плечи, 1-2-3 — шея и цель на графике; forming = пунктир.")
i_fib     = input.bool(false, "5. Сетка Fib (0–100 + золотая зона)", group=grp, tooltip="Включай для отката; для чистого входа — OFF.")
i_smc     = input.bool(false, "6. SMC: BOS + FVG + свип (по идее)", group=grp, tooltip="FVG только после BOS и retest; свип — если в «главной идее».")
i_path    = input.bool(false, "7. Прогноз хода (зигзаг) — OFF", group=grp, tooltip="Рекомендуется выключено: декоративный зигзаг не вход Ed-разбора.")
i_story   = input.bool(true,  "8. Карточка входа (HUD)", group=grp, tooltip="ДЕЙСТВИЕ · фигура · триггеры · edge — закреплена в углу графика.")
i_storyPos = input.string("Вверху справа", "Позиция карточки", options=["Вверху справа", "Над ценой"], group=grp)
i_boxes   = input.bool(true,  "9. План сделки (Beluga L/S)", group=grp, tooltip="SL/TP EdBot: linefill + ◉ + TP1/2 + ✔/✖.")
i_onePos  = input.bool(true,  "9a. Одна главная позиция", group=grp, tooltip="Не рисовать L и S вместе — только сценарий по ХОДу/действию.")
i_posStyle = input.string("Beluga", "Стиль позиции", options=["Beluga", "TV боксы"], group=grp, tooltip="Beluga: linefill красный SL→вход, зелёный вход→TP, подписи ◉ и 1·2. TV: цветные боксы.")
i_dualPos = input.bool(false, "9b. ЖДАТЬ: оба триггера L+S", group=grp, tooltip="Только если нужны два «что если»; иначе шум.")
i_posW    = input.int(20, "Ширина блока позиции (баров)", minval=12, maxval=48, group=grp)
i_posHits = input.bool(true, "9c. ✔ TP / ✖ SL при касании", group=grp)
i_candleMode = input.string("barcolor", "Свечи по ХОДу", options=["off", "barcolor", "plotcandle"], group=grp, tooltip="barcolor — тонировка без дубля. plotcandle — как Beluga (может перекрыть свечи TV).")

grpW = "Толщина линий"
i_wSR    = input.int(2, "Сопр. / Подд.", minval=1, maxval=6, group=grpW)
i_wWedge = input.int(3, "Клин / △", minval=1, maxval=6, group=grpW)
i_wFib   = input.int(1, "Сетка Fib", minval=1, maxval=4, group=grpW)
i_wPath  = input.int(2, "Прогноз хода", minval=1, maxval=5, group=grpW)
i_wPat   = input.int(2, "Паттерн / шея", minval=1, maxval=5, group=grpW)

grpP = "Параметры"
i_lb      = input.int(90, "Lookback разметки (баров)", minval=40, maxval=200, group=grpP, tooltip="Размер клина и диапазона. 90 ≈ как ручной разбор на 15m.")
i_swing   = input.int(3, "Окно свинга", minval=2, maxval=5, group=grpP, tooltip="Сколько баров слева/справа для pivot. Меньше (2–3) = больше свингов, чувствительнее. Больше (4–5) = глаже, медленнее. Если ±1 меняет ХОД — смотри строку edge в карточке входа.")
i_minConf = input.float(0.52, "MIN confidence фигуры", minval=0.48, maxval=0.80, step=0.01, group=grpP)
i_dtol    = input.float(0.85, "Допуск 2× вершины %", minval=0.2, maxval=2.0, step=0.05, group=grpP)
i_patSpanMin = input.int(4, "Паттерн: min баров между pivots", minval=3, maxval=12, group=grpP)
i_patSpanMax = input.int(68, "Паттерн: max баров между pivots", minval=24, maxval=100, group=grpP)
i_hstol   = input.float(2.2, "Допуск плеч ГиП %", minval=1.0, maxval=4.0, step=0.1, group=grpP)
i_rsiLen  = input.int(14, "RSI длина", minval=5, maxval=28, group=grpP)
i_rsiOB   = input.int(70, "RSI перекупленность", minval=60, maxval=85, group=grpP)
i_rsiOS   = input.int(30, "RSI перепроданность", minval=15, maxval=40, group=grpP)

grpT = "Сделка (хирургия)"
i_minRR     = input.float(1.15, "Min R:R для SL/TP", minval=1.0, maxval=2.5, step=0.05, group=grpT, tooltip="Если TP1 ближе чем SL — Beluga не рисуем, в карточке «нет edge».")
i_minQual   = input.string("B", "Min качество для SL/TP", options=["A", "B", "C"], group=grpT, tooltip="Боксы только при A или B (или C если выбрано C).")
i_surgical  = input.bool(true, "Вход на триггере (не chase)", group=grpT, tooltip="R:R считается от longPx/shortPx, не от текущей close.")
i_mtf       = input.bool(true, "Сверка 60m vs текущий TF", group=grpT)
i_autoClean = input.bool(true, "Меньше слоёв на 30m+", group=grpT, tooltip="SMC/зигзаг скрываются на старших TF — меньше «налеплено».")

grpSt = "Стабильность (без «прыжков»)"
i_sweepMem  = input.int(32, "Память свипа (баров)", minval=8, maxval=80, group=grpSt, tooltip="Свип учитывается в ХОДе N баров после закрытия свечи, уровень не меняется.")
i_freezePath = input.bool(true, "ХОД/голоса только на close", group=grpSt, tooltip="Пока свеча не закрылась — не пересчитывать сценарий (нет смены на каждом тике).")
i_histPat   = input.bool(false, "Паттерн: только confirmed (OFF = показывать forming)", group=grpSt, tooltip="OFF — видна формирующаяся 2×/ГиП с шеей; ON — только после пробоя шеи.")
i_patFocus  = input.bool(true, "Паттерн важнее △-шума", group=grpSt, tooltip="Если есть 2×/ГиП — не рисовать «черновой» клин поверх.")
i_oneIdea   = input.bool(true, "Одна идея на графике (иерархия)", group=grpSt, tooltip="На хвосте не рисуем FVG+свип+клин одновременно — только то, что в «Главная идея».")
i_wedgeMinT = input.int(2, "Мин. касаний границы клина", minval=2, maxval=4, group=grpSt)

bool profFull = i_profile == "Полный"
bool profClean = i_profile == "Ed clean"
bool profPatOnly = i_profile == "Только паттерны"
bool profMarkup = i_profile == "Разметка Ed"
bool eff_sr = profFull ? i_sr : true
bool eff_ctxRng = profFull ? i_ctxRng : profMarkup
bool eff_zone = profFull ? i_zone : profMarkup or profClean
bool eff_zoneOne = profFull ? i_zoneOne : true
bool eff_wedge = profFull ? i_wedge : profMarkup or profClean
bool eff_triPdf = profFull ? i_triPdf : profMarkup or profClean
bool eff_pat = profFull ? i_pat : not profMarkup
bool eff_fib = profFull ? i_fib : false
bool eff_smc = profFull ? i_smc : profMarkup
bool eff_path = profFull ? i_path : false
bool eff_story = profFull ? i_story : profClean
bool eff_boxes = profFull ? i_boxes : profClean
bool eff_onePos = profFull ? i_onePos : profClean
bool eff_dualPos = profFull ? i_dualPos : false
bool eff_patFocus = profFull ? i_patFocus : profMarkup ? false : true
string eff_candleMode = profFull ? i_candleMode : "off"
bool eff_oneIdeaDraw = profMarkup ? false : i_oneIdea
bool mkCompact = profMarkup

// ── helpers ──
f_rr(float entry, float sl, float tp, bool isLong) =>
    float risk = math.abs(entry - sl)
    float rew = isLong ? tp - entry : entry - tp
    risk > syminfo.mintick ? rew / risk : 0.0
float atr = ta.atr(14)
float volSma20 = ta.sma(volume, 20)
float bodySz = math.abs(close - open)
f_pct(float a, float b) => math.abs(a - b) / math.max(math.abs(a), 1e-10) * 100.0
f_y(float y1, int x1, float y2, int x2, int x) =>
    y1 + (y2 - y1) * (x - x1) / math.max(x2 - x1, 1)
f_fib(float top, float bot, float r) => top - (top - bot) * r

f_struct_lbl(int tr) =>
    tr == 1 ? "HH·HL" : tr == -1 ? "LH·LL" : "боковик"

// trend 1 bull / -1 bear / 0 chop; last swing hi/lo; BOS on close vs last pivot
f_mkt_struct(int sw) =>
    var float lSh = na
    var float pSh = na
    var float lSl = na
    var float pSl = na
    float ph = ta.pivothigh(high, sw, sw)
    float pl = ta.pivotlow(low, sw, sw)
    if not na(ph)
        pSh := lSh
        lSh := ph
    if not na(pl)
        pSl := lSl
        lSl := pl
    int tr = 0
    if not na(lSh) and not na(pSh) and not na(lSl) and not na(pSl)
        tr := lSh > pSh and lSl > pSl ? 1 : lSh < pSh and lSl < pSl ? -1 : 0
    bool bosU = not na(lSh) and close > lSh
    bool bosD = not na(lSl) and close < lSl
    [tr, lSh, lSl, bosU, bosD]

colW = #e6edf3
colY = #f0c040
colB = #58a6ff
colG = #3fb950
colR = #f85149
colO = #f0883e
colP = #a371f7
colMuted = #8b949e
colBg = #161b22

// ── swings ──
int SW = 18
var float[] shP = array.new_float()
var int[]   shX = array.new_int()
var float[] slP = array.new_float()
var int[]   slX = array.new_int()
float ph = ta.pivothigh(high, i_swing, i_swing)
float pl = ta.pivotlow(low, i_swing, i_swing)
if not na(ph)
    array.push(shP, ph)
    array.push(shX, bar_index - i_swing)
    while array.size(shP) > SW
        array.shift(shP)
        array.shift(shX)
if not na(pl)
    array.push(slP, pl)
    array.push(slX, bar_index - i_swing)
    while array.size(slP) > SW
        array.shift(slP)
        array.shift(slX)

int xNow = bar_index
int xL0  = math.max(0, xNow - i_lb)
int xR   = xNow + 28

f_first_hi_in(int fromX) =>
    int ix = na
    float px = na
    if array.size(shX) > 0
        for i = 0 to array.size(shX) - 1
            int xx = array.get(shX, i)
            if xx >= fromX and na(ix)
                ix := xx
                px := array.get(shP, i)
    [ix, px]

f_last_hi() =>
    int n = array.size(shX)
    int ix = n > 0 ? array.get(shX, n - 1) : na
    float px = n > 0 ? array.get(shP, n - 1) : na
    [ix, px]

f_first_lo_in(int fromX) =>
    int ix = na
    float px = na
    if array.size(slX) > 0
        for i = 0 to array.size(slX) - 1
            int xx = array.get(slX, i)
            if xx >= fromX and na(ix)
                ix := xx
                px := array.get(slP, i)
    [ix, px]

f_last_lo() =>
    int n = array.size(slX)
    int ix = n > 0 ? array.get(slX, n - 1) : na
    float px = n > 0 ? array.get(slP, n - 1) : na
    [ix, px]

f_swing_res_above(float px) =>
    float best = na
    if array.size(shP) > 0
        for i = 0 to array.size(shP) - 1
            float v = array.get(shP, i)
            if v >= px - syminfo.mintick * 4
                best := na(best) ? v : math.min(best, v)
    best

f_swing_sup_below(float px) =>
    float best = na
    if array.size(slP) > 0
        for i = 0 to array.size(slP) - 1
            float v = array.get(slP, i)
            if v <= px + syminfo.mintick * 4
                best := na(best) ? v : math.max(best, v)
    best

// ── range ──
float rngHi = ta.highest(high, i_lb)
float rngLo = ta.lowest(low, i_lb)
float rngW  = rngHi - rngLo
float structRes = f_swing_res_above(close)
float structSup = f_swing_sup_below(close)
if na(structRes) and array.size(shP) > 0
    structRes := array.get(shP, array.size(shP) - 1)
if na(structSup) and array.size(slP) > 0
    structSup := array.get(slP, array.size(slP) - 1)
structRes := na(structRes) ? rngHi : structRes
structSup := na(structSup) ? rngLo : structSup
float structW = math.max(structRes - structSup, syminfo.mintick * 8)
float posR  = structW > 0 ? (close - structSup) / structW : 0.5
float posRctx = rngW > 0 ? (close - rngLo) / rngW : 0.5
bool  inMid = posR > 0.32 and posR < 0.68

[ctfTr, ctfSh, ctfSl, ctfBosU, ctfBosD] = f_mkt_struct(i_swing)
int htfSw = math.max(2, i_swing - 1)
[htfTr, htfSh, htfSl, htfBosU, htfBosD] = request.security(syminfo.tickerid, "60", f_mkt_struct(htfSw), lookahead=barmerge.lookahead_off)
string ctxStructRu = "60m " + f_struct_lbl(int(htfTr)) + (htfBosU ? " · BOS↑" : htfBosD ? " · BOS↓" : "")
string trdStructRu = timeframe.period + " " + f_struct_lbl(ctfTr) + (ctfBosU ? " · BOS↑" : ctfBosD ? " · BOS↓" : "")

// OB / breaker: последний импульс + объём
var float demTop = na
var float demBot = na
var int   demBar = na
var bool  demBrk = false
var float supTop = na
var float supBot = na
var int   supBar = na
var bool  supBrk = false
if barstate.isconfirmed
    bool bullImp = close > open and bodySz > atr * 0.82 and volume > volSma20 * 1.08
    bool bearImp = close < open and bodySz > atr * 0.82 and volume > volSma20 * 1.08
    if bullImp
        demTop := math.max(open, close)
        demBot := low
        demBar := bar_index
        demBrk := false
    if bearImp
        supTop := high
        supBot := math.min(open, close)
        supBar := bar_index
        supBrk := false
    if not na(demBot) and close < demBot - syminfo.mintick * 2
        demBrk := true
    if not na(supTop) and close > supTop + syminfo.mintick * 2
        supBrk := true

bool inDemand = not na(demBot) and not demBrk and close >= demBot - atr * 0.08 and close <= demTop + atr * 0.22
bool inSupply = not na(supTop) and not supBrk and close <= supTop + atr * 0.08 and close >= supBot - atr * 0.22
bool brkDemand = demBrk and close >= demBot and close <= demTop
bool brkSupply = supBrk and close <= supTop and close >= supBot
string zoneRu = inDemand ? "спрос " + str.tostring(demBot, format.mintick) + "–" + str.tostring(demTop, format.mintick) : inSupply ? "предложение " + str.tostring(supBot, format.mintick) + "–" + str.tostring(supTop, format.mintick) : brkDemand ? "breaker↓ бывш. спрос" : brkSupply ? "breaker↑ бывш. предлож." : "вне OB"

// Ретest структурных уровней: пробили → вернулись → удержали / провал
var int resSt = 0
var int supSt = 0
if barstate.isconfirmed
    float rtTol = atr * 0.28
    if close > structRes
        if resSt == 0
            resSt := 1
    if resSt == 1 and low <= structRes + rtTol
        resSt := 2
    if resSt == 2
        resSt := close > structRes ? 3 : close < structRes - rtTol ? 4 : 2
    if close < structRes - rtTol * 1.2 and resSt >= 3
        resSt := 0
    if close < structSup
        if supSt == 0
            supSt := 1
    if supSt == 1 and high >= structSup - rtTol
        supSt := 2
    if supSt == 2
        supSt := close < structSup ? 3 : close > structSup + rtTol ? 4 : 2
    if close > structSup + rtTol * 1.2 and supSt >= 3
        supSt := 0

f_retest_lbl(int st) =>
    st == 0 ? "до пробоя" : st == 1 ? "пробили" : st == 2 ? "вернулись" : st == 3 ? "удержали" : "провал retest"

string retResRu = "сопр.: " + f_retest_lbl(resSt)
string retSupRu = "подд.: " + f_retest_lbl(supSt)

// Объём: откат слабее импульса + див. на новом экстремуме
float volUpSum = 0.0
float volDnSum = 0.0
int nUpV = 0
int nDnV = 0
for vi = 0 to 11
    if close[vi] > open[vi]
        volUpSum += volume[vi]
        nUpV += 1
    else if close[vi] < open[vi]
        volDnSum += volume[vi]
        nDnV += 1
float avgVolUp = nUpV > 0 ? volUpSum / nUpV : volSma20
float avgVolDn = nDnV > 0 ? volDnSum / nDnV : volSma20
bool volPullBull = avgVolDn < avgVolUp * 0.92
bool volPullBear = avgVolUp < avgVolDn * 0.92
bool volBearDivPx = false
bool volBullDivPx = false
if array.size(shP) >= 2 and array.size(shX) >= 2
    int bxA = bar_index - array.get(shX, array.size(shX) - 2)
    int bxB = bar_index - array.get(shX, array.size(shX) - 1)
    if bxA >= 0 and bxB >= 0 and array.get(shP, array.size(shP) - 1) > array.get(shP, array.size(shP) - 2) and volume[bxB] < volume[bxA] * 0.9
        volBearDivPx := true
if array.size(slP) >= 2 and array.size(slX) >= 2
    int bxA = bar_index - array.get(slX, array.size(slX) - 2)
    int bxB = bar_index - array.get(slX, array.size(slX) - 1)
    if bxA >= 0 and bxB >= 0 and array.get(slP, array.size(slP) - 1) < array.get(slP, array.size(slP) - 2) and volume[bxB] < volume[bxA] * 0.9
        volBullDivPx := true
string volRu = volBearDivPx ? "новый high · vol слабее" : volBullDivPx ? "новый low · vol слабее" : volPullBull ? "откат вверх · vol OK" : volPullBear ? "откат вниз · vol OK" : "нейтрально"

// ── impulse + fib (якорь на реальных экстремумах ноги) ──
int fibLb = math.min(i_lb, 80)
float impHi = ta.highest(high, fibLb)
float impLo = ta.lowest(low, fibLb)
int hiAgo = int(-ta.highestbars(high, fibLb))
int loAgo = int(-ta.lowestbars(low, fibLb))
bool impUp = loAgo > hiAgo
int xFib0 = xNow - math.max(hiAgo, loAgo)
int xFib1 = xNow - math.min(hiAgo, loAgo)
float f0   = impUp ? impHi : impLo
float f100 = impUp ? impLo : impHi
float f236 = impUp ? f_fib(impHi, impLo, 0.236) : impLo + (impHi - impLo) * 0.236
float f382 = impUp ? f_fib(impHi, impLo, 0.382) : impLo + (impHi - impLo) * 0.382
float f50  = impUp ? f_fib(impHi, impLo, 0.500) : impLo + (impHi - impLo) * 0.500
float f618 = impUp ? f_fib(impHi, impLo, 0.618) : impLo + (impHi - impLo) * 0.618
float f786 = impUp ? f_fib(impHi, impLo, 0.786) : impLo + (impHi - impLo) * 0.786
float f886 = impUp ? f_fib(impHi, impLo, 0.886) : impLo + (impHi - impLo) * 0.886
float f127 = impUp ? impHi + (impHi - impLo) * 0.272 : impLo - (impHi - impLo) * 0.272
float f161 = impUp ? impHi + (impHi - impLo) * 0.618 : impLo - (impHi - impLo) * 0.618

// ── RSI ──
float rsi = ta.rsi(close, i_rsiLen)
bool rsiOB = rsi >= i_rsiOB
bool rsiOS = rsi <= i_rsiOS
bool rsiBearDiv = false
bool rsiBullDiv = false
if array.size(shP) >= 2 and array.size(shX) >= 2
    int aH = xNow - array.get(shX, array.size(shX) - 2)
    int bH = xNow - array.get(shX, array.size(shX) - 1)
    if aH >= 0 and bH >= 0 and array.get(shP, array.size(shP) - 1) > array.get(shP, array.size(shP) - 2) and rsi[bH] < rsi[aH] - 1.5
        rsiBearDiv := true
if array.size(slP) >= 2 and array.size(slX) >= 2
    int aL = xNow - array.get(slX, array.size(slX) - 2)
    int bL = xNow - array.get(slX, array.size(slX) - 1)
    if aL >= 0 and bL >= 0 and array.get(slP, array.size(slP) - 1) < array.get(slP, array.size(slP) - 2) and rsi[bL] > rsi[aL] + 1.5
        rsiBullDiv := true
string rsiRu = rsiOB ? "перекуплен " + str.tostring(rsi, "#.0") : rsiOS ? "перепродан " + str.tostring(rsi, "#.0") : str.tostring(rsi, "#.0") + (rsiBearDiv ? " · медв. див." : rsiBullDiv ? " · быч. див." : "")
[_, _, adxVal] = ta.dmi(14, 14)
string trendStrRu = adxVal < 18 ? "слабый ADX " + str.tostring(adxVal, "#.0") : adxVal < 26 ? "умеренный " + str.tostring(adxVal, "#.0") : "сильный " + str.tostring(adxVal, "#.0")
bool isHtf = timeframe.in_seconds() >= 1800

// ── SMC lite ──
bool fvgUp = low > high[2]
bool fvgDn = high < low[2]

// Свип = пробой СТРУКТУРНОГО уровня (пред. свинг) + close ЗАКРЫТОЙ свечи [1] обратно внутрь
var int   sweepBearBar = na
var float sweepBearLvl = na
var float sweepBearY = na
var int   sweepBullBar = na
var float sweepBullLvl = na
var float sweepBullY = na
if barstate.isconfirmed
    float shRef = array.size(shP) >= 2 ? array.get(shP, array.size(shP) - 2) : na
    float slRef = array.size(slP) >= 2 ? array.get(slP, array.size(slP) - 2) : na
    if not na(shRef) and high[1] > shRef and close[1] < shRef
        sweepBearBar := bar_index - 1
        sweepBearLvl := shRef
        sweepBearY := high[1]
    if not na(slRef) and low[1] < slRef and close[1] > slRef
        sweepBullBar := bar_index - 1
        sweepBullLvl := slRef
        sweepBullY := low[1]

bool sweepHiAct = not na(sweepBearBar) and bar_index - sweepBearBar <= i_sweepMem
bool sweepLoAct = not na(sweepBullBar) and bar_index - sweepBullBar <= i_sweepMem
string sweepZoneTag = sweepLoAct and (inDemand or brkDemand) ? " · в зоне спроса" : sweepHiAct and (inSupply or brkSupply) ? " · в зоне предлож." : sweepLoAct and htfTr >= 0 ? " · HTF не медв." : sweepHiAct and htfTr <= 0 ? " · HTF не быч." : ""
string sweepRu = sweepHiAct ? "свип ↑ @ " + str.tostring(sweepBearLvl, format.mintick) + " · " + str.tostring(bar_index - sweepBearBar) + " бар" + sweepZoneTag : sweepLoAct ? "свип ↓ @ " + str.tostring(sweepBullLvl, format.mintick) + " · " + str.tostring(bar_index - sweepBullBar) + " бар" + sweepZoneTag : "не зафиксирован"

var bool bosUpMemo = false
var bool bosDnMemo = false
if barstate.isconfirmed
    bosUpMemo := array.size(shP) > 0 and close > array.get(shP, array.size(shP) - 1)
    bosDnMemo := array.size(slP) > 0 and close < array.get(slP, array.size(slP) - 1)
bool bosUp = bosUpMemo
bool bosDn = bosDnMemo

// FVG после импульса: последний bull/bear gap + не заполнен + в зоне retest
var int   fvgBar = na
var float fvgTop = na
var float fvgBot = na
var bool  fvgBull = false
if barstate.isconfirmed
    fvgBar := na
    for k = 2 to math.min(36, xNow)
        if na(fvgBar)
            bool u = low[k] > high[k + 2]
            bool d = high[k] < low[k + 2]
            if u
                fvgBar := bar_index - k
                fvgBot := high[k + 2]
                fvgTop := low[k]
                fvgBull := true
            else if d
                fvgBar := bar_index - k
                fvgBot := high[k]
                fvgTop := low[k + 2]
                fvgBull := false
int fvgAge = na(fvgBar) ? 999 : bar_index - fvgBar
bool fvgFresh = fvgAge <= 48
float fvgWinLo = ta.lowest(low, 49)
float fvgWinHi = ta.highest(high, 49)
bool fvgUnfilled = fvgFresh and not na(fvgBot) and (fvgBull ? fvgWinLo >= fvgBot - syminfo.mintick * 2 : fvgWinHi <= fvgTop + syminfo.mintick * 2)
bool fvgRetest = fvgUnfilled and (fvgBull ? close >= fvgBot and close <= fvgTop + atr * 0.35 : close <= fvgTop and close >= fvgBot - atr * 0.35)
bool fvgSetup = fvgRetest and ((fvgBull and bosUpMemo) or (not fvgBull and bosDnMemo))
float hi12 = ta.highest(high, 12)
float lo12 = ta.lowest(low, 12)
bool obBull = close > hi12[1] and close > open and volume > volSma20 * 1.15
bool obBear = close < lo12[1] and close < open and volume > volSma20 * 1.15

// ── pattern scan (last bar) ──
var string patKind = ""
var string patSt   = ""
var string patDir  = ""
var float  patConf = 0.0
var float  patNeck = na
var float  patTgt  = na
var float  patStp  = na
var int    pI1 = na
var int    pI2 = na
var int    pI3 = na
var float  pP1 = na
var float  pP2 = na
var float  pP3 = na
var float  pNL = na
var float  pNR = na
var int    pNLx = na
var int    pNRx = na
var string patKind2 = ""
var float  patNeck2 = na
var int    p2I1 = na
var int    p2I2 = na
var float  p2P1 = na
var float  p2P2 = na

if barstate.islast and (barstate.isconfirmed or not i_freezePath)
    string cK = ""
    string cS = ""
    string cD = ""
    float  cC = 0.0
    float  cN = na
    float  cT = na
    float  cSp = na
    int    i1 = na
    int    i2 = na
    int    i3 = na
    float  y1 = na
    float  y2 = na
    float  y3 = na
    float  nL = na
    float  nR = na
    int    nLx = na
    int    nRx = na
    float  best = 0.0
    string cKc = ""
    string cSc = ""
    string cDc = ""
    float  cCc = 0.0
    float  cNc = na
    float  cTc = na
    float  cSpc = na
    int    i1c = na
    int    i2c = na
    int    i3c = na
    float  y1c = na
    float  y2c = na
    float  y3c = na
    float  nLc = na
    float  nRc = na
    int    nLxc = na
    int    nRxc = na
    float  bestC = 0.0
    string cKc2 = ""
    string cSc2 = ""
    float  cCc2 = 0.0
    float  cNc2 = na
    int    i1c2 = na
    int    i2c2 = na
    float  y1c2 = na
    float  y2c2 = na
    float  bestC2 = 0.0

    // double top
    if array.size(shP) >= 2
        for i = math.max(0, array.size(shP) - 10) to array.size(shP) - 2
            float a = array.get(shP, i)
            float b = array.get(shP, i + 1)
            int xa = array.get(shX, i)
            int xb = array.get(shX, i + 1)
            if xb < xNow - i_lb or xb - xa < i_patSpanMin or xb - xa > i_patSpanMax or f_pct(a, b) > i_dtol
                continue
            float neck = na
            if array.size(slP) > 0
                for j = 0 to array.size(slP) - 1
                    int lx = array.get(slX, j)
                    if lx > xa and lx < xb
                        neck := na(neck) ? array.get(slP, j) : math.min(neck, array.get(slP, j))
            if na(neck)
                continue
            float h = math.max(a, b) - neck
            if h < atr * 0.52
                continue
            string st = close < neck ? "confirmed" : "forming"
            float conf = 0.56 + (f_pct(a, b) < 0.45 ? 0.10 : 0.0) + (st == "confirmed" ? 0.14 : 0.08) + (xb >= xNow - i_lb ? 0.04 : 0.0)
            if conf >= i_minConf and conf >= best
                best := conf
                cK := "double_top"
                cS := st
                cD := "bearish"
                cC := conf
                cN := neck
                cT := neck - h
                cSp := math.max(a, b) + atr * 0.2
                i1 := xa
                i2 := xb
                y1 := a
                y2 := b
            if st == "confirmed" and xb >= xNow - i_lb and conf >= i_minConf
                if conf >= bestC
                    if bestC >= i_minConf and i1c != i1
                        bestC2 := bestC
                        cKc2 := cKc
                        cSc2 := cSc
                        cCc2 := cCc
                        cNc2 := cNc
                        i1c2 := i1c
                        i2c2 := i2c
                        y1c2 := y1c
                        y2c2 := y2c
                    bestC := conf
                    cKc := "double_top"
                    cSc := st
                    cDc := "bearish"
                    cCc := conf
                    cNc := neck
                    cTc := neck - h
                    cSpc := math.max(a, b) + atr * 0.2
                    i1c := xa
                    i2c := xb
                    y1c := a
                    y2c := b
                else if conf >= bestC2 and i1 != i1c
                    bestC2 := conf
                    cKc2 := "double_top"
                    cSc2 := st
                    cCc2 := conf
                    cNc2 := neck
                    i1c2 := xa
                    i2c2 := xb
                    y1c2 := a
                    y2c2 := b

    // double bottom
    if array.size(slP) >= 2
        for i = math.max(0, array.size(slP) - 10) to array.size(slP) - 2
            float a = array.get(slP, i)
            float b = array.get(slP, i + 1)
            int xa = array.get(slX, i)
            int xb = array.get(slX, i + 1)
            if xb < xNow - i_lb or xb - xa < i_patSpanMin or xb - xa > i_patSpanMax or f_pct(a, b) > i_dtol
                continue
            float neck = na
            if array.size(shP) > 0
                for j = 0 to array.size(shP) - 1
                    int hx = array.get(shX, j)
                    if hx > xa and hx < xb
                        neck := na(neck) ? array.get(shP, j) : math.max(neck, array.get(shP, j))
            if na(neck)
                continue
            float h = neck - math.min(a, b)
            if h < atr * 0.52
                continue
            string st = close > neck ? "confirmed" : "forming"
            float conf = 0.56 + (f_pct(a, b) < 0.45 ? 0.10 : 0.0) + (st == "confirmed" ? 0.14 : 0.08) + (xb >= xNow - i_lb ? 0.04 : 0.0)
            if conf >= i_minConf and conf >= best
                best := conf
                cK := "double_bottom"
                cS := st
                cD := "bullish"
                cC := conf
                cN := neck
                cT := neck + h
                cSp := math.min(a, b) - atr * 0.2
                i1 := xa
                i2 := xb
                y1 := a
                y2 := b
            if st == "confirmed" and xb >= xNow - i_lb and conf >= i_minConf
                if conf >= bestC
                    if bestC >= i_minConf and i1c != i1
                        bestC2 := bestC
                        cKc2 := cKc
                        cSc2 := cSc
                        cCc2 := cCc
                        cNc2 := cNc
                        i1c2 := i1c
                        i2c2 := i2c
                        y1c2 := y1c
                        y2c2 := y2c
                    bestC := conf
                    cKc := "double_bottom"
                    cSc := st
                    cDc := "bullish"
                    cCc := conf
                    cNc := neck
                    cTc := neck + h
                    cSpc := math.min(a, b) - atr * 0.2
                    i1c := xa
                    i2c := xb
                    y1c := a
                    y2c := b
                else if conf >= bestC2 and i1 != i1c
                    bestC2 := conf
                    cKc2 := "double_bottom"
                    cSc2 := st
                    cCc2 := conf
                    cNc2 := neck
                    i1c2 := xa
                    i2c2 := xb
                    y1c2 := a
                    y2c2 := b

    // H&S — перебор triplet pivots в lookback
    if array.size(shP) >= 3
        for ii = 0 to array.size(shP) - 3
            int i = ii
            float ls = array.get(shP, i)
            float hd = array.get(shP, i + 1)
            float rs = array.get(shP, i + 2)
            int xs = array.get(shX, i)
            int xh = array.get(shX, i + 1)
            int xr = array.get(shX, i + 2)
            if xr < xNow - i_lb or xh - xs < i_patSpanMin or xr - xs > i_patSpanMax * 2
                continue
            if ls < hd and hd > rs and f_pct(ls, rs) <= i_hstol
                float nl = na
                float nr = na
                int nli = xs
                int nri = xr
                if array.size(slP) > 0
                    for j = 0 to array.size(slP) - 1
                        int lx = array.get(slX, j)
                        float lp = array.get(slP, j)
                        if lx > xs and lx < xh
                            nl := na(nl) ? lp : math.min(nl, lp)
                            nli := lx
                        if lx > xh and lx < xr
                            nr := na(nr) ? lp : math.min(nr, lp)
                            nri := lx
                if not na(nl) and not na(nr)
                    float neck = f_y(nl, nli, nr, nri, xr)
                    float h = hd - neck
                    if h >= atr * 0.85
                        string st = close < neck ? "confirmed" : "forming"
                        float conf = 0.60 + (st == "confirmed" ? 0.14 : 0.08) + (xr >= xNow - i_lb / 2 ? 0.04 : 0.0)
                        if conf >= i_minConf and conf >= best
                            best := conf
                            cK := "head_shoulders"
                            cS := st
                            cD := "bearish"
                            cC := conf
                            cN := neck
                            cT := neck - h
                            cSp := hd + atr * 0.15
                            i1 := xs
                            i2 := xh
                            i3 := xr
                            y1 := ls
                            y2 := hd
                            y3 := rs
                            nL := nl
                            nR := nr
                            nLx := nli
                            nRx := nri
                        if st == "confirmed" and xr >= xNow - i_lb and conf >= i_minConf and conf >= bestC
                            bestC := conf
                            cKc := "head_shoulders"
                            cSc := st
                            cDc := "bearish"
                            cCc := conf
                            cNc := neck
                            cTc := neck - h
                            cSpc := hd + atr * 0.15
                            i1c := xs
                            i2c := xh
                            i3c := xr
                            y1c := ls
                            y2c := hd
                            y3c := rs
                            nLc := nl
                            nRc := nr
                            nLxc := nli
                            nRxc := nri

    // inverse H&S
    if array.size(slP) >= 3
        for ii = 0 to array.size(slP) - 3
            int i = ii
            float ls = array.get(slP, i)
            float hd = array.get(slP, i + 1)
            float rs = array.get(slP, i + 2)
            int xs = array.get(slX, i)
            int xh = array.get(slX, i + 1)
            int xr = array.get(slX, i + 2)
            if xr < xNow - i_lb or xh - xs < i_patSpanMin or xr - xs > i_patSpanMax * 2
                continue
            if ls > hd and hd < rs and f_pct(ls, rs) <= i_hstol
                float nl = na
                float nr = na
                int nli = xs
                int nri = xr
                if array.size(shP) > 0
                    for j = 0 to array.size(shP) - 1
                        int hx = array.get(shX, j)
                        float hp = array.get(shP, j)
                        if hx > xs and hx < xh
                            nl := na(nl) ? hp : math.max(nl, hp)
                            nli := hx
                        if hx > xh and hx < xr
                            nr := na(nr) ? hp : math.max(nr, hp)
                            nri := hx
                if not na(nl) and not na(nr)
                    float neck = f_y(nl, nli, nr, nri, xr)
                    float h = neck - hd
                    if h >= atr * 0.85
                        string st = close > neck ? "confirmed" : "forming"
                        float conf = 0.60 + (st == "confirmed" ? 0.14 : 0.08) + (xr >= xNow - i_lb / 2 ? 0.04 : 0.0)
                        if conf >= i_minConf and conf >= best
                            best := conf
                            cK := "inverse_head_shoulders"
                            cS := st
                            cD := "bullish"
                            cC := conf
                            cN := neck
                            cT := neck + h
                            cSp := hd - atr * 0.15
                            i1 := xs
                            i2 := xh
                            i3 := xr
                            y1 := ls
                            y2 := hd
                            y3 := rs
                            nL := nl
                            nR := nr
                            nLx := nli
                            nRx := nri
                        if st == "confirmed" and xr >= xNow - i_lb and conf >= i_minConf and conf >= bestC
                            bestC := conf
                            cKc := "inverse_head_shoulders"
                            cSc := st
                            cDc := "bullish"
                            cCc := conf
                            cNc := neck
                            cTc := neck + h
                            cSpc := hd - atr * 0.15
                            i1c := xs
                            i2c := xh
                            i3c := xr
                            y1c := ls
                            y2c := hd
                            y3c := rs
                            nLc := nl
                            nRc := nr
                            nLxc := nli
                            nRxc := nri

    // 1-2-3 bear — scan пар LH + LL в lookback
    if array.size(shP) >= 2 and array.size(slP) >= 2
        for hi = math.max(0, array.size(shP) - 10) to array.size(shP) - 2
            float h1 = array.get(shP, hi)
            float h2 = array.get(shP, hi + 1)
            int xh1 = array.get(shX, hi)
            int xh2 = array.get(shX, hi + 1)
            if h2 >= h1 or xh2 - xh1 < i_patSpanMin or xh2 < xNow - i_lb
                continue
            for lo = math.max(0, array.size(slP) - 10) to array.size(slP) - 1
                float l2 = array.get(slP, lo)
                int xl2 = array.get(slX, lo)
                if xl2 <= xh2 or xl2 - xh2 > i_patSpanMax
                    continue
                float l1 = na
                int xl1 = na
                if lo >= 1
                    l1 := array.get(slP, lo - 1)
                    xl1 := array.get(slX, lo - 1)
                if na(l1) or l2 >= l1 or xl1 >= xl2
                    continue
                string st = close < l2 ? "confirmed" : "forming"
                float conf = 0.52 + (st == "confirmed" ? 0.14 : 0.08) + (xh2 >= xNow - i_lb / 2 ? 0.05 : 0.0)
                if conf >= i_minConf and conf >= best
                    best := conf
                    cK := "one_two_three"
                    cS := st
                    cD := "bearish"
                    cC := conf
                    cN := l2
                    cT := l2 - (h2 - l2)
                    cSp := h2 + atr * 0.2
                    i1 := xh1
                    i2 := xh2
                    i3 := xl2
                    y1 := h1
                    y2 := h2
                    y3 := l2
                if st == "confirmed" and xh2 >= xNow - i_lb and conf >= i_minConf and conf >= bestC
                    bestC := conf
                    cKc := "one_two_three"
                    cSc := st
                    cDc := "bearish"
                    cCc := conf
                    cNc := l2
                    cTc := l2 - (h2 - l2)
                    cSpc := h2 + atr * 0.2
                    i1c := xh1
                    i2c := xh2
                    i3c := xl2
                    y1c := h1
                    y2c := h2
                    y3c := l2

    // 1-2-3 bull — scan пар HL + HH в lookback
    if array.size(slP) >= 2 and array.size(shP) >= 2
        for lo = math.max(0, array.size(slP) - 10) to array.size(slP) - 2
            float l1 = array.get(slP, lo)
            float l2 = array.get(slP, lo + 1)
            int xl1 = array.get(slX, lo)
            int xl2 = array.get(slX, lo + 1)
            if l2 <= l1 or xl2 - xl1 < i_patSpanMin or xl2 < xNow - i_lb
                continue
            for hi = math.max(0, array.size(shP) - 10) to array.size(shP) - 2
                float h1 = array.get(shP, hi)
                float h2 = array.get(shP, hi + 1)
                int xh1 = array.get(shX, hi)
                int xh2 = array.get(shX, hi + 1)
                if h2 <= h1 or xh2 < xl2 or xh2 - xl2 > i_patSpanMax
                    continue
                string st = close > h2 ? "confirmed" : "forming"
                float conf = 0.52 + (st == "confirmed" ? 0.14 : 0.08) + (xl2 >= xNow - i_lb / 2 ? 0.05 : 0.0)
                if conf >= i_minConf and conf >= best
                    best := conf
                    cK := "one_two_three"
                    cS := st
                    cD := "bullish"
                    cC := conf
                    cN := h2
                    cT := h2 + (h2 - l2)
                    cSp := l2 - atr * 0.2
                    i1 := xl1
                    i2 := xl2
                    i3 := xh2
                    y1 := l1
                    y2 := l2
                    y3 := h2
                if st == "confirmed" and xl2 >= xNow - i_lb and conf >= i_minConf and conf >= bestC
                    bestC := conf
                    cKc := "one_two_three"
                    cSc := st
                    cDc := "bullish"
                    cCc := conf
                    cNc := h2
                    cTc := h2 + (h2 - l2)
                    cSpc := l2 - atr * 0.2
                    i1c := xl1
                    i2c := xl2
                    i3c := xh2
                    y1c := l1
                    y2c := l2
                    y3c := h2

    bool useHist = i_histPat and cKc != ""
    bool useForm = not useHist and cK != ""
    patKind := useHist ? cKc : useForm ? cK : cKc
    patSt := useHist ? cSc : useForm ? cS : cSc
    patDir := useHist ? cDc : useForm ? cD : cDc
    patConf := useHist ? cCc : useForm ? cC : cCc
    patNeck := useHist ? cNc : useForm ? cN : cNc
    patTgt := useHist ? cTc : useForm ? cT : cTc
    patStp := useHist ? cSpc : useForm ? cSp : cSpc
    pI1 := useHist ? i1c : useForm ? i1 : i1c
    pI2 := useHist ? i2c : useForm ? i2 : i2c
    pI3 := useHist ? i3c : useForm ? i3 : i3c
    pP1 := useHist ? y1c : useForm ? y1 : y1c
    pP2 := useHist ? y2c : useForm ? y2 : y2c
    pP3 := useHist ? y3c : useForm ? y3 : y3c
    pNL := useHist ? nLc : useForm ? nL : nLc
    pNR := useHist ? nRc : useForm ? nR : nRc
    pNLx := useHist ? nLxc : useForm ? nLx : nLxc
    pNRx := useHist ? nRxc : useForm ? nRx : nRxc
    patKind2 := cKc2
    patNeck2 := cNc2
    p2I1 := i1c2
    p2I2 := i2c2
    p2P1 := y1c2
    p2P2 := y2c2

string patRu = patKind == "double_top" ? "двойная вершина" : patKind == "double_bottom" ? "двойное дно" : patKind == "head_shoulders" ? "голова и плечи" : patKind == "inverse_head_shoulders" ? "перев. ГиП" : patKind == "one_two_three" ? "1-2-3" : ""

// ── wedge geometry (крупный, как ручная нефть) ──
[wHx0, wHy0] = f_first_hi_in(xL0)
[wHx1, wHy1] = f_last_hi()
[wLx0, wLy0] = f_first_lo_in(xL0)
[wLx1, wLy1] = f_last_lo()
bool wedgeGeom = eff_wedge and not na(wHx0) and not na(wHx1) and not na(wLx0) and not na(wLx1) and wHx1 != wHx0 and wLx1 != wLx0 and (wHx1 - wHx0) >= 12 and (wLx1 - wLx0) >= 12
bool patActive = patKind != "" and patConf >= i_minConf
int xW0g = wedgeGeom ? math.min(wHx0, wLx0) : na
float wTop0 = wedgeGeom ? f_y(wHy0, wHx0, wHy1, wHx1, xW0g) : na
float wBot0 = wedgeGeom ? f_y(wLy0, wLx0, wLy1, wLx1, xW0g) : na
float wTop1 = wedgeGeom ? f_y(wHy0, wHx0, wHy1, wHx1, xNow) : na
float wBot1 = wedgeGeom ? f_y(wLy0, wLx0, wLy1, wLx1, xNow) : na
float wWide0 = wedgeGeom ? wTop0 - wBot0 : na
float wWide1 = wedgeGeom ? wTop1 - wBot1 : na
float slopeH = wedgeGeom ? (wHy1 - wHy0) / math.max(wHx1 - wHx0, 1) : 0.0
float slopeL = wedgeGeom ? (wLy1 - wLy0) / math.max(wLx1 - wLx0, 1) : 0.0
bool wParallel = wedgeGeom and math.abs(slopeH - slopeL) <= math.max(math.abs(slopeH), math.abs(slopeL), 1e-8) * 0.28
bool wConverge = wedgeGeom and not wParallel and wWide1 < wWide0 * 0.88
bool wExpand = wedgeGeom and not wParallel and wWide1 > wWide0 * 1.08
int touchU = 0
int touchL = 0
float tolW = atr * 0.42
if wedgeGeom
    if array.size(shX) > 0
        for i = 0 to array.size(shX) - 1
            int xx = array.get(shX, i)
            if xx >= xW0g and xx <= xNow
                float yL = f_y(wHy0, wHx0, wHy1, wHx1, xx)
                if math.abs(array.get(shP, i) - yL) <= tolW
                    touchU += 1
    if array.size(slX) > 0
        for i = 0 to array.size(slX) - 1
            int xx = array.get(slX, i)
            if xx >= xW0g and xx <= xNow
                float yL = f_y(wLy0, wLx0, wLy1, wLx1, xx)
                if math.abs(array.get(slP, i) - yL) <= tolW
                    touchL += 1
bool figValid = wedgeGeom and touchU >= i_wedgeMinT and touchL >= i_wedgeMinT
bool wedgeOk = figValid
float wHiNow = wedgeOk ? wTop1 : na
float wLoNow = wedgeOk ? wBot1 : na
bool hiFall = wedgeGeom and wHy1 <= wHy0 * 1.001
bool loRise = wedgeGeom and wLy1 >= wLy0 * 0.999
bool hiRise = wedgeGeom and wHy1 > wHy0 * 1.001
bool loFall = wedgeGeom and wLy1 < wLy0 * 0.999
string wedgeRu = not wedgeGeom ? "" : not figValid ? "линии без касаний (" + str.tostring(touchU) + "/" + str.tostring(touchL) + ")" : wParallel ? (hiRise ? "канал ↑" : hiFall ? "канал ↓" : "канал") : wExpand ? "расширение" : wConverge and hiFall and loRise ? "сход. △" : wConverge and hiFall and loFall ? "клин ↓" : wConverge and hiRise and loRise ? "клин ↑" : wConverge ? "сходящийся △" : hiFall ? "нисход. △" : loRise ? "восход. △" : "канал"
bool wedgeBrUp = wedgeOk and close > wHiNow
bool wedgeBrDn = wedgeOk and close < wLoNow

float emaTri = ta.ema(close, 34)
float triFlatTol = wedgeGeom ? math.max(atr * 0.40, wWide0 * 0.065) : na
bool triTopFlat = wedgeGeom and math.abs(wHy1 - wHy0) <= triFlatTol
bool triBotFlat = wedgeGeom and math.abs(wLy1 - wLy0) <= triFlatTol
string triKind = ""
string triRu = wedgeRu
bool triLong = false
bool triShort = false
float triEntry = na
float triSl = na
float triTp = na
string triPlanRu = ""
if wedgeOk and wConverge
    if triTopFlat and loRise and not triBotFlat
        triKind := "asc"
        triRu := "восходящий △"
        triLong := true
        triEntry := wHiNow
        triSl := wLoNow - atr * 0.12
        triTp := (wedgeBrUp ? close : wHiNow) + wWide0
        triPlanRu := "LONG: close>гориз.сопр · SL под раст.подд · TP=+H"
    else if triBotFlat and hiFall and not triTopFlat
        triKind := "desc"
        triRu := "нисходящий △"
        triShort := true
        triEntry := wLoNow
        triSl := wHiNow + atr * 0.12
        triTp := (wedgeBrDn ? close : wLoNow) - wWide0
        triPlanRu := "SHORT: close<гориз.подд · SL над нисх.сопр · TP=−H"
    else if hiFall and loRise
        bool triUpCtx = close > emaTri or impUp
        triKind := wedgeBrUp ? "sym_bull" : wedgeBrDn ? "sym_bear" : triUpCtx ? "sym_bull" : "sym_bear"
        if triKind == "sym_bull"
            triRu := "симметрич. △ · бычий"
            triLong := true
            triEntry := wHiNow
            triSl := wLoNow - atr * 0.12
            triTp := (wedgeBrUp ? close : wHiNow) + wWide0
            triPlanRu := "LONG: пробой нисх.сопр · SL под раст.подд · TP=+H"
        else
            triRu := "симметрич. △ · медвежий"
            triShort := true
            triEntry := wLoNow
            triSl := wHiNow + atr * 0.12
            triTp := (wedgeBrDn ? close : wLoNow) - wWide0
            triPlanRu := "SHORT: пробой раст.подд · SL над нисх.сопр · TP=−H"
if triKind != ""
    wedgeRu := triRu

bool effWedgeDraw = wedgeGeom and (not eff_patFocus or not patActive or wedgeBrUp or wedgeBrDn or (wedgeOk and triKind != ""))

int priRank = 9
string ideaRu = "ждать — нет доминирующего сетапа"
if patSt == "confirmed" and patRu != ""
    priRank := 1
    ideaRu := "1) " + patRu + " ✓ · шея " + str.tostring(patNeck, format.mintick) + " · цель " + str.tostring(patTgt, format.mintick)
else if patKind != "" and patSt == "forming" and patRu != ""
    priRank := 2
    ideaRu := "2) " + patRu + " · шея " + str.tostring(patNeck, format.mintick) + " · ждать пробой"
else if wedgeBrUp
    priRank := 3
    ideaRu := "3) пробой △ · " + triRu + (triPlanRu != "" ? " · " + triPlanRu : "")
else if wedgeBrDn
    priRank := 3
    ideaRu := "3) пробой △ · " + triRu + (triPlanRu != "" ? " · " + triPlanRu : "")
else if sweepLoAct
    priRank := 4
    ideaRu := "4) свип dn @ " + str.tostring(sweepBullLvl, format.mintick)
else if sweepHiAct
    priRank := 4
    ideaRu := "4) свип up @ " + str.tostring(sweepBearLvl, format.mintick)
else if fvgSetup
    priRank := 5
    ideaRu := fvgBull ? "5) BOS + retest demand FVG" : "5) BOS + retest supply FVG"
else if wedgeOk
    priRank := 6
    ideaRu := "6) " + triRu + (triPlanRu != "" ? " · " + triPlanRu : " · триггер у границы")

bool showSmcSweep = eff_smc and (sweepHiAct or sweepLoAct) and (not eff_oneIdeaDraw or priRank == 3 or profMarkup)
bool showSmcFvg = eff_smc and (profMarkup ? fvgUnfilled and fvgFresh : fvgSetup and fvgFresh) and (not eff_oneIdeaDraw or priRank == 4 or profMarkup)
bool showSmcBos = eff_smc and (bosUp or bosDn) and (not eff_oneIdeaDraw or priRank <= 2 or profMarkup)

// ── phase + bias (путь) vs action (вход) ──
bool compress = ta.sma(high - low, 10) <= ta.sma(high - low, 28) * 0.60
string phaseRu = compress ? "сжатие / боковик" : close > close[i_lb / 2] ? "импульс вверх" : "импульс вниз"
string whereRu = posR >= 0.72 ? "у потолка" : posR <= 0.28 ? "у пола" : "в середине диапазона"

// Сквиз / flush — намёк ДО импульса (у верха канала + слабость)
bool nearChTop = wedgeOk and not na(wHiNow) and high >= wHiNow - atr * 0.45
bool lhPivot = array.size(shP) >= 2 and array.get(shP, array.size(shP) - 1) < array.get(shP, array.size(shP) - 2)
bool atCeil = posR >= 0.65 or nearChTop
int sqDn = 0
string sqDnRu = ""
if lhPivot
    sqDn += 2
    sqDnRu += "LH · "
if volBearDivPx
    sqDn += 2
    sqDnRu += "vol на HH слабее · "
if rsiBearDiv or rsiOB
    sqDn += 1
    sqDnRu += rsiBearDiv ? "RSI див. · " : "RSI OB · "
if sweepHiAct
    sqDn += 2
    sqDnRu += "свип ↑ · "
if inSupply or brkSupply or (not na(supBar) and bar_index - supBar <= i_lb)
    sqDn += 2
    sqDnRu += "зона предлож. · "
if nearChTop and loRise
    sqDn += 1
    sqDnRu += "у верха △ · "
bool sqHintDown = atCeil and sqDn >= 3 and close >= structSup - atr * 0.15
bool sqFlushDown = sqDn >= 3 and (close < structSup - atr * 0.08 or (close < open and bodySz > atr * 0.85 and atCeil))
string sqDnHead = sqFlushDown ? "▼ сквиз вниз (flush)" : sqHintDown ? "⚠ риск сквиза вниз" : ""

int sqUp = 0
string sqUpRu = ""
bool nearChBot = wedgeOk and not na(wLoNow) and low <= wLoNow + atr * 0.45
bool hlPivot = array.size(slP) >= 2 and array.get(slP, array.size(slP) - 1) > array.get(slP, array.size(slP) - 2)
bool atFloor = posR <= 0.35 or nearChBot
if hlPivot
    sqUp += 2
    sqUpRu += "HL · "
if volBullDivPx
    sqUp += 2
    sqUpRu += "vol на LL слабее · "
if rsiBullDiv or rsiOS
    sqUp += 1
    sqUpRu += rsiBullDiv ? "RSI див. · " : "RSI OS · "
if sweepLoAct
    sqUp += 2
    sqUpRu += "свип ↓ · "
if inDemand or brkDemand
    sqUp += 2
    sqUpRu += "зона спроса · "
bool sqHintUp = atFloor and sqUp >= 3 and close <= structRes + atr * 0.15
bool sqFlushUp = sqUp >= 3 and (close > structRes + atr * 0.08 or (close > open and bodySz > atr * 0.85 and atFloor))
string sqUpHead = sqFlushUp ? "▲ сквиз вверх (short squeeze)" : sqHintUp ? "⚠ риск сквиза вверх" : ""

var int bearN = 0
var int bullN = 0
var int pathScore = 0
var string pathDir = "chop"
if barstate.isconfirmed or not i_freezePath
    bearN := 0
    bullN := 0
    if posR >= 0.70
        bearN += 2
    if posR <= 0.30
        bullN += 2
    if rsiOB
        bearN += 2
    if rsiOS
        bullN += 2
    if rsiBearDiv
        bearN += 2
    if rsiBullDiv
        bullN += 2
    if sweepHiAct
        bearN += 2
    if sweepLoAct
        bullN += 2
    if wedgeOk and hiRise and loRise and posR > 0.55
        bearN += 2
    if wedgeOk and hiFall and loFall and posR < 0.45
        bullN += 2
    if patDir == "bearish"
        bearN += patSt == "confirmed" ? 3 : 1
    if patDir == "bullish"
        bullN += patSt == "confirmed" ? 3 : 1
    if close > structRes
        bullN += 2
    if close < structSup
        bearN += 2
    if close > rngHi
        bullN += 1
    if close < rngLo
        bearN += 1
    if wedgeBrUp
        bullN += 2
    if wedgeBrDn
        bearN += 2
    if htfTr > 0
        bullN += 2
    if htfTr < 0
        bearN += 2
    if volPullBull
        bullN += 1
    if volPullBear
        bearN += 1
    if volBearDivPx
        bearN += 2
    if volBullDivPx
        bullN += 2
    if inDemand
        bullN += 1
    if inSupply
        bearN += 1
    if resSt == 3
        bullN += 2
    if supSt == 3
        bearN += 2
    pathScore := bearN - bullN
    pathDir := pathScore >= 2 ? "down" : pathScore <= -2 ? "up" : "chop"
string pathRu = pathDir == "down" ? "ожидаем вниз" : pathDir == "up" ? "ожидаем вверх" : "нет ясного хода"
int pathMag = math.abs(pathScore)
string confRu = pathDir == "chop" ? "слабая — нет перевеса факторов" : pathMag >= 6 ? "высокая" : pathMag >= 4 ? "средняя" : "низкая — чувствительна к свингу"
string stabRu = pathMag >= 4 or patSt == "confirmed" ? "устойчивее (±1 свинг реже ломает)" : "осторожно: ±1 свинг может сменить ХОД"
string voteRu = "медв " + str.tostring(bearN) + " · быч " + str.tostring(bullN) + " · Δ " + str.tostring(pathScore)

var string act = "ЖДАТЬ"
var string why = "между полом и потолком без закрытия за уровень — нет входа"
float longPx  = wedgeOk ? math.max(wHiNow, structRes) : structRes
float shortPx = wedgeOk ? math.min(wLoNow, structSup) : structSup
if not na(patNeck) and patDir == "bullish"
    longPx := math.max(longPx, patNeck)
if not na(patNeck) and patDir == "bearish"
    shortPx := math.min(shortPx, patNeck)
if inDemand and not demBrk
    longPx := math.max(longPx, demTop)
if inSupply and not supBrk
    shortPx := math.min(shortPx, supBot)

if barstate.isconfirmed or not i_freezePath
    act := "ЖДАТЬ"
    why := "между полом и потолком без закрытия за уровень — нет входа"
    if resSt == 3 and close > structRes
        act := "LONG"
        why := "retest сопр.: пробили → вернулись → удержали"
    else if supSt == 3 and close < structSup
        act := "SHORT"
        why := "retest подд.: пробили → вернулись → удержали"
    else if inDemand and close > demTop and volPullBull
        act := "LONG"
        why := "зона спроса (имп+vol) + close выше OB"
    else if inSupply and close < supBot and volPullBear
        act := "SHORT"
        why := "зона предложения (имп+vol) + close ниже OB"
    else if wedgeBrUp or (bosUp and close > structRes)
        act := "LONG"
        why := "закрытие выше структуры / границы фигуры"
    else if wedgeBrDn or (bosDn and close < structSup)
        act := "SHORT"
        why := "закрытие ниже структуры / границы фигуры"
    else if patSt == "confirmed" and patDir == "bullish"
        act := "LONG"
        why := patRu + " подтверждён пробоем шеи"
    else if patSt == "confirmed" and patDir == "bearish"
        act := "SHORT"
        why := patRu + " подтверждён пробоем шеи"
    else if pathDir == "down"
        why := "сценарий вниз (RSI / свип / клин) — вход close ниже триггера"
    else if pathDir == "up"
        why := "сценарий вверх (RSI / дно / клин) — вход close выше триггера"
    if act == "LONG" and posR >= 0.72 and close < longPx
        act := "ЖДАТЬ"
        why := "у сопротивления: лонг только после close > триггера, не chase"
    if act == "SHORT" and posR <= 0.28 and close > shortPx
        act := "ЖДАТЬ"
        why := "у поддержки: шорт только после close < триггера"

bool effSmc = eff_smc and not (i_autoClean and isHtf)
bool effPath = eff_path and not (i_autoClean and isHtf and pathMag < 4 and act == "ЖДАТЬ")
bool effSmcAny = effSmc and (showSmcSweep or showSmcFvg or showSmcBos)

float minGap = math.max(atr * 0.35, rngW * 0.04)

f_nearest_below(float px, float floorGap, float skipLv) =>
    float best = na
    float bestD = 1e12
    if array.size(slP) > 0
        for i = 0 to array.size(slP) - 1
            float lv = array.get(slP, i)
            if lv < px - floorGap and (na(skipLv) or math.abs(lv - skipLv) > floorGap)
                float d = px - lv
                if d < bestD
                    bestD := d
                    best := lv
    float[] extraDn = array.from(rngLo, f50, f618, f786, f100, f886, impLo)
    for j = 0 to array.size(extraDn) - 1
        float lv = array.get(extraDn, j)
        if not na(lv) and lv < px - floorGap and (na(skipLv) or math.abs(lv - skipLv) > floorGap)
            float d = px - lv
            if d < bestD
                bestD := d
                best := lv
    best

f_nearest_above(float px, float floorGap, float skipLv) =>
    float best = na
    float bestD = 1e12
    if array.size(shP) > 0
        for i = 0 to array.size(shP) - 1
            float lv = array.get(shP, i)
            if lv > px + floorGap and (na(skipLv) or math.abs(lv - skipLv) > floorGap)
                float d = lv - px
                if d < bestD
                    bestD := d
                    best := lv
    float[] extraUp = array.from(rngHi, f50, f618, f382, f0, f127, f161, impHi)
    for j = 0 to array.size(extraUp) - 1
        float lv = array.get(extraUp, j)
        if not na(lv) and lv > px + floorGap and (na(skipLv) or math.abs(lv - skipLv) > floorGap)
            float d = lv - px
            if d < bestD
                bestD := d
                best := lv
    best

f_plan_sl_tp(bool isLong, float entryPx) =>
    float sl = na
    float t1 = na
    float t2 = na
    float rr = 0.0
    if not na(entryPx)
        if isLong
            float lastLo = array.size(slP) > 0 ? array.get(slP, array.size(slP) - 1) : low
            sl := math.min(lastLo, na(wLoNow) ? lastLo : wLoNow) - atr * 0.18
            t1 := f_nearest_above(entryPx, minGap, na)
            t2 := f_nearest_above(na(t1) ? entryPx : t1, minGap, t1)
            if na(t1)
                t1 := rngHi
            if na(t2)
                t2 := impUp ? f127 : f0
        else
            float lastHi = array.size(shP) > 0 ? array.get(shP, array.size(shP) - 1) : high
            sl := math.max(lastHi, na(wHiNow) ? lastHi : wHiNow) + atr * 0.18
            t1 := f_nearest_below(entryPx, minGap, na)
            t2 := f_nearest_below(na(t1) ? entryPx : t1, minGap, t1)
            if na(t1)
                t1 := rngLo
            if na(t2)
                t2 := impUp ? f100 : f127
        rr := f_rr(entryPx, sl, t1, isLong)
        if rr < i_minRR and not na(t2)
            float rr2 = f_rr(entryPx, sl, t2, isLong)
            if rr2 >= i_minRR
                t1 := t2
                rr := rr2
                t2 := isLong ? f_nearest_above(t1, minGap, t1) : f_nearest_below(t1, minGap, t1)
    [sl, t1, t2, rr]

string planSide = ""
if act == "LONG" or act == "SHORT"
    planSide := act
else if act == "ЖДАТЬ"
    if pathDir == "down" and posR >= 0.50
        planSide := "SHORT"
    else if pathDir == "up" and posR <= 0.50
        planSide := "LONG"

float entryPx = na
if planSide == "LONG"
    entryPx := i_surgical ? longPx : close
else if planSide == "SHORT"
    entryPx := i_surgical ? shortPx : close

float slPx = na
float tp1 = na
float tp2 = na
float rr1 = 0.0
string tp1Why = "ближайшие реакции (свинг / Fib)"
string slWhy = planSide == "LONG" ? "за лоем / низом клина" : planSide == "SHORT" ? "за хаем / верхом клина" : ""
if planSide == "LONG" or planSide == "SHORT"
    [_sl, _t1, _t2, _rr] = f_plan_sl_tp(planSide == "LONG", entryPx)
    slPx := _sl
    tp1 := _t1
    tp2 := _t2
    rr1 := _rr

bool isLongPlan = planSide == "LONG"

float lTrig = longPx
float sTrig = shortPx
[lSl, lTp1, lTp2, lRr] = f_plan_sl_tp(true, i_surgical ? lTrig : close)
[sSl, sTp1, sTp2, sRr] = f_plan_sl_tp(false, i_surgical ? sTrig : close)
if eff_triPdf and triLong and not na(triSl)
    lSl := triSl
    if not na(triTp) and triTp > lTrig
        lTp1 := triTp
        lRr := f_rr(lTrig, lSl, lTp1, true)
if eff_triPdf and triShort and not na(triSl)
    sSl := triSl
    if not na(triTp) and triTp < sTrig
        sTp1 := triTp
        sRr := f_rr(sTrig, sSl, sTp1, false)
bool lReward = not na(lTp1) and lTp1 > lTrig + syminfo.mintick
bool sReward = not na(sTp1) and sTp1 < sTrig - syminfo.mintick

float htfCl = request.security(syminfo.tickerid, "60", close, lookahead=barmerge.lookahead_off)
float htfEma = request.security(syminfo.tickerid, "60", ta.ema(close, 20), lookahead=barmerge.lookahead_off)
float ltfCl = request.security(syminfo.tickerid, "15", close, lookahead=barmerge.lookahead_off)
float ltfEma = request.security(syminfo.tickerid, "15", ta.ema(close, 20), lookahead=barmerge.lookahead_off)
bool mtfBlock = false
if i_mtf and planSide == "LONG" and htfTr < 0
    mtfBlock := true
if i_mtf and planSide == "SHORT" and htfTr > 0
    mtfBlock := true
if i_mtf and planSide == "LONG" and htfTr == 0 and htfCl < htfEma * 0.998
    mtfBlock := true
if i_mtf and planSide == "SHORT" and htfTr == 0 and htfCl > htfEma * 1.002
    mtfBlock := true
if i_mtf and isHtf and planSide == "LONG" and ctfTr < 0
    mtfBlock := true
if i_mtf and isHtf and planSide == "SHORT" and ctfTr > 0
    mtfBlock := true
string mtfRu = ctxStructRu + " · " + trdStructRu + (mtfBlock ? " · конфликт" : "")

int facN = 0
string facRu = ""
string missRu = ""
if planSide != ""
    bool facHtf = planSide == "LONG" ? htfTr >= 0 : htfTr <= 0
    bool facTrd = planSide == "LONG" ? ctfTr >= 0 or resSt >= 2 : ctfTr <= 0 or supSt >= 2
    bool facRet = planSide == "LONG" ? resSt == 3 or (fvgSetup and fvgBull) : supSt == 3 or (fvgSetup and not fvgBull)
    bool facZone = planSide == "LONG" ? inDemand or sweepLoAct : inSupply or sweepHiAct
    bool facVol = planSide == "LONG" ? volPullBull and not volBearDivPx : volPullBear and not volBullDivPx
    bool facLoc = planSide == "LONG" ? posR <= 0.65 : posR >= 0.35
    bool facIdea = priRank <= 4
    bool facRr = rr1 >= i_minRR
    if facHtf
        facN += 1
        facRu += "HTF·"
    else
        missRu += "HTF; "
    if facTrd
        facN += 1
        facRu += "TF·"
    if facRet
        facN += 1
        facRu += "retest·"
    else
        missRu += "retest; "
    if facZone
        facN += 1
        facRu += "зона·"
    else
        missRu += "зона; "
    if facVol
        facN += 1
        facRu += "vol·"
    else
        missRu += "vol; "
    if facLoc
        facN += 1
        facRu += "loc·"
    else
        missRu += "loc; "
    if facIdea
        facN += 1
        facRu += "идея·"
    if facRr
        facN += 1
        facRu += "R:R·"
    else
        missRu += "R:R; "
string qualGr = planSide == "" ? "—" : facN >= 6 ? "A" : facN >= 4 ? "B" : "C"
bool qualOk = i_minQual == "C" ? true : i_minQual == "B" ? qualGr == "A" or qualGr == "B" : qualGr == "A"
if missRu == "" and planSide != "" and qualGr != "A"
    missRu := "добрать факторы до A"

bool rewardOk = planSide == "LONG" ? tp1 > entryPx + syminfo.mintick : planSide == "SHORT" ? tp1 < entryPx - syminfo.mintick : false
bool planOk = planSide != "" and rewardOk and rr1 >= i_minRR and not mtfBlock and qualOk
string edgeRu = planOk ? qualGr + " · R:R " + str.tostring(rr1, "#.2") + " @ " + str.tostring(entryPx, format.mintick) : planSide != "" and mtfBlock ? "конфликт контекста — без SL/TP" : planSide != "" and not qualOk ? "кач. " + qualGr + " < min " + i_minQual : planSide != "" ? "нет edge (R:R " + str.tostring(rr1, "#.2") + ")" : "сценарий без сделки"
string qualRu = qualGr + " (" + str.tostring(facN) + "/8) · " + facRu
bool showPlan = eff_boxes and planOk
bool showLongCand = eff_boxes and lRr >= i_minRR and lReward and not na(lSl) and not na(lTp1) and (showPlan and planSide == "LONG" or eff_dualPos and (act == "ЖДАТЬ" or act == "LONG") or act == "LONG")
bool showShortCand = eff_boxes and sRr >= i_minRR and sReward and not na(sSl) and not na(sTp1) and (showPlan and planSide == "SHORT" or eff_dualPos and (act == "ЖДАТЬ" or act == "SHORT") or act == "SHORT")
bool wantLong = act == "LONG" or (act == "ЖДАТЬ" and (pathDir == "up" or triLong or (planSide == "LONG" and not mtfBlock)))
bool wantShort = act == "SHORT" or (act == "ЖДАТЬ" and (pathDir == "down" or triShort or (planSide == "SHORT" and not mtfBlock)))
bool showLongPos = showLongCand and (not eff_onePos or eff_dualPos or wantLong) and not (eff_onePos and act == "ЖДАТЬ" and wantShort and not wantLong and not eff_dualPos)
bool showShortPos = showShortCand and (not eff_onePos or eff_dualPos or wantShort) and not (eff_onePos and act == "ЖДАТЬ" and wantLong and not wantShort and not eff_dualPos)
if eff_onePos and act == "ЖДАТЬ" and wantLong and wantShort and not eff_dualPos
    showLongPos := showLongCand and pathDir != "down"
    showShortPos := showShortCand and pathDir == "down"

// Разметка Ed: один сценарий на графике — линии E/SL/TP, подписи только цены
string mkSide = ""
if profMarkup
    if act == "SHORT"
        mkSide := "SHORT"
    else if act == "LONG"
        mkSide := "LONG"
    else if sqFlushDown or sqHintDown or (atCeil and sqDn >= 2)
        mkSide := "SHORT"
    else if sqFlushUp or sqHintUp or (atFloor and sqUp >= 2)
        mkSide := "LONG"
    else if pathDir == "down" and posR >= 0.52
        mkSide := "SHORT"
    else if pathDir == "up" and posR <= 0.48
        mkSide := "LONG"
bool mkShort = profMarkup and mkSide == "SHORT" and sRr >= 1.0 and sReward and not na(sSl) and not na(sTp1)
bool mkLong = profMarkup and mkSide == "LONG" and lRr >= 1.0 and lReward and not na(lSl) and not na(lTp1)
bool mkHasPlan = mkShort or mkLong
bool mkMinLbl = profMarkup and mkHasPlan and not showLongPos and not showShortPos
bool drawLongPlan = showLongPos or mkLong
bool drawShortPlan = showShortPos or mkShort

string figRu = patActive ? patRu + (patSt == "confirmed" ? " ✓" : " …") : wedgeOk ? wedgeRu : wedgeGeom ? wedgeRu : "фигура не выделена"
if patActive and wedgeOk and patKind != "one_two_three"
    figRu := patRu + (patSt == "confirmed" ? " ✓" : " …") + " · " + triRu
string storyAct = act == "LONG" ? "▲ LONG" : act == "SHORT" ? "▼ SHORT" : "◆ ЖДАТЬ"
string storyHead = storyAct + "  ·  " + qualGr + "  ·  " + whereRu + "  ·  " + pathRu
string storyFig = figRu
string storyTrig = "▲ close> " + str.tostring(longPx, format.mintick) + "     ▼ close< " + str.tostring(shortPx, format.mintick)
string storyEdge = planOk ? edgeRu : mtfBlock ? "нет входа: конфликт HTF" : act != "ЖДАТЬ" ? why : missRu != "" ? "нет edge: " + missRu : why
string storyCtx = ctxStructRu + " · " + (inDemand ? zoneRu : inSupply ? zoneRu : retResRu)
string storyTxt = storyHead + "\n" + storyFig + "\n" + ideaRu + "\n" + storyTrig + "\n" + storyEdge + "\n" + storyCtx
bool longSolid = showPlan and planSide == "LONG"
bool shortSolid = showPlan and planSide == "SHORT"
colTvProfit = color.new(#089981, longSolid ? 72 : 86)
colTvStop = color.new(#f23645, longSolid ? 72 : 86)
colTvProfitS = color.new(#089981, shortSolid ? 72 : 86)
colTvStopS = color.new(#f23645, shortSolid ? 72 : 86)

// Касание уровней позиции (✔ / ✖), сброс при смене триггера
var float memLTrig = na
var float memSTrig = na
var bool lSlHit = false
var bool lT1Hit = false
var bool lT2Hit = false
var bool sSlHit = false
var bool sT1Hit = false
var bool sT2Hit = false
if barstate.isconfirmed
    if not showLongPos or lTrig != memLTrig
        lSlHit := false
        lT1Hit := false
        lT2Hit := false
        memLTrig := showLongPos ? lTrig : na
    if showLongPos and i_posHits
        if low <= lSl
            lSlHit := true
        if not lSlHit and high >= lTp1 and low <= lTp1
            lT1Hit := true
        if not lSlHit and not na(lTp2) and high >= lTp2 and low <= lTp2
            lT2Hit := true
    if not showShortPos or sTrig != memSTrig
        sSlHit := false
        sT1Hit := false
        sT2Hit := false
        memSTrig := showShortPos ? sTrig : na
    if showShortPos and i_posHits
        if high >= sSl
            sSlHit := true
        if not sSlHit and low <= sTp1 and high >= sTp1
            sT1Hit := true
        if not sSlHit and not na(sTp2) and low <= sTp2 and high >= sTp2
            sT2Hit := true

color belTrendUp = #06b690
color belTrendDn = color.rgb(182, 112, 6)
color candleTint = pathDir == "up" ? belTrendUp : pathDir == "down" ? belTrendDn : na

color actCol = act == "LONG" ? colG : act == "SHORT" ? colR : colY

