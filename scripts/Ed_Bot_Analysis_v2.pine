    lbBos := na
    lbSweep := na
    lbPath := na
    lbSL := na
    lbTP1 := na

    int xL = xL0
    int xC = xR

    if eff_story
        bool storyHud = i_storyPos == "Вверху справа"
        if storyHud
            tbStory := table.new(position.top_right, 1, 1, bgcolor=color.new(colBg, 4), border_width=1, border_color=color.new(actCol, 55), frame_color=color.new(colBg, 30), frame_width=1)
            table.cell(tbStory, 0, 0, storyTxt, text_color=actCol, text_size=size.normal, text_halign=text.align_left, text_valign=text.align_top, bgcolor=color.new(colBg, 4), width=46)
        else
            float yStory = high + atr * 1.15
            lbStory := label.new(xNow, yStory, storyTxt, style=label.style_label_down, color=color.new(colBg, 8), textcolor=actCol, size=size.normal, textalign=text.align_left)
    if eff_boxes
        lnTrigL := line.new(xL, longPx, xC, longPx, color=color.new(colG, longSolid ? 0 : 45), width=longSolid ? 2 : 1, style=line.style_dotted)
        lnTrigS := line.new(xL, shortPx, xC, shortPx, color=color.new(colR, shortSolid ? 0 : 45), width=shortSolid ? 2 : 1, style=line.style_dotted)
    else if profMarkup and mkLong
        lnTrigL := line.new(xL, lTrig, xC, lTrig, color=color.new(colG, 0), width=2, style=line.style_dashed)
    else if profMarkup and mkShort
        lnTrigS := line.new(xL, sTrig, xC, sTrig, color=color.new(colR, 0), width=2, style=line.style_dashed)

    // 1) S/R — структура (свинги) + опционально контекст LB
    if eff_sr
        lnCeil := line.new(xL, structRes, xC, structRes, color=colY, width=i_wSR, extend=extend.none)
        lnFloor := line.new(xL, structSup, xC, structSup, color=colB, width=i_wSR, extend=extend.none)
        string resCap = profMarkup ? str.tostring(structRes, format.mintick) : "Сопр. " + str.tostring(structRes, format.mintick) + " · L если close >"
        string supCap = profMarkup ? str.tostring(structSup, format.mintick) : "Подд. " + str.tostring(structSup, format.mintick) + " · S если close <"
        lbCeil := label.new(xL + 2, structRes, resCap, style=label.style_label_right, color=color.new(colBg, 15), textcolor=colY, size=profMarkup ? size.tiny : size.small)
        lbFloor := label.new(xL + 2, structSup, supCap, style=label.style_label_right, color=color.new(colBg, 15), textcolor=colB, size=profMarkup ? size.tiny : size.small)
        if eff_ctxRng and (math.abs(rngHi - structRes) > atr * 0.15 or math.abs(rngLo - structSup) > atr * 0.15)
            lnCtxHi := line.new(xL, rngHi, xC, rngHi, color=color.new(colY, 55), width=1, style=line.style_dotted, extend=extend.none)
            lnCtxLo := line.new(xL, rngLo, xC, rngLo, color=color.new(colB, 55), width=1, style=line.style_dotted, extend=extend.none)
        if eff_zone
            int xZn = math.min(xC, xNow + 10)
            float zH = structSup + math.max(atr * 0.45, structW * 0.06)
            bool demFresh = not na(demBar) and bar_index - demBar <= i_lb
            bool supFresh = not na(supBar) and bar_index - supBar <= i_lb
            int zonePick = 0
            if eff_zoneOne
                if brkDemand and demFresh
                    zonePick := 1
                else if brkSupply and supFresh
                    zonePick := 2
                else if demFresh and not demBrk and (inDemand or priRank <= 3)
                    zonePick := 3
                else if supFresh and not supBrk and (inSupply or priRank <= 3)
                    zonePick := 4
                else if posR <= 0.42 and patKind == ""
                    zonePick := 5
            if not eff_zoneOne or zonePick == 5
                bxSup := box.new(xL, zH, xZn, structSup, bgcolor=color.new(colG, 82), border_color=colG, border_width=1)
            if not eff_zoneOne or zonePick == 1 or zonePick == 3
                if demFresh
                    int xOb = math.max(xL, demBar)
                    int xObE = math.min(xZn, xOb + 36)
                    color dCol = demBrk ? color.new(colR, 86) : color.new(colG, 88)
                    bxOb := box.new(xOb, demTop, xObE, demBot, bgcolor=dCol, border_color=demBrk ? colR : colG, border_width=1)
                    if not profMarkup
                        string demLbl = demBrk ? "Breaker ↓\nбывш. спрос" : "спрос OB"
                        lbOb := label.new(xOb, demTop, demLbl, style=label.style_label_down, color=color.new(colBg, 15), textcolor=demBrk ? colR : colG, size=size.small)
            if not eff_zoneOne or zonePick == 2 or zonePick == 4
                if supFresh
                    int xSp = math.max(xL, supBar)
                    int xSpE = math.min(xZn, xSp + 36)
                    color sCol = supBrk ? color.new(colG, 86) : color.new(colR, 88)
                    bxSply := box.new(xSp, supTop, xSpE, supBot, bgcolor=sCol, border_color=supBrk ? colG : colR, border_width=1)
    // 2b) Разметка Ed — HH/HL, TL, поддержка HL, разворот (схема «Разворот цены»)
    if profMarkup
        int xZnMk = math.min(xC, xNow + 10)
        bool supFreshMk = not na(supBar) and bar_index - supBar <= i_lb
        bool mkCardTop = (sqHintDown or sqFlushDown or atCeil) and not mkHasPlan
        if array.size(shP) >= 2 and not mkCardTop and not mkHasPlan
            int hn = array.size(shP) - 1
            float hp = array.get(shP, hn)
            int hx = array.get(shX, hn)
            float hp0 = array.get(shP, hn - 1)
            string hTag = hp > hp0 ? "HH" : "LH"
            lbHiStruct := label.new(hx, hp, hTag, style=label.style_label_down, color=color.new(colBg, 10), textcolor=hp > hp0 ? colG : colR, size=size.tiny)
        if array.size(slP) >= 2 and not mkCardTop and not mkHasPlan
            int ln = array.size(slP) - 1
            float lp = array.get(slP, ln)
            int lx = array.get(slX, ln)
            float lp0 = array.get(slP, ln - 1)
            int hxFar = array.size(shX) >= 1 ? array.get(shX, array.size(shX) - 1) : xNow
            bool sepHl = math.abs(lx - hxFar) > 8
            string lTag = lp > lp0 ? "HL" : "LL"
            if sepHl
                lbLoStruct := label.new(lx, lp, lTag, style=label.style_label_up, color=color.new(colBg, 10), textcolor=lp > lp0 ? colG : colR, size=size.tiny)
            int lx0 = array.get(slX, ln - 1)
            float ly0 = lp0
            if lp >= ly0 and lx > lx0
                float tSlope = (lp - ly0) / math.max(lx - lx0, 1)
                float yEnd = ly0 + tSlope * (xC - lx0)
                lnTrendHL := line.new(lx0, ly0, xC, yEnd, color=color.new(colW, 0), width=2, extend=extend.none)
                float zTop = lp + atr * 0.22
                float zBot = lp - atr * 0.12
                bxHlSup := box.new(lx, zTop, xZnMk, zBot, bgcolor=color.new(colB, 86), border_color=colB, border_width=1)
        if array.size(shP) >= 2 and array.size(slP) >= 1
            bool isLh = array.get(shP, array.size(shP) - 1) < array.get(shP, array.size(shP) - 2)
            float lastHl = array.get(slP, array.size(slP) - 1)
            bool brokeHl = close < lastHl - atr * 0.05
            bool tlBreak = not na(lnTrendHL) and close < structSup
            if isLh and (brokeHl or tlBreak) and not mkHasPlan
                lbRev := label.new(xNow - 2, high + atr * 0.35, "↓", style=label.style_label_down, color=color.new(colR, 15), textcolor=colR, size=size.small)
        if not na(supTop) and supFreshMk and na(bxSply)
            int xSpM = math.max(xL, supBar)
            int xSpE = math.min(xZnMk, xSpM + 40)
            bxSupplyMk := box.new(xSpM, supTop, xSpE, supBot, bgcolor=color.new(colR, 88), border_color=colR, border_width=1)
        if not mkHasPlan and mkCardTop
            lbSqDn := label.new(xNow + 2, high + atr * 0.55, "⚠", style=label.style_label_down, color=color.new(colR, 12), textcolor=colR, size=size.small)
        else if not mkHasPlan and (sqHintDown or sqFlushDown)
            lnSqTrig := line.new(xNow - 18, structSup, xC, structSup, color=color.new(colR, sqFlushDown ? 0 : 45), width=sqFlushDown ? 2 : 1, style=line.style_dashed)
        if not mkHasPlan and (sqHintUp or sqFlushUp)
            lbSqUp := label.new(xNow - 1, low - atr * 0.35, "▲", style=label.style_label_up, color=color.new(colG, 18), textcolor=colG, size=size.small)

    // 3) клин / канал — сплошной если касания OK, иначе пунктир «черновик»
    if effWedgeDraw
        int xW0 = math.min(wHx0, wLx0)
        float yH0 = f_y(wHy0, wHx0, wHy1, wHx1, xW0)
        float yH1 = f_y(wHy0, wHx0, wHy1, wHx1, xC)
        float yL0 = f_y(wLy0, wLx0, wLy1, wLx1, xW0)
        float yL1 = f_y(wLy0, wLx0, wLy1, wLx1, xC)
        color wCol = wedgeOk ? colW : color.new(colMuted, 35)
        int wW = wedgeOk ? i_wWedge : math.max(1, i_wWedge - 1)
        lnWh := line.new(xW0, yH0, xC, yH1, color=wCol, width=wW, style=wedgeOk ? line.style_solid : line.style_dashed, extend=extend.none)
        lnWl := line.new(xW0, yL0, xC, yL1, color=wCol, width=wW, style=wedgeOk ? line.style_solid : line.style_dashed, extend=extend.none)
        string wLbl = triKind != "" ? triRu : wedgeRu
        if profMarkup
            wLbl := loRise and hiRise ? "↑" : hiFall and loFall ? "↓" : triKind == "asc" ? "△" : triKind == "desc" ? "▽" : "↑"
        lbWedge := label.new(xC - 1, (yH1 + yL1) * 0.5, wLbl, style=label.style_label_left, color=color.new(colBg, 20), textcolor=wCol, size=profMarkup ? size.tiny : size.normal)
        if eff_triPdf and wedgeOk and triKind != "" and not na(triEntry) and not mkHasPlan
            int xTa = math.max(xW0, xNow - 8)
            color cE = triLong ? colG : colR
            lnTriE := line.new(xTa, triEntry, xC, triEntry, color=cE, width=2, style=line.style_solid)
            lnTriS := line.new(xTa, triSl, xC, triSl, color=colR, width=1, style=line.style_dashed)
            lnTriT := line.new(xTa, triTp, xC, triTp, color=colG, width=1, style=line.style_dashed)
            string triLbl = profMarkup ? str.tostring(triEntry, format.mintick) + "\n" + str.tostring(triSl, format.mintick) + "\n" + str.tostring(triTp, format.mintick) : "Вход " + str.tostring(triEntry, format.mintick) + "\nСтоп " + str.tostring(triSl, format.mintick) + "\nЦель " + str.tostring(triTp, format.mintick) + " (H=" + str.tostring(wWide0, format.mintick) + ")"
            lbTriPlan := label.new(xTa, triEntry, triLbl, style=label.style_label_right, color=color.new(colBg, 12), textcolor=cE, size=size.tiny)
            if triKind == "asc" and triTopFlat
                float yFlat = (wHy0 + wHy1) * 0.5
                lnWh := line.new(xW0, yFlat, xC, yFlat, color=colY, width=2, style=line.style_dotted, extend=extend.none)
            if triKind == "desc" and triBotFlat
                float yFlatB = (wLy0 + wLy1) * 0.5
                lnWl := line.new(xW0, yFlatB, xC, yFlatB, color=colB, width=2, style=line.style_dotted, extend=extend.none)

    // 4) графический паттерн — M/W, ГиП, 1-2-3 (шея + measured move)
    bool drawPat = eff_pat and patActive
    bool isHs = patKind == "head_shoulders" or patKind == "inverse_head_shoulders"
    bool isDbl = patKind == "double_top" or patKind == "double_bottom"
    int xPatLbl = math.max(na(pI2) ? xNow - 8 : pI2, xNow - 14)
    int patW = patSt == "confirmed" ? math.max(i_wPat, 2) : i_wPat
    color patCol = patDir == "bullish" ? colG : patDir == "bearish" ? colR : colY
    if drawPat and isDbl and not na(pI1) and not na(pI2) and not na(patNeck)
        lnP12 := line.new(pI1, pP1, pI2, pP2, color=patCol, width=patW, style=patSt == "confirmed" ? line.style_solid : line.style_dashed, extend=extend.none)
        lnPatV1 := line.new(pI1, pP1, pI1, patNeck, color=color.new(patCol, 35), width=1, style=line.style_dotted)
        lnPatV2 := line.new(pI2, pP2, pI2, patNeck, color=color.new(patCol, 35), width=1, style=line.style_dotted)
        lnNeck := line.new(math.min(pI1, pI2), patNeck, xC, patNeck, color=colB, width=patW, style=patSt == "confirmed" ? line.style_solid : line.style_dashed, extend=extend.none)
        if not na(patTgt)
            lnPatTgt := line.new(xNow - 6, patTgt, xC, patTgt, color=color.new(patCol, 20), width=1, style=line.style_dotted, extend=extend.none)
        string dN = patKind == "double_top" ? "2× вершина" : "2× дно"
        float yLbl = patKind == "double_top" ? math.max(pP1, pP2) + atr * 0.08 : math.min(pP1, pP2) - atr * 0.08
        lbPat := label.new(xPatLbl, yLbl, dN + (patSt == "confirmed" ? " ✓" : " …") + "\nшея " + str.tostring(patNeck, format.mintick) + "\nцель " + str.tostring(patTgt, format.mintick), style=label.style_label_down, color=color.new(colBg, 8), textcolor=patCol, size=size.normal)
    else if drawPat and isHs and not na(pNLx)
        lnP12 := line.new(pI1, pP1, pI2, pP2, color=patCol, width=patW, style=patSt == "confirmed" ? line.style_solid : line.style_dashed, extend=extend.none)
        lnP23 := line.new(pI2, pP2, pI3, pP3, color=patCol, width=patW, style=patSt == "confirmed" ? line.style_solid : line.style_dashed, extend=extend.none)
        lnHsN := line.new(pNLx, pNL, pNRx, pNR, color=colB, width=patW, style=patSt == "confirmed" ? line.style_solid : line.style_dashed, extend=extend.none)
        lnNeck := line.new(pNRx, pNR, xC, f_y(pNL, pNLx, pNR, pNRx, xC), color=colB, width=1, style=line.style_dotted, extend=extend.none)
        if not na(patTgt)
            lnPatTgt := line.new(xNow - 6, patTgt, xC, patTgt, color=color.new(patCol, 20), width=1, style=line.style_dotted, extend=extend.none)
        lbPat := label.new(xPatLbl, pP2, patRu + (patSt == "confirmed" ? " ✓" : " …") + "\nшея · цель " + str.tostring(patTgt, format.mintick), style=label.style_label_down, color=color.new(colBg, 8), textcolor=colO, size=size.normal)
    else if drawPat and patKind == "one_two_three" and not na(pI1)
        lnP12 := line.new(pI1, pP1, pI2, pP2, color=patCol, width=patW, style=patSt == "confirmed" ? line.style_solid : line.style_dashed, extend=extend.none)
        if not na(pI3)
            lnP23 := line.new(pI2, pP2, pI3, pP3, color=patCol, width=1, style=patSt == "confirmed" ? line.style_solid : line.style_dashed, extend=extend.none)
        if not na(patNeck)
            lnNeck := line.new(pI1, patNeck, xC, patNeck, color=colB, width=patW, style=patSt == "confirmed" ? line.style_solid : line.style_dashed, extend=extend.none)
        if not na(patTgt)
            lnPatTgt := line.new(xNow - 6, patTgt, xC, patTgt, color=color.new(patCol, 20), width=1, style=line.style_dotted, extend=extend.none)
        lbPat := label.new(xPatLbl, pP2, "1-2-3 " + (patDir == "bullish" ? "↑" : "↓") + (patSt == "confirmed" ? " ✓" : " …") + "\nшея " + str.tostring(patNeck, format.mintick), style=label.style_label_down, color=color.new(colBg, 8), textcolor=patCol, size=size.normal)

    bool drawPat2 = eff_pat and i_histPat and patKind2 != "" and patKind2 != patKind and (patKind2 == "double_top" or patKind2 == "double_bottom")
    if drawPat2 and not na(p2I1) and not na(p2I2) and not na(patNeck2)
        lnPat2 := line.new(p2I1, p2P1, p2I2, p2P2, color=color.new(colMuted, 25), width=1, extend=extend.none)
        lnNeck2 := line.new(math.min(p2I1, p2I2), patNeck2, xC, patNeck2, color=color.new(colB, 45), width=1, style=line.style_dashed, extend=extend.none)

    // 5) Fib grid — от ноги импульса, не «висящие» линии
    if eff_fib and (impHi - impLo) > atr * 0.4
        int xf0 = math.max(xL, xFib0)
        lnF0   := line.new(xf0, f0,   xC, f0,   color=color.new(colW, 35), width=i_wFib, style=line.style_solid, extend=extend.none)
        lnF236 := line.new(xf0, f236, xC, f236, color=color.new(colMuted, 45), width=i_wFib, style=line.style_dotted, extend=extend.none)
        lnF382 := line.new(xf0, f382, xC, f382, color=color.new(colMuted, 15), width=i_wFib, style=line.style_dotted, extend=extend.none)
        lnF50  := line.new(xf0, f50,  xC, f50,  color=color.new(colP, 10), width=i_wFib, style=line.style_dashed, extend=extend.none)
        lnF618 := line.new(xf0, f618, xC, f618, color=color.new(colP, 0), width=math.max(i_wFib, 2), style=line.style_dashed, extend=extend.none)
        lnF786 := line.new(xf0, f786, xC, f786, color=color.new(colO, 0), width=math.max(i_wFib, 2), style=line.style_dashed, extend=extend.none)
        lnF100 := line.new(xf0, f100, xC, f100, color=color.new(colW, 35), width=i_wFib, style=line.style_solid, extend=extend.none)
        lnF127 := line.new(xf0, f127, xC, f127, color=color.new(colG, 40), width=i_wFib, style=line.style_dotted, extend=extend.none)
        bxFib := box.new(xf0, math.max(f50, f618), xC, math.min(f50, f618), bgcolor=color.new(colP, 90), border_color=color.new(colP, 70), border_width=1)
        bxFibSell := box.new(xf0, math.max(f786, f886), xC, math.min(f786, f886), bgcolor=color.new(colO, 92), border_color=color.new(colO, 75), border_width=1)
        lbF0   := label.new(xC, f0,   "Fib 0 · начало ноги", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colW, size=size.tiny)
        lbF382 := label.new(xC, f382, "38.2", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colMuted, size=size.tiny)
        lbF50  := label.new(xC, f50,  "50 · золотая", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colP, size=size.tiny)
        lbF618 := label.new(xC, f618, "61.8 · золотая", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colP, size=size.tiny)
        lbF786 := label.new(xC, f786, "78.6 · сильная", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colO, size=size.tiny)
        lbF100 := label.new(xC, f100, "100 · конец ноги", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colW, size=size.tiny)

    // 6) SMC — только если поддерживает «главную идею»
    if effSmcAny
        if showSmcFvg and not na(fvgBar)
            int xF0 = fvgBar - 2
            bxFvg := box.new(xF0, fvgTop, xC, fvgBot, bgcolor=color.new(fvgBull ? colG : colR, 86), border_color=fvgBull ? colG : colR, border_width=1)
            if not profMarkup
                string fvgLbl = fvgBull ? "FVG demand · retest" : "FVG supply · retest"
                lbFvg := label.new(fvgBar, (fvgTop + fvgBot) * 0.5, fvgLbl, style=label.style_label_left, color=color.new(colBg, 25), textcolor=fvgBull ? colG : colR, size=size.tiny)
        if showSmcBos and (bosUp or bosDn)
            float bPx = bosUp ? structRes : structSup
            lnBos := line.new(xNow - 24, bPx, xC, bPx, color=bosUp ? colG : colR, width=1, style=line.style_dashed, extend=extend.none)
            lbBos := label.new(xNow - 20, bPx, bosUp ? "BOS ↑" : "BOS ↓", style=label.style_label_right, color=color.new(color.black, 100), textcolor=bosUp ? colG : colR, size=size.tiny)
        if showSmcSweep and sweepHiAct and not na(sweepBearBar)
            lnSweep := line.new(sweepBearBar, sweepBearLvl, xC, sweepBearLvl, color=colY, width=1, style=line.style_dotted, extend=extend.none)
            if not (profMarkup and (atCeil or mkHasPlan))
                string swB = profMarkup ? str.tostring(sweepBearLvl, format.mintick) : "свип ↑ · " + str.tostring(sweepBearLvl, format.mintick)
                lbSweep := label.new(sweepBearBar, sweepBearY, swB, style=label.style_label_down, color=color.new(colY, 10), textcolor=colBg, size=size.tiny)
        else if showSmcSweep and sweepLoAct and not na(sweepBullBar)
            lnSweep := line.new(sweepBullBar, sweepBullLvl, xC, sweepBullLvl, color=colY, width=1, style=line.style_dotted, extend=extend.none)
            string swL = profMarkup ? str.tostring(sweepBullLvl, format.mintick) : "свип ↓ · " + str.tostring(sweepBullLvl, format.mintick)
            lbSweep := label.new(sweepBullBar, sweepBullY, swL, style=label.style_label_up, color=color.new(colY, 10), textcolor=colBg, size=size.tiny)

    // прогноз хода (как учебный зигзаг, но по счёту RSI/структуры)
    if effPath and pathDir != "chop" and not na(tp1)
        int xa = xNow
        int xb = xNow + 5
        int xc = xNow + 12
        int xd = xNow + 20
        int xe = xNow + 28
        if pathDir == "down"
            float yPeek = math.max(close, na(wHiNow) ? high : wHiNow)
            float yBr = na(wLoNow) ? close - atr : wLoNow
            lnP0 := line.new(xa, close, xb, yPeek, color=#e6c56e, width=i_wPath, extend=extend.none)
            lnP1 := line.new(xb, yPeek, xc, yBr, color=#e6c56e, width=i_wPath, extend=extend.none)
            lnP2 := line.new(xc, yBr, xd, tp1, color=#e6c56e, width=i_wPath, extend=extend.none)
            if not na(tp2)
                lnP3 := line.new(xd, tp1, xe, tp2, color=#e6c56e, width=i_wPath, extend=extend.none)
            lbPath := label.new(xe, na(tp2) ? tp1 : tp2, "ожидание ↓", style=label.style_label_left, color=color.new(colBg, 20), textcolor=#e6c56e, size=size.small)
        else
            float yDip = math.min(close, na(wLoNow) ? low : wLoNow)
            float yBrU = na(wHiNow) ? close + atr : wHiNow
            lnP0 := line.new(xa, close, xb, yDip, color=#e6c56e, width=i_wPath, extend=extend.none)
            lnP1 := line.new(xb, yDip, xc, yBrU, color=#e6c56e, width=i_wPath, extend=extend.none)
            lnP2 := line.new(xc, yBrU, xd, tp1, color=#e6c56e, width=i_wPath, extend=extend.none)
            if not na(tp2)
                lnP3 := line.new(xd, tp1, xe, tp2, color=#e6c56e, width=i_wPath, extend=extend.none)
            lbPath := label.new(xe, na(tp2) ? tp1 : tp2, "ожидание ↑", style=label.style_label_left, color=color.new(colBg, 20), textcolor=#e6c56e, size=size.small)

    // Позиции Long/Short — уровни EdBot, визуал Beluga (linefill) или TV-боксы
    int xPos0 = xNow
    int xPos1 = xNow + i_posW
    color belUp = #06b690
    color belDn = #db1e1e
    color belEntry = #1d80dd
    int fillT = 92
    if drawLongPlan
        float eL = lTrig
        bool longSolidMk = longSolid or mkLong
        if i_posStyle == "Beluga"
            int fT = longSolidMk ? fillT : 96
            color lSlCol = lSlHit ? belDn : belDn
            lnLSl := line.new(xPos0, lSl, xPos1, lSl, color=lSlCol, width=lSlHit ? 2 : 1)
            lnLE := line.new(xPos0, eL, xPos1, eL, color=belEntry, width=2)
            lnLT1 := line.new(xPos0, lTp1, xPos1, lTp1, color=lT1Hit ? color.new(#16ac09, 35) : color.new(colMuted, 30), width=1, style=lT1Hit ? line.style_dashed : line.style_dashed)
            linefill.new(lnLSl, lnLE, color.new(belDn, fT))
            line lnFar = lnLT1
            if not na(lTp2) and lTp2 > lTp1 + syminfo.mintick * 4 and not mkMinLbl
                lnLT2 := line.new(xPos0, lTp2, xPos1, lTp2, color=lT2Hit ? color.new(#16ac09, 35) : color.new(colMuted, 40), width=1, style=line.style_dashed)
                lnFar := lnLT2
            linefill.new(lnLE, lnFar, color.new(belUp, fT))
            string lSlTxt = mkMinLbl ? str.tostring(lSl, format.mintick) : lSlHit and i_posHits ? "  ✖  " : str.tostring(lSl, format.mintick)
            string lT1Txt = mkMinLbl ? str.tostring(lTp1, format.mintick) : lT1Hit and i_posHits ? "   ✔   " : "1 · " + str.tostring(lTp1, format.mintick)
            string lEntTxt = mkMinLbl ? "▲ " + str.tostring(eL, format.mintick) : "◉ " + str.tostring(eL, format.mintick) + " · R:R " + str.tostring(lRr, "#.2")
            lbLSl := label.new(xPos1, lSl, lSlTxt, style=label.style_label_left, color=colBg, textcolor=lSlHit ? belDn : belDn, size=size.tiny)
            lbLEnt := label.new(xPos1, eL, lEntTxt, style=label.style_label_left, color=colBg, textcolor=belEntry, size=mkMinLbl ? size.tiny : size.small)
            lbLT1 := label.new(xPos1, lTp1, lT1Txt, style=label.style_label_left, color=colBg, textcolor=lT1Hit ? #16ac09 : belUp, size=size.tiny)
            if not na(lnLT2)
                string lT2Txt = lT2Hit and i_posHits ? "   ✔   " : "2 · " + str.tostring(lTp2, format.mintick)
                lbLT2 := label.new(xPos1, lTp2, lT2Txt, style=label.style_label_left, color=colBg, textcolor=lT2Hit ? #16ac09 : belUp, size=size.tiny)
        else
            bxLStop := box.new(xPos0, eL, xPos1, lSl, bgcolor=colTvStop, border_color=color.new(#f23645, 55), border_width=1)
            bxLProfit := box.new(xPos0, lTp1, xPos1, eL, bgcolor=colTvProfit, border_color=color.new(#089981, 55), border_width=1)
            lnLE := line.new(xPos0, eL, xPos1, eL, color=#808080, width=1)
            lbSL := label.new(xPos1, eL, "LONG @ " + str.tostring(eL, format.mintick) + "\nTP " + str.tostring(lTp1, format.mintick) + " · SL " + str.tostring(lSl, format.mintick) + "\nR:R " + str.tostring(lRr, "#.2"), style=label.style_label_left, color=color.new(colBg, 18), textcolor=longSolid ? colG : colMuted, size=size.small)
    if drawShortPlan
        float eS = sTrig
        bool shortSolidMk = shortSolid or mkShort
        if i_posStyle == "Beluga"
            int fTs = shortSolidMk ? fillT : 96
            lnSSl := line.new(xPos0, sSl, xPos1, sSl, color=belDn, width=sSlHit ? 2 : 1)
            lnSE := line.new(xPos0, eS, xPos1, eS, color=belEntry, width=2)
            lnST1 := line.new(xPos0, sTp1, xPos1, sTp1, color=sT1Hit ? color.new(#16ac09, 35) : color.new(colMuted, 30), width=1, style=line.style_dashed)
            linefill.new(lnSE, lnSSl, color.new(belDn, fTs))
            line lnFarS = lnST1
            if not na(sTp2) and sTp2 < sTp1 - syminfo.mintick * 4 and not mkMinLbl
                lnST2 := line.new(xPos0, sTp2, xPos1, sTp2, color=sT2Hit ? color.new(#16ac09, 35) : color.new(colMuted, 40), width=1, style=line.style_dashed)
                lnFarS := lnST2
            linefill.new(lnFarS, lnSE, color.new(belUp, fTs))
            string sSlTxt = mkMinLbl ? str.tostring(sSl, format.mintick) : sSlHit and i_posHits ? "  ✖  " : str.tostring(sSl, format.mintick)
            string sT1Txt = mkMinLbl ? str.tostring(sTp1, format.mintick) : sT1Hit and i_posHits ? "   ✔   " : "1 · " + str.tostring(sTp1, format.mintick)
            string sEntTxt = mkMinLbl ? "▼ " + str.tostring(eS, format.mintick) : "◉ " + str.tostring(eS, format.mintick) + " · R:R " + str.tostring(sRr, "#.2")
            lbSSl := label.new(xPos1, sSl, sSlTxt, style=label.style_label_left, color=colBg, textcolor=belDn, size=size.tiny)
            lbSEnt := label.new(xPos1, eS, sEntTxt, style=label.style_label_left, color=colBg, textcolor=belEntry, size=mkMinLbl ? size.tiny : size.small)
            lbST1 := label.new(xPos1, sTp1, sT1Txt, style=label.style_label_left, color=colBg, textcolor=sT1Hit ? #16ac09 : belUp, size=size.tiny)
            if not na(lnST2)
                string sT2Txt = sT2Hit and i_posHits ? "   ✔   " : "2 · " + str.tostring(sTp2, format.mintick)
                lbST2 := label.new(xPos1, sTp2, sT2Txt, style=label.style_label_left, color=colBg, textcolor=sT2Hit ? #16ac09 : belUp, size=size.tiny)
        else
            bxSStop := box.new(xPos0, sSl, xPos1, eS, bgcolor=colTvStopS, border_color=color.new(#f23645, 55), border_width=1)
            bxSProfit := box.new(xPos0, eS, xPos1, sTp1, bgcolor=colTvProfitS, border_color=color.new(#089981, 55), border_width=1)
            lnSE := line.new(xPos0, eS, xPos1, eS, color=#808080, width=1)
            lbTP1 := label.new(xPos1, eS, "SHORT @ " + str.tostring(eS, format.mintick) + "\nTP " + str.tostring(sTp1, format.mintick) + " · SL " + str.tostring(sSl, format.mintick) + "\nR:R " + str.tostring(sRr, "#.2"), style=label.style_label_left, color=color.new(colBg, 18), textcolor=shortSolid ? colR : colMuted, size=size.small)

// Свечи по ХОДу (Beluga-палитра)
color edBar = eff_candleMode != "off" and pathDir != "chop" ? candleTint : na
barcolor(eff_candleMode == "barcolor" ? edBar : na, title="Ed ход (body)")
plotcandle(eff_candleMode == "plotcandle" and pathDir != "chop" ? open : na, eff_candleMode == "plotcandle" and pathDir != "chop" ? high : na, eff_candleMode == "plotcandle" and pathDir != "chop" ? low : na, eff_candleMode == "plotcandle" and pathDir != "chop" ? close : na, title="Ed свечи (ХОД)", color=edBar, wickcolor=edBar, bordercolor=edBar)

alertcondition(act == "LONG", "EdBot LONG", "EdBot: LONG trigger")
alertcondition(act == "SHORT", "EdBot SHORT", "EdBot: SHORT trigger")
