//@version=6
// EdBot v3 — разметка как у Ed (docs + нефть). НЕ EdStory. Стратегия: Ed_Bot_Strategy_v1.pine
indicator("Ed Bot Analysis v3.6", shorttitle="EdBot", overlay=true, max_boxes_count=32, max_lines_count=80, max_labels_count=56)

// ═══════════════════════════════════════════════════════════
//  Каждая галочка РИСУЕТ свой слой. Нет скрытых блокировок.
// ═══════════════════════════════════════════════════════════
grp = "На графике (галочка = слой)"
i_sr      = input.bool(true,  "1. Сопр. / Подд. (структура)", group=grp, tooltip="Жёлтый/синий = ближайшие свинги для триггера. Пунктир = контекст lookback.")
i_ctxRng  = input.bool(true,  "1b. Контекст LB (пунктир)", group=grp, tooltip="Hi/Lo всего окна — только ориентир, не триггер сделки.")
i_zone    = input.bool(true,  "2. Зелёная зона у поддержки", group=grp, tooltip="Как на разборе нефти.")
i_wedge   = input.bool(true,  "3. Клин / треугольник (2 белые линии)", group=grp, tooltip="По первым и последним свингам lookback — крупная фигура, не короткий отрезок.")
i_pat     = input.bool(true,  "4. Графический паттерн (2× / ГиП / 1-2-3)", group=grp)
i_fib     = input.bool(true,  "5. Сетка Fib (0–100 + золотая зона)", group=grp, tooltip="Откат импульса: 0 / 23.6 / 38.2 / 50 / 61.8 / 78.6 / 100. Расширения 127.2 — как цели.")
i_smc     = input.bool(false, "6. SMC: BOS + FVG + свип (по идее)", group=grp, tooltip="FVG только после BOS и retest; свип — если в «главной идее».")
i_path    = input.bool(false, "7. Прогноз хода (зигзаг) — OFF", group=grp, tooltip="Рекомендуется выключено: декоративный зигзаг не вход Ed-разбора.")
i_plan    = input.bool(true,  "8. Разбор + действие (таблица)", group=grp)
i_boxes   = input.bool(true,  "9. SL / TP1 / TP2 по реакциям", group=grp, tooltip="TP = ближайшие исторические уровни (свинг/Fib/пол), не фиксированный R:R.")

grpW = "Толщина линий"
i_wSR    = input.int(2, "Сопр. / Подд.", minval=1, maxval=6, group=grpW)
i_wWedge = input.int(3, "Клин / △", minval=1, maxval=6, group=grpW)
i_wFib   = input.int(1, "Сетка Fib", minval=1, maxval=4, group=grpW)
i_wPath  = input.int(2, "Прогноз хода", minval=1, maxval=5, group=grpW)
i_wPat   = input.int(2, "Паттерн / шея", minval=1, maxval=5, group=grpW)

grpP = "Параметры"
i_lb      = input.int(90, "Lookback разметки (баров)", minval=40, maxval=200, group=grpP, tooltip="Размер клина и диапазона. 90 ≈ как ручной разбор на 15m.")
i_swing   = input.int(3, "Окно свинга", minval=2, maxval=5, group=grpP, tooltip="Сколько баров слева/справа для pivot. Меньше (2–3) = больше свингов, чувствительнее. Больше (4–5) = глаже, медленнее. Если ±1 меняет ХОД — смотри «Уверенность» в таблице.")
i_minConf = input.float(0.55, "MIN confidence фигуры", minval=0.50, maxval=0.80, step=0.01, group=grpP)
i_dtol    = input.float(0.55, "Допуск 2× вершины %", minval=0.2, maxval=1.5, step=0.05, group=grpP)
i_hstol   = input.float(2.2, "Допуск плеч ГиП %", minval=1.0, maxval=4.0, step=0.1, group=grpP)
i_rsiLen  = input.int(14, "RSI длина", minval=5, maxval=28, group=grpP)
i_rsiOB   = input.int(70, "RSI перекупленность", minval=60, maxval=85, group=grpP)
i_rsiOS   = input.int(30, "RSI перепроданность", minval=15, maxval=40, group=grpP)

grpT = "Сделка (хирургия)"
i_minRR     = input.float(1.15, "Min R:R для SL/TP", minval=1.0, maxval=2.5, step=0.05, group=grpT, tooltip="Если TP1 ближе чем SL — боксы не рисуем, в таблице «нет edge».")
i_surgical  = input.bool(true, "Вход на триггере (не chase)", group=grpT, tooltip="R:R считается от longPx/shortPx, не от текущей close.")
i_mtf       = input.bool(true, "Сверка 60m vs текущий TF", group=grpT)
i_autoClean = input.bool(true, "Меньше слоёв на 30m+", group=grpT, tooltip="SMC/зигзаг скрываются на старших TF — меньше «налеплено».")

grpSt = "Стабильность (без «прыжков»)"
i_sweepMem  = input.int(32, "Память свипа (баров)", minval=8, maxval=80, group=grpSt, tooltip="Свип учитывается в ХОДе N баров после закрытия свечи, уровень не меняется.")
i_freezePath = input.bool(true, "ХОД/голоса только на close", group=grpSt, tooltip="Пока свеча не закрылась — не пересчитывать сценарий (нет смены на каждом тике).")
i_histPat   = input.bool(true, "Паттерн: приоритет подтверждённого в lookback", group=grpSt, tooltip="На истории рисуется последняя подтверждённая фигура, а не «forming» на текущем тике.")
i_oneIdea   = input.bool(true, "Одна идея на графике (иерархия)", group=grpSt, tooltip="На хвосте не рисуем FVG+свип+клин одновременно — только то, что в «Главная идея».")
i_wedgeMinT = input.int(2, "Мин. касаний границы клина", minval=2, maxval=4, group=grpSt)

// ── helpers ──
f_rr(float entry, float sl, float tp, bool isLong) =>
    float risk = math.abs(entry - sl)
    float rew = isLong ? tp - entry : entry - tp
    risk > syminfo.mintick ? rew / risk : 0.0
float atr = ta.atr(14)
f_pct(float a, float b) => math.abs(a - b) / math.max(math.abs(a), 1e-10) * 100.0
f_y(float y1, int x1, float y2, int x2, int x) =>
    y1 + (y2 - y1) * (x - x1) / math.max(x2 - x1, 1)
f_fib(float top, float bot, float r) => top - (top - bot) * r

colW = #e6edf3
colY = #f0c040
colB = #58a6ff
colG = #3fb950
colR = #f85149
colO = #f0883e
colP = #a371f7
colMuted = #8b949e
colBg = #161b22

// ── swings ──
int SW = 18
var float[] shP = array.new_float()
var int[]   shX = array.new_int()
var float[] slP = array.new_float()
var int[]   slX = array.new_int()
float ph = ta.pivothigh(high, i_swing, i_swing)
float pl = ta.pivotlow(low, i_swing, i_swing)
if not na(ph)
    array.push(shP, ph)
    array.push(shX, bar_index - i_swing)
    while array.size(shP) > SW
        array.shift(shP)
        array.shift(shX)
if not na(pl)
    array.push(slP, pl)
    array.push(slX, bar_index - i_swing)
    while array.size(slP) > SW
        array.shift(slP)
        array.shift(slX)

int xNow = bar_index
int xL0  = math.max(0, xNow - i_lb)
int xR   = xNow + 28

f_first_hi_in(int fromX) =>
    int ix = na
    float px = na
    if array.size(shX) > 0
        for i = 0 to array.size(shX) - 1
            int xx = array.get(shX, i)
            if xx >= fromX and na(ix)
                ix := xx
                px := array.get(shP, i)
    [ix, px]

f_last_hi() =>
    int n = array.size(shX)
    int ix = n > 0 ? array.get(shX, n - 1) : na
    float px = n > 0 ? array.get(shP, n - 1) : na
    [ix, px]

f_first_lo_in(int fromX) =>
    int ix = na
    float px = na
    if array.size(slX) > 0
        for i = 0 to array.size(slX) - 1
            int xx = array.get(slX, i)
            if xx >= fromX and na(ix)
                ix := xx
                px := array.get(slP, i)
    [ix, px]

f_last_lo() =>
    int n = array.size(slX)
    int ix = n > 0 ? array.get(slX, n - 1) : na
    float px = n > 0 ? array.get(slP, n - 1) : na
    [ix, px]

f_swing_res_above(float px) =>
    float best = na
    if array.size(shP) > 0
        for i = 0 to array.size(shP) - 1
            float v = array.get(shP, i)
            if v >= px - syminfo.mintick * 4
                best := na(best) ? v : math.min(best, v)
    best

f_swing_sup_below(float px) =>
    float best = na
    if array.size(slP) > 0
        for i = 0 to array.size(slP) - 1
            float v = array.get(slP, i)
            if v <= px + syminfo.mintick * 4
                best := na(best) ? v : math.max(best, v)
    best

// ── range ──
float rngHi = ta.highest(high, i_lb)
float rngLo = ta.lowest(low, i_lb)
float rngW  = rngHi - rngLo
float structRes = f_swing_res_above(close)
float structSup = f_swing_sup_below(close)
if na(structRes) and array.size(shP) > 0
    structRes := array.get(shP, array.size(shP) - 1)
if na(structSup) and array.size(slP) > 0
    structSup := array.get(slP, array.size(slP) - 1)
structRes := na(structRes) ? rngHi : structRes
structSup := na(structSup) ? rngLo : structSup
float structW = math.max(structRes - structSup, syminfo.mintick * 8)
float posR  = structW > 0 ? (close - structSup) / structW : 0.5
float posRctx = rngW > 0 ? (close - rngLo) / rngW : 0.5
bool  inMid = posR > 0.32 and posR < 0.68

// ── impulse + fib (якорь на реальных экстремумах ноги) ──
int fibLb = math.min(i_lb, 80)
float impHi = ta.highest(high, fibLb)
float impLo = ta.lowest(low, fibLb)
int hiAgo = int(-ta.highestbars(high, fibLb))
int loAgo = int(-ta.lowestbars(low, fibLb))
bool impUp = loAgo > hiAgo
int xFib0 = xNow - math.max(hiAgo, loAgo)
int xFib1 = xNow - math.min(hiAgo, loAgo)
float f0   = impUp ? impHi : impLo
float f100 = impUp ? impLo : impHi
float f236 = impUp ? f_fib(impHi, impLo, 0.236) : impLo + (impHi - impLo) * 0.236
float f382 = impUp ? f_fib(impHi, impLo, 0.382) : impLo + (impHi - impLo) * 0.382
float f50  = impUp ? f_fib(impHi, impLo, 0.500) : impLo + (impHi - impLo) * 0.500
float f618 = impUp ? f_fib(impHi, impLo, 0.618) : impLo + (impHi - impLo) * 0.618
float f786 = impUp ? f_fib(impHi, impLo, 0.786) : impLo + (impHi - impLo) * 0.786
float f886 = impUp ? f_fib(impHi, impLo, 0.886) : impLo + (impHi - impLo) * 0.886
float f127 = impUp ? impHi + (impHi - impLo) * 0.272 : impLo - (impHi - impLo) * 0.272
float f161 = impUp ? impHi + (impHi - impLo) * 0.618 : impLo - (impHi - impLo) * 0.618

// ── RSI ──
float rsi = ta.rsi(close, i_rsiLen)
bool rsiOB = rsi >= i_rsiOB
bool rsiOS = rsi <= i_rsiOS
bool rsiBearDiv = false
bool rsiBullDiv = false
if array.size(shP) >= 2 and array.size(shX) >= 2
    int aH = xNow - array.get(shX, array.size(shX) - 2)
    int bH = xNow - array.get(shX, array.size(shX) - 1)
    if aH >= 0 and bH >= 0 and array.get(shP, array.size(shP) - 1) > array.get(shP, array.size(shP) - 2) and rsi[bH] < rsi[aH] - 1.5
        rsiBearDiv := true
if array.size(slP) >= 2 and array.size(slX) >= 2
    int aL = xNow - array.get(slX, array.size(slX) - 2)
    int bL = xNow - array.get(slX, array.size(slX) - 1)
    if aL >= 0 and bL >= 0 and array.get(slP, array.size(slP) - 1) < array.get(slP, array.size(slP) - 2) and rsi[bL] > rsi[aL] + 1.5
        rsiBullDiv := true
string rsiRu = rsiOB ? "перекуплен " + str.tostring(rsi, "#.0") : rsiOS ? "перепродан " + str.tostring(rsi, "#.0") : str.tostring(rsi, "#.0") + (rsiBearDiv ? " · медв. див." : rsiBullDiv ? " · быч. див." : "")
[_, _, adxVal] = ta.dmi(14, 14)
string trendStrRu = adxVal < 18 ? "слабый ADX " + str.tostring(adxVal, "#.0") : adxVal < 26 ? "умеренный " + str.tostring(adxVal, "#.0") : "сильный " + str.tostring(adxVal, "#.0")
bool isHtf = timeframe.in_seconds() >= 1800

// ── SMC lite ──
bool fvgUp = low > high[2]
bool fvgDn = high < low[2]

// Свип = пробой СТРУКТУРНОГО уровня (пред. свинг) + close ЗАКРЫТОЙ свечи [1] обратно внутрь
var int   sweepBearBar = na
var float sweepBearLvl = na
var float sweepBearY = na
var int   sweepBullBar = na
var float sweepBullLvl = na
var float sweepBullY = na
if barstate.isconfirmed
    float shRef = array.size(shP) >= 2 ? array.get(shP, array.size(shP) - 2) : na
    float slRef = array.size(slP) >= 2 ? array.get(slP, array.size(slP) - 2) : na
    if not na(shRef) and high[1] > shRef and close[1] < shRef
        sweepBearBar := bar_index - 1
        sweepBearLvl := shRef
        sweepBearY := high[1]
    if not na(slRef) and low[1] < slRef and close[1] > slRef
        sweepBullBar := bar_index - 1
        sweepBullLvl := slRef
        sweepBullY := low[1]

bool sweepHiAct = not na(sweepBearBar) and bar_index - sweepBearBar <= i_sweepMem
bool sweepLoAct = not na(sweepBullBar) and bar_index - sweepBullBar <= i_sweepMem
string sweepRu = sweepHiAct ? "свип ↑ @ " + str.tostring(sweepBearLvl, format.mintick) + " · " + str.tostring(bar_index - sweepBearBar) + " бар назад" : sweepLoAct ? "свип ↓ @ " + str.tostring(sweepBullLvl, format.mintick) + " · " + str.tostring(bar_index - sweepBullBar) + " бар назад" : "не зафиксирован"

var bool bosUpMemo = false
var bool bosDnMemo = false
if barstate.isconfirmed
    bosUpMemo := array.size(shP) > 0 and close > array.get(shP, array.size(shP) - 1)
    bosDnMemo := array.size(slP) > 0 and close < array.get(slP, array.size(slP) - 1)
bool bosUp = bosUpMemo
bool bosDn = bosDnMemo

// FVG после импульса: последний bull/bear gap + не заполнен + в зоне retest
var int   fvgBar = na
var float fvgTop = na
var float fvgBot = na
var bool  fvgBull = false
if barstate.isconfirmed
    fvgBar := na
    for k = 2 to math.min(36, xNow)
        if na(fvgBar)
            bool u = low[k] > high[k + 2]
            bool d = high[k] < low[k + 2]
            if u
                fvgBar := bar_index - k
                fvgBot := high[k + 2]
                fvgTop := low[k]
                fvgBull := true
            else if d
                fvgBar := bar_index - k
                fvgBot := high[k]
                fvgTop := low[k + 2]
                fvgBull := false
int fvgAge = na(fvgBar) ? 999 : bar_index - fvgBar
bool fvgFresh = fvgAge <= 48
float fvgWinLo = ta.lowest(low, 49)
float fvgWinHi = ta.highest(high, 49)
bool fvgUnfilled = fvgFresh and not na(fvgBot) and (fvgBull ? fvgWinLo >= fvgBot - syminfo.mintick * 2 : fvgWinHi <= fvgTop + syminfo.mintick * 2)
bool fvgRetest = fvgUnfilled and (fvgBull ? close >= fvgBot and close <= fvgTop + atr * 0.35 : close <= fvgTop and close >= fvgBot - atr * 0.35)
bool fvgSetup = fvgRetest and ((fvgBull and bosUpMemo) or (not fvgBull and bosDnMemo))
float hi12 = ta.highest(high, 12)
float lo12 = ta.lowest(low, 12)
float volSma20 = ta.sma(volume, 20)
bool obBull = close > hi12[1] and close > open and volume > volSma20 * 1.15
bool obBear = close < lo12[1] and close < open and volume > volSma20 * 1.15

// ── pattern scan (last bar) ──
var string patKind = ""
var string patSt   = ""
var string patDir  = ""
var float  patConf = 0.0
var float  patNeck = na
var float  patTgt  = na
var float  patStp  = na
var int    pI1 = na
var int    pI2 = na
var int    pI3 = na
var float  pP1 = na
var float  pP2 = na
var float  pP3 = na
var float  pNL = na
var float  pNR = na
var int    pNLx = na
var int    pNRx = na
var string patKind2 = ""
var float  patNeck2 = na
var int    p2I1 = na
var int    p2I2 = na
var float  p2P1 = na
var float  p2P2 = na

if barstate.islast and (barstate.isconfirmed or not i_freezePath)
    string cK = ""
    string cS = ""
    string cD = ""
    float  cC = 0.0
    float  cN = na
    float  cT = na
    float  cSp = na
    int    i1 = na
    int    i2 = na
    int    i3 = na
    float  y1 = na
    float  y2 = na
    float  y3 = na
    float  nL = na
    float  nR = na
    int    nLx = na
    int    nRx = na
    float  best = 0.0
    string cKc = ""
    string cSc = ""
    string cDc = ""
    float  cCc = 0.0
    float  cNc = na
    float  cTc = na
    float  cSpc = na
    int    i1c = na
    int    i2c = na
    int    i3c = na
    float  y1c = na
    float  y2c = na
    float  y3c = na
    float  nLc = na
    float  nRc = na
    int    nLxc = na
    int    nRxc = na
    float  bestC = 0.0
    string cKc2 = ""
    string cSc2 = ""
    float  cCc2 = 0.0
    float  cNc2 = na
    int    i1c2 = na
    int    i2c2 = na
    float  y1c2 = na
    float  y2c2 = na
    float  bestC2 = 0.0

    // double top
    if array.size(shP) >= 2
        for i = math.max(0, array.size(shP) - 6) to array.size(shP) - 2
            float a = array.get(shP, i)
            float b = array.get(shP, i + 1)
            int xa = array.get(shX, i)
            int xb = array.get(shX, i + 1)
            if xb - xa < 6 or xb - xa > 50 or f_pct(a, b) > i_dtol
                continue
            float neck = na
            if array.size(slP) > 0
                for j = 0 to array.size(slP) - 1
                    int lx = array.get(slX, j)
                    if lx > xa and lx < xb
                        neck := na(neck) ? array.get(slP, j) : math.min(neck, array.get(slP, j))
            if na(neck)
                continue
            float h = math.max(a, b) - neck
            if h < atr * 0.7
                continue
            string st = close < neck ? "confirmed" : "forming"
            float conf = 0.58 + (f_pct(a, b) < 0.35 ? 0.12 : 0.0) + (st == "confirmed" ? 0.14 : 0.04)
            if conf >= i_minConf and conf >= best
                best := conf
                cK := "double_top"
                cS := st
                cD := "bearish"
                cC := conf
                cN := neck
                cT := neck - h
                cSp := math.max(a, b) + atr * 0.2
                i1 := xa
                i2 := xb
                y1 := a
                y2 := b
            if st == "confirmed" and xb >= xNow - i_lb and conf >= i_minConf
                if conf >= bestC
                    if bestC >= i_minConf and i1c != i1
                        bestC2 := bestC
                        cKc2 := cKc
                        cSc2 := cSc
                        cCc2 := cCc
                        cNc2 := cNc
                        i1c2 := i1c
                        i2c2 := i2c
                        y1c2 := y1c
                        y2c2 := y2c
                    bestC := conf
                    cKc := "double_top"
                    cSc := st
                    cDc := "bearish"
                    cCc := conf
                    cNc := neck
                    cTc := neck - h
                    cSpc := math.max(a, b) + atr * 0.2
                    i1c := xa
                    i2c := xb
                    y1c := a
                    y2c := b
                else if conf >= bestC2 and i1 != i1c
                    bestC2 := conf
                    cKc2 := "double_top"
                    cSc2 := st
                    cCc2 := conf
                    cNc2 := neck
                    i1c2 := xa
                    i2c2 := xb
                    y1c2 := a
                    y2c2 := b

    // double bottom
    if array.size(slP) >= 2
        for i = math.max(0, array.size(slP) - 6) to array.size(slP) - 2
            float a = array.get(slP, i)
            float b = array.get(slP, i + 1)
            int xa = array.get(slX, i)
            int xb = array.get(slX, i + 1)
            if xb - xa < 6 or xb - xa > 50 or f_pct(a, b) > i_dtol
                continue
            float neck = na
            if array.size(shP) > 0
                for j = 0 to array.size(shP) - 1
                    int hx = array.get(shX, j)
                    if hx > xa and hx < xb
                        neck := na(neck) ? array.get(shP, j) : math.max(neck, array.get(shP, j))
            if na(neck)
                continue
            float h = neck - math.min(a, b)
            if h < atr * 0.7
                continue
            string st = close > neck ? "confirmed" : "forming"
            float conf = 0.58 + (f_pct(a, b) < 0.35 ? 0.12 : 0.0) + (st == "confirmed" ? 0.14 : 0.04)
            if conf >= i_minConf and conf >= best
                best := conf
                cK := "double_bottom"
                cS := st
                cD := "bullish"
                cC := conf
                cN := neck
                cT := neck + h
                cSp := math.min(a, b) - atr * 0.2
                i1 := xa
                i2 := xb
                y1 := a
                y2 := b
            if st == "confirmed" and xb >= xNow - i_lb and conf >= i_minConf
                if conf >= bestC
                    if bestC >= i_minConf and i1c != i1
                        bestC2 := bestC
                        cKc2 := cKc
                        cSc2 := cSc
                        cCc2 := cCc
                        cNc2 := cNc
                        i1c2 := i1c
                        i2c2 := i2c
                        y1c2 := y1c
                        y2c2 := y2c
                    bestC := conf
                    cKc := "double_bottom"
                    cSc := st
                    cDc := "bullish"
                    cCc := conf
                    cNc := neck
                    cTc := neck + h
                    cSpc := math.min(a, b) - atr * 0.2
                    i1c := xa
                    i2c := xb
                    y1c := a
                    y2c := b
                else if conf >= bestC2 and i1 != i1c
                    bestC2 := conf
                    cKc2 := "double_bottom"
                    cSc2 := st
                    cCc2 := conf
                    cNc2 := neck
                    i1c2 := xa
                    i2c2 := xb
                    y1c2 := a
                    y2c2 := b

    // H&S
    if array.size(shP) >= 3
        int i = array.size(shP) - 3
        float ls = array.get(shP, i)
        float hd = array.get(shP, i + 1)
        float rs = array.get(shP, i + 2)
        int xs = array.get(shX, i)
        int xh = array.get(shX, i + 1)
        int xr = array.get(shX, i + 2)
        if ls < hd and hd > rs and f_pct(ls, rs) <= i_hstol
            float nl = na
            float nr = na
            int nli = xs
            int nri = xr
            if array.size(slP) > 0
                for j = 0 to array.size(slP) - 1
                    int lx = array.get(slX, j)
                    float lp = array.get(slP, j)
                    if lx > xs and lx < xh
                        nl := na(nl) ? lp : math.min(nl, lp)
                        nli := lx
                    if lx > xh and lx < xr
                        nr := na(nr) ? lp : math.min(nr, lp)
                        nri := lx
            if not na(nl) and not na(nr)
                float neck = f_y(nl, nli, nr, nri, xr)
                float h = hd - neck
                if h >= atr
                    string st = close < neck ? "confirmed" : "forming"
                    float conf = 0.62 + (st == "confirmed" ? 0.14 : 0.04)
                    if conf >= i_minConf and conf >= best
                        best := conf
                        cK := "head_shoulders"
                        cS := st
                        cD := "bearish"
                        cC := conf
                        cN := neck
                        cT := neck - h
                        cSp := hd + atr * 0.15
                        i1 := xs
                        i2 := xh
                        i3 := xr
                        y1 := ls
                        y2 := hd
                        y3 := rs
                        nL := nl
                        nR := nr
                        nLx := nli
                        nRx := nri
                    if st == "confirmed" and xr >= xNow - i_lb and conf >= i_minConf and conf >= bestC
                        bestC := conf
                        cKc := "head_shoulders"
                        cSc := st
                        cDc := "bearish"
                        cCc := conf
                        cNc := neck
                        cTc := neck - h
                        cSpc := hd + atr * 0.15
                        i1c := xs
                        i2c := xh
                        i3c := xr
                        y1c := ls
                        y2c := hd
                        y3c := rs
                        nLc := nl
                        nRc := nr
                        nLxc := nli
                        nRxc := nri

    // inverse H&S
    if array.size(slP) >= 3
        int i = array.size(slP) - 3
        float ls = array.get(slP, i)
        float hd = array.get(slP, i + 1)
        float rs = array.get(slP, i + 2)
        int xs = array.get(slX, i)
        int xh = array.get(slX, i + 1)
        int xr = array.get(slX, i + 2)
        if ls > hd and hd < rs and f_pct(ls, rs) <= i_hstol
            float nl = na
            float nr = na
            int nli = xs
            int nri = xr
            if array.size(shP) > 0
                for j = 0 to array.size(shP) - 1
                    int hx = array.get(shX, j)
                    float hp = array.get(shP, j)
                    if hx > xs and hx < xh
                        nl := na(nl) ? hp : math.max(nl, hp)
                        nli := hx
                    if hx > xh and hx < xr
                        nr := na(nr) ? hp : math.max(nr, hp)
                        nri := hx
            if not na(nl) and not na(nr)
                float neck = f_y(nl, nli, nr, nri, xr)
                float h = neck - hd
                if h >= atr
                    string st = close > neck ? "confirmed" : "forming"
                    float conf = 0.62 + (st == "confirmed" ? 0.14 : 0.04)
                    if conf >= i_minConf and conf >= best
                        best := conf
                        cK := "inverse_head_shoulders"
                        cS := st
                        cD := "bullish"
                        cC := conf
                        cN := neck
                        cT := neck + h
                        cSp := hd - atr * 0.15
                        i1 := xs
                        i2 := xh
                        i3 := xr
                        y1 := ls
                        y2 := hd
                        y3 := rs
                        nL := nl
                        nR := nr
                        nLx := nli
                        nRx := nri
                    if st == "confirmed" and xr >= xNow - i_lb and conf >= i_minConf and conf >= bestC
                        bestC := conf
                        cKc := "inverse_head_shoulders"
                        cSc := st
                        cDc := "bullish"
                        cCc := conf
                        cNc := neck
                        cTc := neck + h
                        cSpc := hd - atr * 0.15
                        i1c := xs
                        i2c := xh
                        i3c := xr
                        y1c := ls
                        y2c := hd
                        y3c := rs
                        nLc := nl
                        nRc := nr
                        nLxc := nli
                        nRxc := nri

    // 1-2-3 bear (HH then LH then break of HL)
    if array.size(shP) >= 2 and array.size(slP) >= 2
        float h1 = array.get(shP, array.size(shP) - 2)
        float h2 = array.get(shP, array.size(shP) - 1)
        float l1 = array.get(slP, array.size(slP) - 2)
        float l2 = array.get(slP, array.size(slP) - 1)
        int xh1 = array.get(shX, array.size(shP) - 2)
        int xh2 = array.get(shX, array.size(shP) - 1)
        int xl2 = array.get(slX, array.size(slP) - 1)
        if h2 < h1 and l2 < l1 and xh2 > xh1
            string st = close < l2 ? "confirmed" : "forming"
            float conf = 0.56 + (st == "confirmed" ? 0.14 : 0.04)
            if conf >= i_minConf and conf >= best
                best := conf
                cK := "one_two_three"
                cS := st
                cD := "bearish"
                cC := conf
                cN := l2
                cT := l2 - (h2 - l2)
                cSp := h2 + atr * 0.2
                i1 := xh1
                i2 := xh2
                i3 := xl2
                y1 := h1
                y2 := h2
                y3 := l2
            if st == "confirmed" and xh2 >= xNow - i_lb and conf >= i_minConf and conf >= bestC
                bestC := conf
                cKc := "one_two_three"
                cSc := st
                cDc := "bearish"
                cCc := conf
                cNc := l2
                cTc := l2 - (h2 - l2)
                cSpc := h2 + atr * 0.2
                i1c := xh1
                i2c := xh2
                i3c := xl2
                y1c := h1
                y2c := h2
                y3c := l2

    // 1-2-3 bull
    if array.size(slP) >= 2 and array.size(shP) >= 2
        float l1 = array.get(slP, array.size(slP) - 2)
        float l2 = array.get(slP, array.size(slP) - 1)
        float h1 = array.get(shP, array.size(shP) - 2)
        float h2 = array.get(shP, array.size(shP) - 1)
        int xl1 = array.get(slX, array.size(slP) - 2)
        int xl2 = array.get(slX, array.size(slP) - 1)
        int xh2 = array.get(shX, array.size(shP) - 1)
        if l2 > l1 and h2 > h1 and xl2 > xl1
            string st = close > h2 ? "confirmed" : "forming"
            float conf = 0.56 + (st == "confirmed" ? 0.14 : 0.04)
            if conf >= i_minConf and conf >= best
                best := conf
                cK := "one_two_three"
                cS := st
                cD := "bullish"
                cC := conf
                cN := h2
                cT := h2 + (h2 - l2)
                cSp := l2 - atr * 0.2
                i1 := xl1
                i2 := xl2
                i3 := xh2
                y1 := l1
                y2 := l2
                y3 := h2
            if st == "confirmed" and xl2 >= xNow - i_lb and conf >= i_minConf and conf >= bestC
                bestC := conf
                cKc := "one_two_three"
                cSc := st
                cDc := "bullish"
                cCc := conf
                cNc := h2
                cTc := h2 + (h2 - l2)
                cSpc := l2 - atr * 0.2
                i1c := xl1
                i2c := xl2
                i3c := xh2
                y1c := l1
                y2c := l2
                y3c := h2

    bool useHist = i_histPat and cKc != ""
    patKind := useHist ? cKc : cK
    patSt := useHist ? cSc : cS
    patDir := useHist ? cDc : cD
    patConf := useHist ? cCc : cC
    patNeck := useHist ? cNc : cN
    patTgt := useHist ? cTc : cT
    patStp := useHist ? cSpc : cSp
    pI1 := useHist ? i1c : i1
    pI2 := useHist ? i2c : i2
    pI3 := useHist ? i3c : i3
    pP1 := useHist ? y1c : y1
    pP2 := useHist ? y2c : y2
    pP3 := useHist ? y3c : y3
    pNL := useHist ? nLc : nL
    pNR := useHist ? nRc : nR
    pNLx := useHist ? nLxc : nLx
    pNRx := useHist ? nRxc : nRx
    patKind2 := cKc2
    patNeck2 := cNc2
    p2I1 := i1c2
    p2I2 := i2c2
    p2P1 := y1c2
    p2P2 := y2c2

string patRu = patKind == "double_top" ? "двойная вершина" : patKind == "double_bottom" ? "двойное дно" : patKind == "head_shoulders" ? "голова и плечи" : patKind == "inverse_head_shoulders" ? "перев. ГиП" : patKind == "one_two_three" ? "1-2-3" : ""

// ── wedge geometry (крупный, как ручная нефть) ──
[wHx0, wHy0] = f_first_hi_in(xL0)
[wHx1, wHy1] = f_last_hi()
[wLx0, wLy0] = f_first_lo_in(xL0)
[wLx1, wLy1] = f_last_lo()
bool wedgeGeom = i_wedge and not na(wHx0) and not na(wHx1) and not na(wLx0) and not na(wLx1) and wHx1 != wHx0 and wLx1 != wLx0 and (wHx1 - wHx0) >= 12 and (wLx1 - wLx0) >= 12
int xW0g = wedgeGeom ? math.min(wHx0, wLx0) : na
float wTop0 = wedgeGeom ? f_y(wHy0, wHx0, wHy1, wHx1, xW0g) : na
float wBot0 = wedgeGeom ? f_y(wLy0, wLx0, wLy1, wLx1, xW0g) : na
float wTop1 = wedgeGeom ? f_y(wHy0, wHx0, wHy1, wHx1, xNow) : na
float wBot1 = wedgeGeom ? f_y(wLy0, wLx0, wLy1, wLx1, xNow) : na
float wWide0 = wedgeGeom ? wTop0 - wBot0 : na
float wWide1 = wedgeGeom ? wTop1 - wBot1 : na
float slopeH = wedgeGeom ? (wHy1 - wHy0) / math.max(wHx1 - wHx0, 1) : 0.0
float slopeL = wedgeGeom ? (wLy1 - wLy0) / math.max(wLx1 - wLx0, 1) : 0.0
bool wParallel = wedgeGeom and math.abs(slopeH - slopeL) <= math.max(math.abs(slopeH), math.abs(slopeL), 1e-8) * 0.28
bool wConverge = wedgeGeom and not wParallel and wWide1 < wWide0 * 0.88
bool wExpand = wedgeGeom and not wParallel and wWide1 > wWide0 * 1.08
int touchU = 0
int touchL = 0
float tolW = atr * 0.42
if wedgeGeom
    if array.size(shX) > 0
        for i = 0 to array.size(shX) - 1
            int xx = array.get(shX, i)
            if xx >= xW0g and xx <= xNow
                float yL = f_y(wHy0, wHx0, wHy1, wHx1, xx)
                if math.abs(array.get(shP, i) - yL) <= tolW
                    touchU += 1
    if array.size(slX) > 0
        for i = 0 to array.size(slX) - 1
            int xx = array.get(slX, i)
            if xx >= xW0g and xx <= xNow
                float yL = f_y(wLy0, wLx0, wLy1, wLx1, xx)
                if math.abs(array.get(slP, i) - yL) <= tolW
                    touchL += 1
bool figValid = wedgeGeom and touchU >= i_wedgeMinT and touchL >= i_wedgeMinT
bool wedgeOk = figValid
float wHiNow = wedgeOk ? wTop1 : na
float wLoNow = wedgeOk ? wBot1 : na
bool hiFall = wedgeGeom and wHy1 <= wHy0 * 1.001
bool loRise = wedgeGeom and wLy1 >= wLy0 * 0.999
bool hiRise = wedgeGeom and wHy1 > wHy0 * 1.001
bool loFall = wedgeGeom and wLy1 < wLy0 * 0.999
string wedgeRu = not wedgeGeom ? "" : not figValid ? "линии без касаний (" + str.tostring(touchU) + "/" + str.tostring(touchL) + ")" : wParallel ? (hiRise ? "канал ↑" : hiFall ? "канал ↓" : "канал") : wExpand ? "расширение" : wConverge and hiFall and loRise ? "сход. △" : wConverge and hiFall and loFall ? "клин ↓" : wConverge and hiRise and loRise ? "клин ↑" : wConverge ? "сходящийся △" : hiFall ? "нисход. △" : loRise ? "восход. △" : "канал"
bool wedgeBrUp = wedgeOk and close > wHiNow
bool wedgeBrDn = wedgeOk and close < wLoNow

int priRank = 9
string ideaRu = "ждать — нет доминирующего сетапа"
if patSt == "confirmed" and patRu != ""
    priRank := 1
    ideaRu := "1) " + patRu + " · шея " + str.tostring(patNeck, format.mintick)
else if wedgeBrUp
    priRank := 2
    ideaRu := "2) пробой верха · " + wedgeRu
else if wedgeBrDn
    priRank := 2
    ideaRu := "2) пробой низа · " + wedgeRu
else if sweepLoAct
    priRank := 3
    ideaRu := "3) свип dn @ " + str.tostring(sweepBullLvl, format.mintick)
else if sweepHiAct
    priRank := 3
    ideaRu := "3) свип up @ " + str.tostring(sweepBearLvl, format.mintick)
else if fvgSetup
    priRank := 4
    ideaRu := fvgBull ? "4) BOS + retest demand FVG" : "4) BOS + retest supply FVG"
else if wedgeOk
    priRank := 5
    ideaRu := "5) " + wedgeRu + " · триггер у границы"
else if patKind != "" and patSt == "forming"
    priRank := 6
    ideaRu := "6) " + patRu + " · ждать пробой шеи"

bool showSmcSweep = i_smc and (sweepHiAct or sweepLoAct) and (not i_oneIdea or priRank == 3)
bool showSmcFvg = i_smc and fvgSetup and fvgFresh and (not i_oneIdea or priRank == 4)
bool showSmcBos = i_smc and (bosUp or bosDn) and (not i_oneIdea or priRank <= 2)

// ── phase + bias (путь) vs action (вход) ──
bool compress = ta.sma(high - low, 10) <= ta.sma(high - low, 28) * 0.60
string phaseRu = compress ? "сжатие / боковик" : close > close[i_lb / 2] ? "импульс вверх" : "импульс вниз"
string whereRu = posR >= 0.72 ? "у потолка" : posR <= 0.28 ? "у пола" : "в середине диапазона"

var int bearN = 0
var int bullN = 0
var int pathScore = 0
var string pathDir = "chop"
if barstate.isconfirmed or not i_freezePath
    bearN := 0
    bullN := 0
    if posR >= 0.70
        bearN += 2
    if posR <= 0.30
        bullN += 2
    if rsiOB
        bearN += 2
    if rsiOS
        bullN += 2
    if rsiBearDiv
        bearN += 2
    if rsiBullDiv
        bullN += 2
    if sweepHiAct
        bearN += 2
    if sweepLoAct
        bullN += 2
    if wedgeOk and hiRise and loRise and posR > 0.55
        bearN += 2
    if wedgeOk and hiFall and loFall and posR < 0.45
        bullN += 2
    if patDir == "bearish"
        bearN += patSt == "confirmed" ? 3 : 1
    if patDir == "bullish"
        bullN += patSt == "confirmed" ? 3 : 1
    if close > structRes
        bullN += 2
    if close < structSup
        bearN += 2
    if close > rngHi
        bullN += 1
    if close < rngLo
        bearN += 1
    if wedgeBrUp
        bullN += 2
    if wedgeBrDn
        bearN += 2
    pathScore := bearN - bullN
    pathDir := pathScore >= 2 ? "down" : pathScore <= -2 ? "up" : "chop"
string pathRu = pathDir == "down" ? "ожидаем вниз" : pathDir == "up" ? "ожидаем вверх" : "нет ясного хода"
int pathMag = math.abs(pathScore)
string confRu = pathDir == "chop" ? "слабая — нет перевеса факторов" : pathMag >= 6 ? "высокая" : pathMag >= 4 ? "средняя" : "низкая — чувствительна к свингу"
string stabRu = pathMag >= 4 or patSt == "confirmed" ? "устойчивее (±1 свинг реже ломает)" : "осторожно: ±1 свинг может сменить ХОД"
string voteRu = "медв " + str.tostring(bearN) + " · быч " + str.tostring(bullN) + " · Δ " + str.tostring(pathScore)

var string act = "ЖДАТЬ"
var string why = "между полом и потолком без закрытия за уровень — нет входа"
float longPx  = wedgeOk ? math.max(wHiNow, structRes) : structRes
float shortPx = wedgeOk ? math.min(wLoNow, structSup) : structSup
if not na(patNeck) and patDir == "bullish"
    longPx := math.max(longPx, patNeck)
if not na(patNeck) and patDir == "bearish"
    shortPx := math.min(shortPx, patNeck)

if barstate.isconfirmed or not i_freezePath
    act := "ЖДАТЬ"
    why := "между полом и потолком без закрытия за уровень — нет входа"
    if wedgeBrUp or (bosUp and close > structRes)
        act := "LONG"
        why := "закрытие выше структуры / границы фигуры"
    else if wedgeBrDn or (bosDn and close < structSup)
        act := "SHORT"
        why := "закрытие ниже структуры / границы фигуры"
    else if patSt == "confirmed" and patDir == "bullish"
        act := "LONG"
        why := patRu + " подтверждён пробоем шеи"
    else if patSt == "confirmed" and patDir == "bearish"
        act := "SHORT"
        why := patRu + " подтверждён пробоем шеи"
    else if pathDir == "down"
        why := "сценарий вниз (RSI / свип / клин) — вход close ниже триггера"
    else if pathDir == "up"
        why := "сценарий вверх (RSI / дно / клин) — вход close выше триггера"
    if act == "LONG" and posR >= 0.72 and close < longPx
        act := "ЖДАТЬ"
        why := "у сопротивления: лонг только после close > триггера, не chase"
    if act == "SHORT" and posR <= 0.28 and close > shortPx
        act := "ЖДАТЬ"
        why := "у поддержки: шорт только после close < триггера"

bool effSmc = i_smc and not (i_autoClean and isHtf)
bool effPath = i_path and not (i_autoClean and isHtf and pathMag < 4 and act == "ЖДАТЬ")
bool effSmcAny = effSmc and (showSmcSweep or showSmcFvg or showSmcBos)

float minGap = math.max(atr * 0.35, rngW * 0.04)

f_nearest_below(float px, float floorGap, float skipLv) =>
    float best = na
    float bestD = 1e12
    if array.size(slP) > 0
        for i = 0 to array.size(slP) - 1
            float lv = array.get(slP, i)
            if lv < px - floorGap and (na(skipLv) or math.abs(lv - skipLv) > floorGap)
                float d = px - lv
                if d < bestD
                    bestD := d
                    best := lv
    float[] extraDn = array.from(rngLo, f50, f618, f786, f100, f886, impLo)
    for j = 0 to array.size(extraDn) - 1
        float lv = array.get(extraDn, j)
        if not na(lv) and lv < px - floorGap and (na(skipLv) or math.abs(lv - skipLv) > floorGap)
            float d = px - lv
            if d < bestD
                bestD := d
                best := lv
    best

f_nearest_above(float px, float floorGap, float skipLv) =>
    float best = na
    float bestD = 1e12
    if array.size(shP) > 0
        for i = 0 to array.size(shP) - 1
            float lv = array.get(shP, i)
            if lv > px + floorGap and (na(skipLv) or math.abs(lv - skipLv) > floorGap)
                float d = lv - px
                if d < bestD
                    bestD := d
                    best := lv
    float[] extraUp = array.from(rngHi, f50, f618, f382, f0, f127, f161, impHi)
    for j = 0 to array.size(extraUp) - 1
        float lv = array.get(extraUp, j)
        if not na(lv) and lv > px + floorGap and (na(skipLv) or math.abs(lv - skipLv) > floorGap)
            float d = lv - px
            if d < bestD
                bestD := d
                best := lv
    best

string planSide = ""
if act == "LONG" or act == "SHORT"
    planSide := act
else if act == "ЖДАТЬ"
    if pathDir == "down" and posR >= 0.50
        planSide := "SHORT"
    else if pathDir == "up" and posR <= 0.50
        planSide := "LONG"

float entryPx = na
if planSide == "LONG"
    entryPx := i_surgical ? longPx : close
else if planSide == "SHORT"
    entryPx := i_surgical ? shortPx : close

float slPx = na
float tp1 = na
float tp2 = na
string tp1Why = ""
string slWhy = ""
if planSide == "SHORT"
    float lastHi = array.size(shP) > 0 ? array.get(shP, array.size(shP) - 1) : high
    slPx := math.max(lastHi, na(wHiNow) ? lastHi : wHiNow) + atr * 0.18
    slWhy := "за последним хаем / верхом клина"
    tp1 := f_nearest_below(entryPx, minGap, na)
    tp1Why := "ближайшая реакция снизу (свинг / Fib / пол)"
    tp2 := f_nearest_below(na(tp1) ? entryPx : tp1, minGap, tp1)
    if na(tp1)
        tp1 := rngLo
        tp1Why := "пол диапазона"
    if na(tp2)
        tp2 := impUp ? f100 : f127
else if planSide == "LONG"
    float lastLo = array.size(slP) > 0 ? array.get(slP, array.size(slP) - 1) : low
    slPx := math.min(lastLo, na(wLoNow) ? lastLo : wLoNow) - atr * 0.18
    slWhy := "за последним лоем / низом клина"
    tp1 := f_nearest_above(entryPx, minGap, na)
    tp1Why := "ближайшая реакция сверху (свинг / Fib / потолок)"
    tp2 := f_nearest_above(na(tp1) ? entryPx : tp1, minGap, tp1)
    if na(tp1)
        tp1 := rngHi
        tp1Why := "потолок диапазона"
    if na(tp2)
        tp2 := impUp ? f127 : f0

bool isLongPlan = planSide == "LONG"
float rr1 = planSide != "" and not na(entryPx) and not na(slPx) and not na(tp1) ? f_rr(entryPx, slPx, tp1, isLongPlan) : 0.0
if planSide != "" and rr1 < i_minRR and not na(tp2)
    float rr2 = f_rr(entryPx, slPx, tp2, isLongPlan)
    if rr2 >= i_minRR
        tp1 := tp2
        tp1Why := tp1Why + " (TP2→TP1: min R:R)"
        rr1 := rr2
        tp2 := isLongPlan ? f_nearest_above(tp1, minGap, tp1) : f_nearest_below(tp1, minGap, tp1)

float htfCl = request.security(syminfo.tickerid, "60", close, lookahead=barmerge.lookahead_off)
float htfEma = request.security(syminfo.tickerid, "60", ta.ema(close, 20), lookahead=barmerge.lookahead_off)
float ltfCl = request.security(syminfo.tickerid, "15", close, lookahead=barmerge.lookahead_off)
float ltfEma = request.security(syminfo.tickerid, "15", ta.ema(close, 20), lookahead=barmerge.lookahead_off)
string htfRu = htfCl > htfEma * 1.001 ? "60m ↑" : htfCl < htfEma * 0.999 ? "60m ↓" : "60m →"
string ltfRu = ltfCl > ltfEma * 1.001 ? "15m ↑" : ltfCl < ltfEma * 0.999 ? "15m ↓" : "15m →"
bool mtfBlock = false
if i_mtf and planSide == "LONG" and htfCl < htfEma * 0.998
    mtfBlock := true
if i_mtf and planSide == "SHORT" and htfCl > htfEma * 1.002
    mtfBlock := true
if i_mtf and isHtf and planSide == "LONG" and ltfCl < ltfEma * 0.998
    mtfBlock := true
if i_mtf and isHtf and planSide == "SHORT" and ltfCl > ltfEma * 1.002
    mtfBlock := true
string mtfRu = htfRu + " · " + ltfRu + (mtfBlock ? " · конфликт" : "")

bool rewardOk = planSide == "LONG" ? tp1 > entryPx + syminfo.mintick : planSide == "SHORT" ? tp1 < entryPx - syminfo.mintick : false
bool planOk = planSide != "" and rewardOk and rr1 >= i_minRR and not mtfBlock
string edgeRu = planOk ? "R:R " + str.tostring(rr1, "#.2") + " · вход @ " + str.tostring(entryPx, format.mintick) : planSide != "" and mtfBlock ? "MTF конфликт — без SL/TP" : planSide != "" ? "нет edge (R:R " + str.tostring(rr1, "#.2") + " < " + str.tostring(i_minRR, "#.2") + ")" : "сценарий без сделки"
bool showPlan = i_boxes and planOk

string figRu = wedgeOk ? wedgeRu : wedgeGeom ? wedgeRu : patRu != "" ? patRu : "фигура не выделена"
if wedgeOk and patRu != "" and patKind != "one_two_three"
    figRu := wedgeRu + " · " + patRu

color actCol = act == "LONG" ? colG : act == "SHORT" ? colR : colY

// ── drawings ──
var line lnCeil = na
var line lnFloor = na
var line lnCtxHi = na
var line lnCtxLo = na
var line lnPat2 = na
var line lnNeck2 = na
var line lnWh = na
var line lnWl = na
var line lnNeck = na
var line lnP12 = na
var line lnP23 = na
var line lnHsN = na
var line lnF0 = na
var line lnF236 = na
var line lnF382 = na
var line lnF50 = na
var line lnF618 = na
var line lnF786 = na
var line lnF100 = na
var line lnF127 = na
var line lnBos = na
var line lnSweep = na
var line lnP0 = na
var line lnP1 = na
var line lnP2 = na
var line lnP3 = na
var box  bxSup = na
var box  bxFvg = na
var box  bxOb = na
var box  bxFib = na
var box  bxFibSell = na
var box  bxSL = na
var box  bxEN = na
var box  bxTP = na
var box  bxTP2 = na
var label lbCeil = na
var label lbFloor = na
var label lbWedge = na
var label lbPat = na
var label lbF0 = na
var label lbF382 = na
var label lbF50 = na
var label lbF618 = na
var label lbF786 = na
var label lbF100 = na
var label lbFvg = na
var label lbOb = na
var label lbBos = na
var label lbSweep = na
var label lbPath = na
var label lbSL = na
var label lbTP1 = na
var table plan = table.new(position.bottom_left, 2, 19, bgcolor=color.new(colBg, 6), border_width=1, border_color=#30363d)

f_kill_line(line ln) =>
    if not na(ln)
        line.delete(ln)

f_kill_box(box bx) =>
    if not na(bx)
        box.delete(bx)

f_kill_lab(label lb) =>
    if not na(lb)
        label.delete(lb)

if barstate.islast
    f_kill_line(lnCeil)
    f_kill_line(lnFloor)
    f_kill_line(lnCtxHi)
    f_kill_line(lnCtxLo)
    f_kill_line(lnPat2)
    f_kill_line(lnNeck2)
    f_kill_line(lnWh)
    f_kill_line(lnWl)
    f_kill_line(lnNeck)
    f_kill_line(lnP12)
    f_kill_line(lnP23)
    f_kill_line(lnHsN)
    f_kill_line(lnF0)
    f_kill_line(lnF236)
    f_kill_line(lnF382)
    f_kill_line(lnF50)
    f_kill_line(lnF618)
    f_kill_line(lnF786)
    f_kill_line(lnF100)
    f_kill_line(lnF127)
    f_kill_line(lnBos)
    f_kill_line(lnSweep)
    f_kill_line(lnP0)
    f_kill_line(lnP1)
    f_kill_line(lnP2)
    f_kill_line(lnP3)
    f_kill_box(bxSup)
    f_kill_box(bxFvg)
    f_kill_box(bxOb)
    f_kill_box(bxFib)
    f_kill_box(bxFibSell)
    f_kill_box(bxSL)
    f_kill_box(bxEN)
    f_kill_box(bxTP)
    f_kill_box(bxTP2)
    f_kill_lab(lbCeil)
    f_kill_lab(lbFloor)
    f_kill_lab(lbWedge)
    f_kill_lab(lbPat)
    f_kill_lab(lbF0)
    f_kill_lab(lbF382)
    f_kill_lab(lbF50)
    f_kill_lab(lbF618)
    f_kill_lab(lbF786)
    f_kill_lab(lbF100)
    f_kill_lab(lbFvg)
    f_kill_lab(lbOb)
    f_kill_lab(lbBos)
    f_kill_lab(lbSweep)
    f_kill_lab(lbPath)
    f_kill_lab(lbSL)
    f_kill_lab(lbTP1)
    lnCeil := na
    lnFloor := na
    lnCtxHi := na
    lnCtxLo := na
    lnPat2 := na
    lnNeck2 := na
    lnWh := na
    lnWl := na
    lnNeck := na
    lnP12 := na
    lnP23 := na
    lnHsN := na
    lnF0 := na
    lnF236 := na
    lnF382 := na
    lnF50 := na
    lnF618 := na
    lnF786 := na
    lnF100 := na
    lnF127 := na
    lnBos := na
    lnSweep := na
    lnP0 := na
    lnP1 := na
    lnP2 := na
    lnP3 := na
    bxSup := na
    bxFvg := na
    bxOb := na
    bxFib := na
    bxFibSell := na
    bxSL := na
    bxEN := na
    bxTP := na
    bxTP2 := na
    lbCeil := na
    lbFloor := na
    lbWedge := na
    lbPat := na
    lbF0 := na
    lbF382 := na
    lbF50 := na
    lbF618 := na
    lbF786 := na
    lbF100 := na
    lbFvg := na
    lbOb := na
    lbBos := na
    lbSweep := na
    lbPath := na
    lbSL := na
    lbTP1 := na

    int xL = xL0
    int xC = xR

    // 1) S/R — структура (свинги) + опционально контекст LB
    if i_sr
        lnCeil := line.new(xL, structRes, xC, structRes, color=colY, width=i_wSR, extend=extend.none)
        lnFloor := line.new(xL, structSup, xC, structSup, color=colB, width=i_wSR, extend=extend.none)
        lbCeil := label.new(xL + 2, structRes, "Сопр. " + str.tostring(structRes, format.mintick) + " · L если close >", style=label.style_label_right, color=color.new(colBg, 15), textcolor=colY, size=size.small)
        lbFloor := label.new(xL + 2, structSup, "Подд. " + str.tostring(structSup, format.mintick) + " · S если close <", style=label.style_label_right, color=color.new(colBg, 15), textcolor=colB, size=size.small)
        if i_ctxRng and (math.abs(rngHi - structRes) > atr * 0.15 or math.abs(rngLo - structSup) > atr * 0.15)
            lnCtxHi := line.new(xL, rngHi, xC, rngHi, color=color.new(colY, 55), width=1, style=line.style_dotted, extend=extend.none)
            lnCtxLo := line.new(xL, rngLo, xC, rngLo, color=color.new(colB, 55), width=1, style=line.style_dotted, extend=extend.none)
        if i_zone
            float zH = structSup + math.max(atr * 0.45, structW * 0.06)
            bxSup := box.new(xL, zH, xC, structSup, bgcolor=color.new(colG, 78), border_color=colG, border_width=1)

    // 3) клин / канал — сплошной если касания OK, иначе пунктир «черновик»
    if i_wedge and wedgeGeom
        int xW0 = math.min(wHx0, wLx0)
        float yH0 = f_y(wHy0, wHx0, wHy1, wHx1, xW0)
        float yH1 = f_y(wHy0, wHx0, wHy1, wHx1, xC)
        float yL0 = f_y(wLy0, wLx0, wLy1, wLx1, xW0)
        float yL1 = f_y(wLy0, wLx0, wLy1, wLx1, xC)
        color wCol = wedgeOk ? colW : color.new(colMuted, 35)
        int wW = wedgeOk ? i_wWedge : math.max(1, i_wWedge - 1)
        lnWh := line.new(xW0, yH0, xC, yH1, color=wCol, width=wW, style=wedgeOk ? line.style_solid : line.style_dashed, extend=extend.none)
        lnWl := line.new(xW0, yL0, xC, yL1, color=wCol, width=wW, style=wedgeOk ? line.style_solid : line.style_dashed, extend=extend.none)
        lbWedge := label.new(xC - 1, (yH1 + yL1) * 0.5, wedgeRu, style=label.style_label_left, color=color.new(colBg, 20), textcolor=wCol, size=size.normal)

    // 4) pattern geometry (не дублируем △, если уже клин)
    bool drawPat = i_pat and patKind != "" and patConf >= i_minConf
    bool isHs = patKind == "head_shoulders" or patKind == "inverse_head_shoulders"
    bool isDbl = patKind == "double_top" or patKind == "double_bottom"
    if drawPat and isDbl and not na(pI1) and not na(pI2) and not na(patNeck)
        lnP12 := line.new(pI1, pP1, pI2, pP2, color=colY, width=i_wPat, extend=extend.none)
        lnNeck := line.new(math.min(pI1, pI2), patNeck, xC, patNeck, color=colB, width=i_wPat, extend=extend.none)
        string dN = patKind == "double_top" ? "2× вершина · шея" : "2× дно · шея"
        lbPat := label.new(pI2, pP2, dN + (patSt == "confirmed" ? " ✓" : " …"), style=label.style_label_down, color=color.new(colBg, 20), textcolor=colY, size=size.small)
    else if drawPat and isHs and not na(pNLx)
        lnP12 := line.new(pI1, pP1, pI2, pP2, color=colO, width=i_wPat, extend=extend.none)
        lnP23 := line.new(pI2, pP2, pI3, pP3, color=colO, width=i_wPat, extend=extend.none)
        lnHsN := line.new(pNLx, pNL, pNRx, pNR, color=colB, width=i_wPat, extend=extend.none)
        lbPat := label.new(pI2, pP2, patRu + (patSt == "confirmed" ? " ✓" : " …"), style=label.style_label_down, color=color.new(colBg, 20), textcolor=colO, size=size.small)
    else if drawPat and patKind == "one_two_three" and not na(pI1)
        lnP12 := line.new(pI1, pP1, pI2, pP2, color=colW, width=i_wPat, extend=extend.none)
        if not na(pI3)
            lnP23 := line.new(pI2, pP2, pI3, pP3, color=colW, width=1, extend=extend.none)
        if not na(patNeck)
            lnNeck := line.new(pI1, patNeck, xC, patNeck, color=colB, width=2, extend=extend.none)
        lbPat := label.new(pI2, pP2, "1-2-3 " + (patDir == "bullish" ? "↑" : "↓") + " · шея " + str.tostring(patNeck, format.mintick), style=label.style_label_down, color=color.new(colBg, 20), textcolor=colY, size=size.small)

    bool drawPat2 = i_pat and i_histPat and patKind2 != "" and patKind2 != patKind and (patKind2 == "double_top" or patKind2 == "double_bottom")
    if drawPat2 and not na(p2I1) and not na(p2I2) and not na(patNeck2)
        lnPat2 := line.new(p2I1, p2P1, p2I2, p2P2, color=color.new(colMuted, 25), width=1, extend=extend.none)
        lnNeck2 := line.new(math.min(p2I1, p2I2), patNeck2, xC, patNeck2, color=color.new(colB, 45), width=1, style=line.style_dashed, extend=extend.none)

    // 5) Fib grid — от ноги импульса, не «висящие» линии
    if i_fib and (impHi - impLo) > atr * 0.4
        int xf0 = math.max(xL, xFib0)
        lnF0   := line.new(xf0, f0,   xC, f0,   color=color.new(colW, 35), width=i_wFib, style=line.style_solid, extend=extend.none)
        lnF236 := line.new(xf0, f236, xC, f236, color=color.new(colMuted, 45), width=i_wFib, style=line.style_dotted, extend=extend.none)
        lnF382 := line.new(xf0, f382, xC, f382, color=color.new(colMuted, 15), width=i_wFib, style=line.style_dotted, extend=extend.none)
        lnF50  := line.new(xf0, f50,  xC, f50,  color=color.new(colP, 10), width=i_wFib, style=line.style_dashed, extend=extend.none)
        lnF618 := line.new(xf0, f618, xC, f618, color=color.new(colP, 0), width=math.max(i_wFib, 2), style=line.style_dashed, extend=extend.none)
        lnF786 := line.new(xf0, f786, xC, f786, color=color.new(colO, 0), width=math.max(i_wFib, 2), style=line.style_dashed, extend=extend.none)
        lnF100 := line.new(xf0, f100, xC, f100, color=color.new(colW, 35), width=i_wFib, style=line.style_solid, extend=extend.none)
        lnF127 := line.new(xf0, f127, xC, f127, color=color.new(colG, 40), width=i_wFib, style=line.style_dotted, extend=extend.none)
        bxFib := box.new(xf0, math.max(f50, f618), xC, math.min(f50, f618), bgcolor=color.new(colP, 90), border_color=color.new(colP, 70), border_width=1)
        bxFibSell := box.new(xf0, math.max(f786, f886), xC, math.min(f786, f886), bgcolor=color.new(colO, 92), border_color=color.new(colO, 75), border_width=1)
        lbF0   := label.new(xC, f0,   "Fib 0 · начало ноги", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colW, size=size.tiny)
        lbF382 := label.new(xC, f382, "38.2", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colMuted, size=size.tiny)
        lbF50  := label.new(xC, f50,  "50 · золотая", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colP, size=size.tiny)
        lbF618 := label.new(xC, f618, "61.8 · золотая", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colP, size=size.tiny)
        lbF786 := label.new(xC, f786, "78.6 · сильная", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colO, size=size.tiny)
        lbF100 := label.new(xC, f100, "100 · конец ноги", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colW, size=size.tiny)

    // 6) SMC — только если поддерживает «главную идею»
    if effSmcAny
        if showSmcFvg and not na(fvgBar)
            int xF0 = fvgBar - 2
            bxFvg := box.new(xF0, fvgTop, xC, fvgBot, bgcolor=color.new(fvgBull ? colG : colR, 86), border_color=fvgBull ? colG : colR, border_width=1)
            lbFvg := label.new(fvgBar, (fvgTop + fvgBot) * 0.5, fvgBull ? "FVG demand · retest" : "FVG supply · retest", style=label.style_label_left, color=color.new(colBg, 25), textcolor=fvgBull ? colG : colR, size=size.tiny)
        if showSmcBos and (bosUp or bosDn)
            float bPx = bosUp ? structRes : structSup
            lnBos := line.new(xNow - 24, bPx, xC, bPx, color=bosUp ? colG : colR, width=1, style=line.style_dashed, extend=extend.none)
            lbBos := label.new(xNow - 20, bPx, bosUp ? "BOS ↑" : "BOS ↓", style=label.style_label_right, color=color.new(color.black, 100), textcolor=bosUp ? colG : colR, size=size.tiny)
        if showSmcSweep and sweepHiAct and not na(sweepBearBar)
            lnSweep := line.new(sweepBearBar, sweepBearLvl, xC, sweepBearLvl, color=colY, width=1, style=line.style_dotted, extend=extend.none)
            lbSweep := label.new(sweepBearBar, sweepBearY, "свип ↑ · " + str.tostring(sweepBearLvl, format.mintick), style=label.style_label_down, color=color.new(colY, 10), textcolor=colBg, size=size.small)
        else if showSmcSweep and sweepLoAct and not na(sweepBullBar)
            lnSweep := line.new(sweepBullBar, sweepBullLvl, xC, sweepBullLvl, color=colY, width=1, style=line.style_dotted, extend=extend.none)
            lbSweep := label.new(sweepBullBar, sweepBullY, "свип ↓ · " + str.tostring(sweepBullLvl, format.mintick), style=label.style_label_up, color=color.new(colY, 10), textcolor=colBg, size=size.small)

    // прогноз хода (как учебный зигзаг, но по счёту RSI/структуры)
    if effPath and pathDir != "chop" and not na(tp1)
        int xa = xNow
        int xb = xNow + 5
        int xc = xNow + 12
        int xd = xNow + 20
        int xe = xNow + 28
        if pathDir == "down"
            float yPeek = math.max(close, na(wHiNow) ? high : wHiNow)
            float yBr = na(wLoNow) ? close - atr : wLoNow
            lnP0 := line.new(xa, close, xb, yPeek, color=#e6c56e, width=i_wPath, extend=extend.none)
            lnP1 := line.new(xb, yPeek, xc, yBr, color=#e6c56e, width=i_wPath, extend=extend.none)
            lnP2 := line.new(xc, yBr, xd, tp1, color=#e6c56e, width=i_wPath, extend=extend.none)
            if not na(tp2)
                lnP3 := line.new(xd, tp1, xe, tp2, color=#e6c56e, width=i_wPath, extend=extend.none)
            lbPath := label.new(xe, na(tp2) ? tp1 : tp2, "ожидание ↓", style=label.style_label_left, color=color.new(colBg, 20), textcolor=#e6c56e, size=size.small)
        else
            float yDip = math.min(close, na(wLoNow) ? low : wLoNow)
            float yBrU = na(wHiNow) ? close + atr : wHiNow
            lnP0 := line.new(xa, close, xb, yDip, color=#e6c56e, width=i_wPath, extend=extend.none)
            lnP1 := line.new(xb, yDip, xc, yBrU, color=#e6c56e, width=i_wPath, extend=extend.none)
            lnP2 := line.new(xc, yBrU, xd, tp1, color=#e6c56e, width=i_wPath, extend=extend.none)
            if not na(tp2)
                lnP3 := line.new(xd, tp1, xe, tp2, color=#e6c56e, width=i_wPath, extend=extend.none)
            lbPath := label.new(xe, na(tp2) ? tp1 : tp2, "ожидание ↑", style=label.style_label_left, color=color.new(colBg, 20), textcolor=#e6c56e, size=size.small)

    // SL / TP только при хирургическом edge (R:R + MTF)
    if showPlan and not na(slPx) and not na(tp1) and not na(entryPx)
        int x0 = xNow + 1
        int x1 = xNow + 16
        float band = math.max(atr * 0.12, syminfo.mintick * 8)
        color a = color.new(colR, act == "ЖДАТЬ" ? 82 : 72)
        color g1 = color.new(colG, act == "ЖДАТЬ" ? 84 : 74)
        color g2 = color.new(colG, 88)
        color eN = color.new(colB, 86)
        if planSide == "LONG"
            bxSL := box.new(x0, math.min(entryPx, slPx), x1, slPx, bgcolor=a, border_color=colR)
            bxEN := box.new(x0, entryPx, x1, entryPx + band, bgcolor=eN, border_color=colB)
            bxTP := box.new(x0, entryPx + band, x1, tp1, bgcolor=g1, border_color=colG)
            if not na(tp2) and tp2 > tp1
                bxTP2 := box.new(x0, tp1, x1, tp2, bgcolor=g2, border_color=color.new(colG, 40))
            lbSL := label.new(x1, slPx, "SL " + str.tostring(slPx, format.mintick), style=label.style_label_left, color=color.new(colBg, 25), textcolor=colR, size=size.tiny)
            lbTP1 := label.new(x1, tp1, "TP1 " + str.tostring(tp1, format.mintick) + " · R:R " + str.tostring(rr1, "#.2"), style=label.style_label_left, color=color.new(colBg, 25), textcolor=colG, size=size.tiny)
        else
            bxSL := box.new(x0, slPx, x1, math.max(entryPx, slPx), bgcolor=a, border_color=colR)
            bxEN := box.new(x0, entryPx - band, x1, entryPx, bgcolor=eN, border_color=colB)
            bxTP := box.new(x0, tp1, x1, entryPx - band, bgcolor=g1, border_color=colG)
            if not na(tp2) and tp2 < tp1
                bxTP2 := box.new(x0, tp2, x1, tp1, bgcolor=g2, border_color=color.new(colG, 40))
            lbSL := label.new(x1, slPx, "SL " + str.tostring(slPx, format.mintick), style=label.style_label_left, color=color.new(colBg, 25), textcolor=colR, size=size.tiny)
            lbTP1 := label.new(x1, tp1, "TP1 " + str.tostring(tp1, format.mintick) + " · R:R " + str.tostring(rr1, "#.2"), style=label.style_label_left, color=color.new(colBg, 25), textcolor=colG, size=size.tiny)

    // таблица
    if i_plan
        table.cell(plan, 0, 0, "Разбор Ed", text_color=colB, text_size=size.small)
        table.cell(plan, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color=colW, text_size=size.small)
        table.cell(plan, 0, 1, "Фаза", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 1, phaseRu + " · " + whereRu, text_color=colW, text_size=size.tiny)
        table.cell(plan, 0, 2, "Фигура", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 2, figRu + (patSt == "confirmed" ? " ✓" : patSt == "forming" ? " …" : ""), text_color=colY, text_size=size.tiny)
        table.cell(plan, 0, 3, "Главная идея", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 3, ideaRu, text_color=priRank <= 4 ? colW : colMuted, text_size=size.tiny)
        table.cell(plan, 0, 4, "Свип", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 4, sweepRu, text_color=sweepHiAct or sweepLoAct ? colO : colMuted, text_size=size.tiny)
        table.cell(plan, 0, 5, "RSI", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 5, rsiRu, text_color=rsiOB or rsiOS ? colO : colW, text_size=size.tiny)
        table.cell(plan, 0, 6, "Тренд", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 6, trendStrRu, text_color=adxVal >= 26 ? colG : adxVal >= 18 ? colY : colMuted, text_size=size.tiny)
        table.cell(plan, 0, 7, "MTF", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 7, mtfRu, text_color=mtfBlock ? colO : colW, text_size=size.tiny)
        table.cell(plan, 0, 8, "ХОД", text_color=colMuted, text_size=size.small)
        table.cell(plan, 1, 8, pathRu, text_color=pathDir == "down" ? colR : pathDir == "up" ? colG : colY, text_size=size.small)
        table.cell(plan, 0, 9, "Уверенность", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 9, confRu + " · " + voteRu, text_color=pathMag >= 4 ? colG : colY, text_size=size.tiny)
        table.cell(plan, 0, 10, "Свинг " + str.tostring(i_swing), text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 10, stabRu, text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 0, 11, "ДЕЙСТВИЕ", text_color=colMuted, text_size=size.small)
        table.cell(plan, 1, 11, act, text_color=actCol, text_size=size.normal)
        table.cell(plan, 0, 12, "Почему", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 12, why, text_color=colW, text_size=size.tiny)
        table.cell(plan, 0, 13, "Триггеры", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 13, "L close> " + str.tostring(longPx, format.mintick) + " · S close< " + str.tostring(shortPx, format.mintick), text_color=colW, text_size=size.tiny)
        table.cell(plan, 0, 14, "Edge", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 14, edgeRu, text_color=planOk ? colG : colY, text_size=size.tiny)
        table.cell(plan, 0, 15, "SL", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 15, showPlan and not na(slPx) ? str.tostring(slPx, format.mintick) + " · " + slWhy : "—", text_color=colR, text_size=size.tiny)
        table.cell(plan, 0, 16, "TP1 / TP2", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 16, showPlan ? (str.tostring(tp1, format.mintick) + " / " + (na(tp2) ? "—" : str.tostring(tp2, format.mintick)) + " · " + tp1Why) : "—", text_color=colG, text_size=size.tiny)
        table.cell(plan, 0, 17, "Контекст LB", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 17, str.tostring(posRctx * 100, "#.0") + "% диапазона · " + str.tostring(rngLo, format.mintick) + "–" + str.tostring(rngHi, format.mintick), text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 0, 18, "Легенда", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 18, "v3.6 · идея 1-6 · клин пунктир=мало касаний", text_color=colMuted, text_size=size.tiny)
    else
        table.clear(plan, 0, 0, 1, 18)

alertcondition(act == "LONG", "EdBot LONG", "EdBot: LONG trigger")
alertcondition(act == "SHORT", "EdBot SHORT", "EdBot: SHORT trigger")
