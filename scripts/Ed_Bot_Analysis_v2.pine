//@version=6
// EdBot v3 — разметка как у Ed (docs + нефть). НЕ EdStory. Стратегия: Ed_Bot_Strategy_v1.pine
indicator("Ed Bot Analysis v3.0", shorttitle="EdBot", overlay=true, max_boxes_count=24, max_lines_count=40, max_labels_count=40)

// ═══════════════════════════════════════════════════════════
//  Каждая галочка РИСУЕТ свой слой. Нет скрытых блокировок.
// ═══════════════════════════════════════════════════════════
grp = "На графике (галочка = слой)"
i_sr      = input.bool(true,  "1. Сопр. / Подд. диапазона", group=grp, tooltip="Жёлтый потолок и синий пол lookback. Подписи с ценой.")
i_zone    = input.bool(true,  "2. Зелёная зона у поддержки", group=grp, tooltip="Как на разборе нефти.")
i_wedge   = input.bool(true,  "3. Клин / треугольник (2 белые линии)", group=grp, tooltip="По первым и последним свингам lookback — крупная фигура, не короткий отрезок.")
i_pat     = input.bool(true,  "4. Графический паттерн (2× / ГиП / 1-2-3)", group=grp)
i_fib     = input.bool(true,  "5. Fib 38.2 / 50 / 61.8 / 78.6", group=grp, tooltip="Откат последнего импульса. Каждая линия подписана.")
i_smc     = input.bool(true,  "6. SMC: FVG + OB + BOS + свип", group=grp, tooltip="Только последний объект каждого типа, с подписью.")
i_plan    = input.bool(true,  "7. Разбор + действие (таблица слева внизу)", group=grp)
i_boxes   = input.bool(true,  "8. Боксы SL / вход / TP (только если не ЖДАТЬ)", group=grp)

grpP = "Параметры"
i_lb      = input.int(90, "Lookback разметки (баров)", minval=40, maxval=200, group=grpP, tooltip="Размер клина и диапазона. 90 ≈ как ручной разбор на 15m.")
i_swing   = input.int(3, "Окно свинга", minval=2, maxval=5, group=grpP)
i_minConf = input.float(0.55, "MIN confidence фигуры", minval=0.50, maxval=0.80, step=0.01, group=grpP)
i_dtol    = input.float(0.55, "Допуск 2× вершины %", minval=0.2, maxval=1.5, step=0.05, group=grpP)
i_hstol   = input.float(2.2, "Допуск плеч ГиП %", minval=1.0, maxval=4.0, step=0.1, group=grpP)

// ── helpers ──
float atr = ta.atr(14)
f_pct(float a, float b) => math.abs(a - b) / math.max(math.abs(a), 1e-10) * 100.0
f_y(float y1, int x1, float y2, int x2, int x) =>
    y1 + (y2 - y1) * (x - x1) / math.max(x2 - x1, 1)
f_fib(float top, float bot, float r) => top - (top - bot) * r

colW = #e6edf3
colY = #f0c040
colB = #58a6ff
colG = #3fb950
colR = #f85149
colO = #f0883e
colP = #a371f7
colMuted = #8b949e
colBg = #161b22

// ── swings ──
int SW = 18
var float[] shP = array.new_float()
var int[]   shX = array.new_int()
var float[] slP = array.new_float()
var int[]   slX = array.new_int()
float ph = ta.pivothigh(high, i_swing, i_swing)
float pl = ta.pivotlow(low, i_swing, i_swing)
if not na(ph)
    array.push(shP, ph)
    array.push(shX, bar_index - i_swing)
    while array.size(shP) > SW
        array.shift(shP)
        array.shift(shX)
if not na(pl)
    array.push(slP, pl)
    array.push(slX, bar_index - i_swing)
    while array.size(slP) > SW
        array.shift(slP)
        array.shift(slX)

int xNow = bar_index
int xL0  = math.max(0, xNow - i_lb)
int xR   = xNow + 10

f_first_hi_in(int fromX) =>
    int ix = na
    float px = na
    if array.size(shX) > 0
        for i = 0 to array.size(shX) - 1
            int xx = array.get(shX, i)
            if xx >= fromX and na(ix)
                ix := xx
                px := array.get(shP, i)
    [ix, px]

f_last_hi() =>
    int n = array.size(shX)
    int ix = n > 0 ? array.get(shX, n - 1) : na
    float px = n > 0 ? array.get(shP, n - 1) : na
    [ix, px]

f_first_lo_in(int fromX) =>
    int ix = na
    float px = na
    if array.size(slX) > 0
        for i = 0 to array.size(slX) - 1
            int xx = array.get(slX, i)
            if xx >= fromX and na(ix)
                ix := xx
                px := array.get(slP, i)
    [ix, px]

f_last_lo() =>
    int n = array.size(slX)
    int ix = n > 0 ? array.get(slX, n - 1) : na
    float px = n > 0 ? array.get(slP, n - 1) : na
    [ix, px]

// ── range ──
float rngHi = ta.highest(high, i_lb)
float rngLo = ta.lowest(low, i_lb)
float rngW  = rngHi - rngLo
float posR  = rngW > 0 ? (close - rngLo) / rngW : 0.5
bool  inMid = posR > 0.32 and posR < 0.68

// ── impulse + fib ──
int fibLb = math.min(i_lb, 64)
float impHi = ta.highest(high, fibLb)
float impLo = ta.lowest(low, fibLb)
int hiAgo = int(-ta.highestbars(high, fibLb))
int loAgo = int(-ta.lowestbars(low, fibLb))
bool impUp = loAgo > hiAgo
float f382 = f_fib(impHi, impLo, 0.382)
float f50  = f_fib(impHi, impLo, 0.500)
float f618 = f_fib(impHi, impLo, 0.618)
float f786 = f_fib(impHi, impLo, 0.786)
float f886 = f_fib(impHi, impLo, 0.886)

// ── SMC lite ──
bool fvgUp = low > high[2]
bool fvgDn = high < low[2]
bool sweepHi = array.size(shP) > 0 and high[1] > array.get(shP, array.size(shP) - 1) * 1.0004 and close < array.get(shP, array.size(shP) - 1)
bool sweepLo = array.size(slP) > 0 and low[1] < array.get(slP, array.size(slP) - 1) * 0.9996 and close > array.get(slP, array.size(slP) - 1)
bool bosUp = array.size(shP) > 0 and close > array.get(shP, array.size(shP) - 1)
bool bosDn = array.size(slP) > 0 and close < array.get(slP, array.size(slP) - 1)
bool obBull = close > ta.highest(high, 12)[1] and close > open and volume > ta.sma(volume, 20) * 1.15
bool obBear = close < ta.lowest(low, 12)[1] and close < open and volume > ta.sma(volume, 20) * 1.15

// ── pattern scan (last bar) ──
var string patKind = ""
var string patSt   = ""
var string patDir  = ""
var float  patConf = 0.0
var float  patNeck = na
var float  patTgt  = na
var float  patStp  = na
var int    pI1 = na
var int    pI2 = na
var int    pI3 = na
var float  pP1 = na
var float  pP2 = na
var float  pP3 = na
var float  pNL = na
var float  pNR = na
var int    pNLx = na
var int    pNRx = na

if barstate.islast
    string cK = ""
    string cS = ""
    string cD = ""
    float  cC = 0.0
    float  cN = na
    float  cT = na
    float  cSp = na
    int    i1 = na
    int    i2 = na
    int    i3 = na
    float  y1 = na
    float  y2 = na
    float  y3 = na
    float  nL = na
    float  nR = na
    int    nLx = na
    int    nRx = na
    float  best = 0.0

    // double top
    if array.size(shP) >= 2
        for i = math.max(0, array.size(shP) - 6) to array.size(shP) - 2
            float a = array.get(shP, i)
            float b = array.get(shP, i + 1)
            int xa = array.get(shX, i)
            int xb = array.get(shX, i + 1)
            if xb - xa < 6 or xb - xa > 50 or f_pct(a, b) > i_dtol
                continue
            float neck = na
            if array.size(slP) > 0
                for j = 0 to array.size(slP) - 1
                    int lx = array.get(slX, j)
                    if lx > xa and lx < xb
                        neck := na(neck) ? array.get(slP, j) : math.min(neck, array.get(slP, j))
            if na(neck)
                continue
            float h = math.max(a, b) - neck
            if h < atr * 0.7
                continue
            string st = close < neck ? "confirmed" : "forming"
            float conf = 0.58 + (f_pct(a, b) < 0.35 ? 0.12 : 0.0) + (st == "confirmed" ? 0.14 : 0.04)
            if conf >= i_minConf and conf >= best
                best := conf
                cK := "double_top"
                cS := st
                cD := "bearish"
                cC := conf
                cN := neck
                cT := neck - h
                cSp := math.max(a, b) + atr * 0.2
                i1 := xa
                i2 := xb
                y1 := a
                y2 := b

    // double bottom
    if array.size(slP) >= 2
        for i = math.max(0, array.size(slP) - 6) to array.size(slP) - 2
            float a = array.get(slP, i)
            float b = array.get(slP, i + 1)
            int xa = array.get(slX, i)
            int xb = array.get(slX, i + 1)
            if xb - xa < 6 or xb - xa > 50 or f_pct(a, b) > i_dtol
                continue
            float neck = na
            if array.size(shP) > 0
                for j = 0 to array.size(shP) - 1
                    int hx = array.get(shX, j)
                    if hx > xa and hx < xb
                        neck := na(neck) ? array.get(shP, j) : math.max(neck, array.get(shP, j))
            if na(neck)
                continue
            float h = neck - math.min(a, b)
            if h < atr * 0.7
                continue
            string st = close > neck ? "confirmed" : "forming"
            float conf = 0.58 + (f_pct(a, b) < 0.35 ? 0.12 : 0.0) + (st == "confirmed" ? 0.14 : 0.04)
            if conf >= i_minConf and conf >= best
                best := conf
                cK := "double_bottom"
                cS := st
                cD := "bullish"
                cC := conf
                cN := neck
                cT := neck + h
                cSp := math.min(a, b) - atr * 0.2
                i1 := xa
                i2 := xb
                y1 := a
                y2 := b

    // H&S
    if array.size(shP) >= 3
        int i = array.size(shP) - 3
        float ls = array.get(shP, i)
        float hd = array.get(shP, i + 1)
        float rs = array.get(shP, i + 2)
        int xs = array.get(shX, i)
        int xh = array.get(shX, i + 1)
        int xr = array.get(shX, i + 2)
        if ls < hd and hd > rs and f_pct(ls, rs) <= i_hstol
            float nl = na
            float nr = na
            int nli = xs
            int nri = xr
            if array.size(slP) > 0
                for j = 0 to array.size(slP) - 1
                    int lx = array.get(slX, j)
                    float lp = array.get(slP, j)
                    if lx > xs and lx < xh
                        nl := na(nl) ? lp : math.min(nl, lp)
                        nli := lx
                    if lx > xh and lx < xr
                        nr := na(nr) ? lp : math.min(nr, lp)
                        nri := lx
            if not na(nl) and not na(nr)
                float neck = f_y(nl, nli, nr, nri, xr)
                float h = hd - neck
                if h >= atr
                    string st = close < neck ? "confirmed" : "forming"
                    float conf = 0.62 + (st == "confirmed" ? 0.14 : 0.04)
                    if conf >= i_minConf and conf >= best
                        best := conf
                        cK := "head_shoulders"
                        cS := st
                        cD := "bearish"
                        cC := conf
                        cN := neck
                        cT := neck - h
                        cSp := hd + atr * 0.15
                        i1 := xs
                        i2 := xh
                        i3 := xr
                        y1 := ls
                        y2 := hd
                        y3 := rs
                        nL := nl
                        nR := nr
                        nLx := nli
                        nRx := nri

    // inverse H&S
    if array.size(slP) >= 3
        int i = array.size(slP) - 3
        float ls = array.get(slP, i)
        float hd = array.get(slP, i + 1)
        float rs = array.get(slP, i + 2)
        int xs = array.get(slX, i)
        int xh = array.get(slX, i + 1)
        int xr = array.get(slX, i + 2)
        if ls > hd and hd < rs and f_pct(ls, rs) <= i_hstol
            float nl = na
            float nr = na
            int nli = xs
            int nri = xr
            if array.size(shP) > 0
                for j = 0 to array.size(shP) - 1
                    int hx = array.get(shX, j)
                    float hp = array.get(shP, j)
                    if hx > xs and hx < xh
                        nl := na(nl) ? hp : math.max(nl, hp)
                        nli := hx
                    if hx > xh and hx < xr
                        nr := na(nr) ? hp : math.max(nr, hp)
                        nri := hx
            if not na(nl) and not na(nr)
                float neck = f_y(nl, nli, nr, nri, xr)
                float h = neck - hd
                if h >= atr
                    string st = close > neck ? "confirmed" : "forming"
                    float conf = 0.62 + (st == "confirmed" ? 0.14 : 0.04)
                    if conf >= i_minConf and conf >= best
                        best := conf
                        cK := "inverse_head_shoulders"
                        cS := st
                        cD := "bullish"
                        cC := conf
                        cN := neck
                        cT := neck + h
                        cSp := hd - atr * 0.15
                        i1 := xs
                        i2 := xh
                        i3 := xr
                        y1 := ls
                        y2 := hd
                        y3 := rs
                        nL := nl
                        nR := nr
                        nLx := nli
                        nRx := nri

    // 1-2-3 bear (HH then LH then break of HL)
    if array.size(shP) >= 2 and array.size(slP) >= 2
        float h1 = array.get(shP, array.size(shP) - 2)
        float h2 = array.get(shP, array.size(shP) - 1)
        float l1 = array.get(slP, array.size(slP) - 2)
        float l2 = array.get(slP, array.size(slP) - 1)
        int xh1 = array.get(shX, array.size(shP) - 2)
        int xh2 = array.get(shX, array.size(shP) - 1)
        int xl2 = array.get(slX, array.size(slP) - 1)
        if h2 < h1 and l2 < l1 and xh2 > xh1
            string st = close < l2 ? "confirmed" : "forming"
            float conf = 0.56 + (st == "confirmed" ? 0.14 : 0.04)
            if conf >= i_minConf and conf >= best
                best := conf
                cK := "one_two_three"
                cS := st
                cD := "bearish"
                cC := conf
                cN := l2
                cT := l2 - (h2 - l2)
                cSp := h2 + atr * 0.2
                i1 := xh1
                i2 := xh2
                i3 := xl2
                y1 := h1
                y2 := h2
                y3 := l2

    // 1-2-3 bull
    if array.size(slP) >= 2 and array.size(shP) >= 2
        float l1 = array.get(slP, array.size(slP) - 2)
        float l2 = array.get(slP, array.size(slP) - 1)
        float h1 = array.get(shP, array.size(shP) - 2)
        float h2 = array.get(shP, array.size(shP) - 1)
        int xl1 = array.get(slX, array.size(slP) - 2)
        int xl2 = array.get(slX, array.size(slP) - 1)
        int xh2 = array.get(shX, array.size(shP) - 1)
        if l2 > l1 and h2 > h1 and xl2 > xl1
            string st = close > h2 ? "confirmed" : "forming"
            float conf = 0.56 + (st == "confirmed" ? 0.14 : 0.04)
            if conf >= i_minConf and conf >= best
                best := conf
                cK := "one_two_three"
                cS := st
                cD := "bullish"
                cC := conf
                cN := h2
                cT := h2 + (h2 - l2)
                cSp := l2 - atr * 0.2
                i1 := xl1
                i2 := xl2
                i3 := xh2
                y1 := l1
                y2 := l2
                y3 := h2

    patKind := cK
    patSt := cS
    patDir := cD
    patConf := cC
    patNeck := cN
    patTgt := cT
    patStp := cSp
    pI1 := i1
    pI2 := i2
    pI3 := i3
    pP1 := y1
    pP2 := y2
    pP3 := y3
    pNL := nL
    pNR := nR
    pNLx := nLx
    pNRx := nRx

string patRu = patKind == "double_top" ? "двойная вершина" : patKind == "double_bottom" ? "двойное дно" : patKind == "head_shoulders" ? "голова и плечи" : patKind == "inverse_head_shoulders" ? "перев. ГиП" : patKind == "one_two_three" ? "1-2-3" : ""

// ── wedge geometry (крупный, как ручная нефть) ──
[wHx0, wHy0] = f_first_hi_in(xL0)
[wHx1, wHy1] = f_last_hi()
[wLx0, wLy0] = f_first_lo_in(xL0)
[wLx1, wLy1] = f_last_lo()
bool wedgeOk = i_wedge and not na(wHx0) and not na(wHx1) and not na(wLx0) and not na(wLx1) and wHx1 != wHx0 and wLx1 != wLx0 and (wHx1 - wHx0) >= 12 and (wLx1 - wLx0) >= 12
float wHiNow = wedgeOk ? f_y(wHy0, wHx0, wHy1, wHx1, xNow) : na
float wLoNow = wedgeOk ? f_y(wLy0, wLx0, wLy1, wLx1, xNow) : na
bool hiFall = wedgeOk and wHy1 <= wHy0 * 1.001
bool loRise = wedgeOk and wLy1 >= wLy0 * 0.999
bool hiRise = wedgeOk and wHy1 > wHy0 * 1.001
bool loFall = wedgeOk and wLy1 < wLy0 * 0.999
string wedgeRu = not wedgeOk ? "" : hiFall and loRise ? "сходящийся △" : hiFall and loFall ? "клин ↓" : hiRise and loRise ? "клин ↑" : hiFall ? "нисход. △" : loRise ? "восход. △" : "канал"
bool wedgeBrUp = wedgeOk and close > wHiNow
bool wedgeBrDn = wedgeOk and close < wLoNow

// ── phase + action ──
bool compress = ta.sma(high - low, 10) <= ta.sma(high - low, 28) * 0.60
string phaseRu = compress ? "сжатие / боковик" : close > close[i_lb / 2] ? "импульс вверх" : "импульс вниз"
string whereRu = posR >= 0.72 ? "у потолка" : posR <= 0.28 ? "у пола" : "в середине диапазона"

string act = "ЖДАТЬ"
string why = "между полом и потолком без закрытия за уровень — нет входа"
if wedgeBrUp or (bosUp and close > rngHi)
    act := "LONG"
    why := "закрытие выше верхней границы / потолка"
else if wedgeBrDn or (bosDn and close < rngLo)
    act := "SHORT"
    why := "закрытие ниже нижней границы / пола"
else if patSt == "confirmed" and patDir == "bullish"
    act := "LONG"
    why := patRu + " подтверждён пробоем шеи"
else if patSt == "confirmed" and patDir == "bearish"
    act := "SHORT"
    why := patRu + " подтверждён пробоем шеи"
else if posR >= 0.72 and (sweepHi or patDir == "bearish")
    act := "ЖДАТЬ"
    why := "у сопротивления: шорт только после отбоя / закрытия ниже клина"
else if posR <= 0.28 and (sweepLo or patDir == "bullish")
    act := "ЖДАТЬ"
    why := "у поддержки: лонг только после отбоя / закрытия выше клина"

float longPx  = wedgeOk ? math.max(wHiNow, rngHi) : rngHi
float shortPx = wedgeOk ? math.min(wLoNow, rngLo) : rngLo
if not na(patNeck) and patDir == "bullish"
    longPx := math.max(longPx, patNeck)
if not na(patNeck) and patDir == "bearish"
    shortPx := math.min(shortPx, patNeck)

float slPx = act == "LONG" ? (not na(patStp) ? patStp : rngLo - atr * 0.2) : act == "SHORT" ? (not na(patStp) ? patStp : rngHi + atr * 0.2) : na
float tpPx = act == "LONG" ? (not na(patTgt) ? patTgt : rngHi + rngW * 0.6) : act == "SHORT" ? (not na(patTgt) ? patTgt : rngLo - rngW * 0.6) : na

string figRu = wedgeOk ? wedgeRu : patRu != "" ? patRu : "фигура не выделена"
if wedgeOk and patRu != "" and patKind != "one_two_three"
    figRu := wedgeRu + " · " + patRu

color actCol = act == "LONG" ? colG : act == "SHORT" ? colR : colY

// ── drawings ──
var line lnCeil = na
var line lnFloor = na
var line lnWh = na
var line lnWl = na
var line lnNeck = na
var line lnP12 = na
var line lnP23 = na
var line lnHsN = na
var line lnF382 = na
var line lnF50 = na
var line lnF618 = na
var line lnF786 = na
var line lnBos = na
var box  bxSup = na
var box  bxFvg = na
var box  bxOb = na
var box  bxFib = na
var box  bxSL = na
var box  bxEN = na
var box  bxTP = na
var label lbCeil = na
var label lbFloor = na
var label lbWedge = na
var label lbPat = na
var label lbF382 = na
var label lbF50 = na
var label lbF618 = na
var label lbF786 = na
var label lbFvg = na
var label lbOb = na
var label lbBos = na
var label lbSweep = na
var table plan = table.new(position.bottom_left, 2, 8, bgcolor=color.new(colBg, 6), border_width=1, border_color=#30363d)

f_kill_line(line ln) =>
    if not na(ln)
        line.delete(ln)

f_kill_box(box bx) =>
    if not na(bx)
        box.delete(bx)

f_kill_lab(label lb) =>
    if not na(lb)
        label.delete(lb)

if barstate.islast
    f_kill_line(lnCeil)
    f_kill_line(lnFloor)
    f_kill_line(lnWh)
    f_kill_line(lnWl)
    f_kill_line(lnNeck)
    f_kill_line(lnP12)
    f_kill_line(lnP23)
    f_kill_line(lnHsN)
    f_kill_line(lnF382)
    f_kill_line(lnF50)
    f_kill_line(lnF618)
    f_kill_line(lnF786)
    f_kill_line(lnBos)
    f_kill_box(bxSup)
    f_kill_box(bxFvg)
    f_kill_box(bxOb)
    f_kill_box(bxFib)
    f_kill_box(bxSL)
    f_kill_box(bxEN)
    f_kill_box(bxTP)
    f_kill_lab(lbCeil)
    f_kill_lab(lbFloor)
    f_kill_lab(lbWedge)
    f_kill_lab(lbPat)
    f_kill_lab(lbF382)
    f_kill_lab(lbF50)
    f_kill_lab(lbF618)
    f_kill_lab(lbF786)
    f_kill_lab(lbFvg)
    f_kill_lab(lbOb)
    f_kill_lab(lbBos)
    f_kill_lab(lbSweep)
    lnCeil := na
    lnFloor := na
    lnWh := na
    lnWl := na
    lnNeck := na
    lnP12 := na
    lnP23 := na
    lnHsN := na
    lnF382 := na
    lnF50 := na
    lnF618 := na
    lnF786 := na
    lnBos := na
    bxSup := na
    bxFvg := na
    bxOb := na
    bxFib := na
    bxSL := na
    bxEN := na
    bxTP := na
    lbCeil := na
    lbFloor := na
    lbWedge := na
    lbPat := na
    lbF382 := na
    lbF50 := na
    lbF618 := na
    lbF786 := na
    lbFvg := na
    lbOb := na
    lbBos := na
    lbSweep := na

    int xL = xL0
    int xC = xR

    // 1) S/R
    if i_sr
        lnCeil := line.new(xL, rngHi, xC, rngHi, color=colY, width=2, extend=extend.none)
        lnFloor := line.new(xL, rngLo, xC, rngLo, color=colB, width=2, extend=extend.none)
        lbCeil := label.new(xL + 2, rngHi, "Сопр. " + str.tostring(rngHi, format.mintick) + " · лонг если close >", style=label.style_label_right, color=color.new(colBg, 15), textcolor=colY, size=size.small)
        lbFloor := label.new(xL + 2, rngLo, "Подд. " + str.tostring(rngLo, format.mintick) + " · шорт если close <", style=label.style_label_right, color=color.new(colBg, 15), textcolor=colB, size=size.small)
        if i_zone
            float zH = rngLo + math.max(atr * 0.55, rngW * 0.04)
            bxSup := box.new(xL, zH, xC, rngLo, bgcolor=color.new(colG, 78), border_color=colG, border_width=1)

    // 3) large wedge
    if wedgeOk
        int xW0 = math.min(wHx0, wLx0)
        float yH0 = f_y(wHy0, wHx0, wHy1, wHx1, xW0)
        float yH1 = f_y(wHy0, wHx0, wHy1, wHx1, xC)
        float yL0 = f_y(wLy0, wLx0, wLy1, wLx1, xW0)
        float yL1 = f_y(wLy0, wLx0, wLy1, wLx1, xC)
        lnWh := line.new(xW0, yH0, xC, yH1, color=colW, width=3, extend=extend.none)
        lnWl := line.new(xW0, yL0, xC, yL1, color=colW, width=3, extend=extend.none)
        lbWedge := label.new(xC - 1, (yH1 + yL1) * 0.5, wedgeRu, style=label.style_label_left, color=color.new(colBg, 20), textcolor=colW, size=size.normal)

    // 4) pattern geometry (не дублируем △, если уже клин)
    bool drawPat = i_pat and patKind != "" and patConf >= i_minConf
    bool isHs = patKind == "head_shoulders" or patKind == "inverse_head_shoulders"
    bool isDbl = patKind == "double_top" or patKind == "double_bottom"
    if drawPat and isDbl and not na(pI1) and not na(pI2) and not na(patNeck)
        lnP12 := line.new(pI1, pP1, pI2, pP2, color=colY, width=2, extend=extend.none)
        lnNeck := line.new(math.min(pI1, pI2), patNeck, xC, patNeck, color=colB, width=2, extend=extend.none)
        string dN = patKind == "double_top" ? "2× вершина · шея" : "2× дно · шея"
        lbPat := label.new(pI2, pP2, dN + (patSt == "confirmed" ? " ✓" : " …"), style=label.style_label_down, color=color.new(colBg, 20), textcolor=colY, size=size.small)
    else if drawPat and isHs and not na(pNLx)
        lnP12 := line.new(pI1, pP1, pI2, pP2, color=colO, width=2, extend=extend.none)
        lnP23 := line.new(pI2, pP2, pI3, pP3, color=colO, width=2, extend=extend.none)
        lnHsN := line.new(pNLx, pNL, pNRx, pNR, color=colB, width=2, extend=extend.none)
        lbPat := label.new(pI2, pP2, patRu + (patSt == "confirmed" ? " ✓" : " …"), style=label.style_label_down, color=color.new(colBg, 20), textcolor=colO, size=size.small)
    else if drawPat and patKind == "one_two_three" and not na(pI1)
        lnP12 := line.new(pI1, pP1, pI2, pP2, color=colW, width=1, extend=extend.none)
        if not na(pI3)
            lnP23 := line.new(pI2, pP2, pI3, pP3, color=colW, width=1, extend=extend.none)
        if not na(patNeck)
            lnNeck := line.new(pI1, patNeck, xC, patNeck, color=colB, width=2, extend=extend.none)
        lbPat := label.new(pI2, pP2, "1-2-3 " + (patDir == "bullish" ? "↑" : "↓") + " · шея " + str.tostring(patNeck, format.mintick), style=label.style_label_down, color=color.new(colBg, 20), textcolor=colY, size=size.small)

    // 5) Fib — подписанные уровни, без ∞
    if i_fib and (impHi - impLo) > atr * 0.4
        int xf0 = xNow - fibLb
        lnF382 := line.new(xf0, f382, xC, f382, color=color.new(colMuted, 20), width=1, style=line.style_dotted, extend=extend.none)
        lnF50  := line.new(xf0, f50,  xC, f50,  color=color.new(colP, 15), width=1, style=line.style_dashed, extend=extend.none)
        lnF618 := line.new(xf0, f618, xC, f618, color=color.new(colP, 0), width=2, style=line.style_dashed, extend=extend.none)
        lnF786 := line.new(xf0, f786, xC, f786, color=color.new(colO, 0), width=2, style=line.style_dashed, extend=extend.none)
        bxFib := box.new(xf0, f618, xC, f50, bgcolor=color.new(colP, 90), border_color=color.new(colP, 70), border_width=1)
        lbF382 := label.new(xC, f382, "Fib 38.2", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colMuted, size=size.tiny)
        lbF50  := label.new(xC, f50,  "Fib 50  · золотая зона", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colP, size=size.tiny)
        lbF618 := label.new(xC, f618, "Fib 61.8 · золотая зона", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colP, size=size.tiny)
        lbF786 := label.new(xC, f786, "Fib 78.6 · сильная зона", style=label.style_label_left, color=color.new(color.black, 100), textcolor=colO, size=size.tiny)

    // 6) SMC — последний объект, подписан
    if i_smc
        int fvgI = -1
        for k = 2 to math.min(40, xNow)
            if fvgI < 0
                bool u = low[k] > high[k + 2]
                bool d = high[k] < low[k + 2]
                if u or d
                    fvgI := k
        if fvgI > 0
            bool u = low[fvgI] > high[fvgI + 2]
            float ft = u ? low[fvgI] : low[fvgI + 2]
            float fb = u ? high[fvgI + 2] : high[fvgI]
            bxFvg := box.new(xNow - fvgI - 2, ft, xC, fb, bgcolor=color.new(colB, 84), border_color=colB, border_width=1)
            lbFvg := label.new(xNow - fvgI, (ft + fb) * 0.5, "FVG", style=label.style_label_left, color=color.new(colBg, 25), textcolor=colB, size=size.tiny)
        if obBull
            bxOb := box.new(xNow - 1, high[1], xC, low[1], bgcolor=color.new(colG, 82), border_color=colG)
            lbOb := label.new(xNow - 1, high[1], "OB спрос", style=label.style_label_down, color=color.new(colBg, 25), textcolor=colG, size=size.tiny)
        else if obBear
            bxOb := box.new(xNow - 1, high[1], xC, low[1], bgcolor=color.new(colR, 82), border_color=colR)
            lbOb := label.new(xNow - 1, low[1], "OB предл.", style=label.style_label_up, color=color.new(colBg, 25), textcolor=colR, size=size.tiny)
        if bosUp or bosDn
            float bPx = bosUp ? array.get(shP, array.size(shP) - 1) : array.get(slP, array.size(slP) - 1)
            lnBos := line.new(xNow - 24, bPx, xC, bPx, color=bosUp ? colG : colR, width=1, style=line.style_dashed, extend=extend.none)
            lbBos := label.new(xNow - 20, bPx, bosUp ? "BOS ↑" : "BOS ↓", style=label.style_label_right, color=color.new(color.black, 100), textcolor=bosUp ? colG : colR, size=size.tiny)
        if sweepHi
            lbSweep := label.new(xNow, high[1], "свип ликв. ↑", style=label.style_label_down, color=color.new(colY, 10), textcolor=colBg, size=size.small)
        else if sweepLo
            lbSweep := label.new(xNow, low[1], "свип ликв. ↓", style=label.style_label_up, color=color.new(colY, 10), textcolor=colBg, size=size.small)

    // 8) plan boxes only if not WAIT
    if i_boxes and act != "ЖДАТЬ" and not na(slPx) and not na(tpPx)
        int x0 = xNow + 1
        int x1 = xNow + 12
        if act == "LONG"
            bxSL := box.new(x0, math.min(close, slPx), x1, slPx, bgcolor=color.new(colR, 78), border_color=colR)
            bxEN := box.new(x0, close, x1, longPx, bgcolor=color.new(colY, 82), border_color=colY)
            bxTP := box.new(x0, longPx, x1, tpPx, bgcolor=color.new(colG, 78), border_color=colG)
        else
            bxSL := box.new(x0, slPx, x1, math.max(close, slPx), bgcolor=color.new(colR, 78), border_color=colR)
            bxEN := box.new(x0, shortPx, x1, close, bgcolor=color.new(colY, 82), border_color=colY)
            bxTP := box.new(x0, tpPx, x1, shortPx, bgcolor=color.new(colG, 78), border_color=colG)

    // 7) strategy table — главный ответ
    if i_plan
        table.cell(plan, 0, 0, "Разбор Ed", text_color=colB, text_size=size.small)
        table.cell(plan, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color=colW, text_size=size.small)
        table.cell(plan, 0, 1, "Фаза", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 1, phaseRu + " · цена " + whereRu, text_color=colW, text_size=size.tiny)
        table.cell(plan, 0, 2, "Фигура", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 2, figRu + (patSt != "" ? " (" + (patSt == "confirmed" ? "пробой есть" : "ещё формируется") + ")" : ""), text_color=colY, text_size=size.tiny)
        table.cell(plan, 0, 3, "ДЕЙСТВИЕ", text_color=colMuted, text_size=size.small)
        table.cell(plan, 1, 3, act, text_color=actCol, text_size=size.normal)
        table.cell(plan, 0, 4, "Почему", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 4, why, text_color=colW, text_size=size.tiny)
        table.cell(plan, 0, 5, "Лонг если", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 5, "close > " + str.tostring(longPx, format.mintick), text_color=colG, text_size=size.tiny)
        table.cell(plan, 0, 6, "Шорт если", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 6, "close < " + str.tostring(shortPx, format.mintick), text_color=colR, text_size=size.tiny)
        table.cell(plan, 0, 7, "Легенда", text_color=colMuted, text_size=size.tiny)
        table.cell(plan, 1, 7, "белое=клин · жёлтое=потолок · синее=пол · фиол.=Fib", text_color=colMuted, text_size=size.tiny)
    else
        table.clear(plan, 0, 0, 1, 7)

alertcondition(act == "LONG", "EdBot LONG", "EdBot: LONG trigger")
alertcondition(act == "SHORT", "EdBot SHORT", "EdBot: SHORT trigger")
