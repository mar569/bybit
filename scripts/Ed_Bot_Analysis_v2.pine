    bxFibSell := na
    bxLStop := na
    bxLProfit := na
    bxSStop := na
    bxSProfit := na
    lnLSl := na
    lnLE := na
    lnLT1 := na
    lnLT2 := na
    lnSSl := na
    lnSE := na
    lnST1 := na
    lnST2 := na
    lbLSl := na
    lbLEnt := na
    lbLT1 := na
    lbLT2 := na
    lbSSl := na
