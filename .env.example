# Скопируйте в файл .env рядом с bot/ и заполните значения.
# Имена на русском — основные; латиница (TELEGRAM_TOKEN и т.д.) тоже работает.

# --- Telegram (@BotFather) ---
# ID чата: бот в группе → любое сообщение → getUpdates (см. ниже)
ТЕЛЕГРАМ_ТОКЕН=8860654451:AAFIHr8UTDizJnGC8Nt4PVj9_J7QBxQ4vi8
ТЕЛЕГРАМ_ID_АДМИНА=8100255073
# Пусто = алерты в личку админу
ТЕЛЕГРАМ_ЧАТ_АЛЕРТЫ=-1004454073337
# WATCH, «разбор как у Ed» (RBR/боковик), аномалии — /set deep_analysis off
ТЕЛЕГРАМ_ЧАТ_АНАЛИЗ=-1003912396633
# Скрин + тикер → график с разметкой
ТЕЛЕГРАМ_ЧАТ_РУЧНОЙ_TA= -1004312858676
# Нефть UKOUSD — отдельный канал
ТЕЛЕГРАМ_ЧАТ_НЕФТЬ=-1004484460058

# Узнать chat id: https://api.telegram.org/bot<ТЕЛЕГРАМ_ТОКЕН>/getUpdates → "chat":{"id":-100...}

# --- ИИ (по умолчанию дописывает разбор к сигналам; /set ai_reading off) ---
# Порядок fallback (если ключ есть): gemini,relay,groq
# Только Relay: КЛЮЧ_RELAY=... и ИИ_ПОРЯДОК=relay,gemini,groq
# Gemini (Google): https://aistudio.google.com/apikey
# Groq (запасной, free): https://console.groq.com/keys
# RelayModels (OpenAI-совместимый шлюз, рубли): https://relaymodels.com
КЛЮЧ_GEMINI=
МОДЕЛЬ_GEMINI=gemini-3.6-flash
КЛЮЧ_GROQ=
МОДЕЛЬ_GROQ=llama-3.3-70b-versatile
КЛЮЧ_RELAY=
МОДЕЛЬ_RELAY=gemini-3.6-flash
# АДРЕС_RELAY=https://api.relaymodels.com/v1
# ИИ_ПОРЯДОК=gemini,relay,groq

# --- Поток данных (OI, funding, taker) ---
# CoinGlass: ключ в кабинете https://www.coinglass.com/account · API: https://docs.coinglass.com/
КЛЮЧ_COINGLASS=
# auto = CoinGlass если ключ есть, иначе PerpFinder + Bybit
ПОТОК_РЫНКА=auto

# --- Логика разбора (крипто) ---
# true = H4→M5, один сценарий, без «каши» на графике
ЧТЕНИЕ_РЫНКА_ПО_ДОКАЗАТЕЛЬСТВАМ=true

# --- Биржи (пока опционально) ---
КЛЮЧ_BINANCE=
СЕКРЕТ_BINANCE=
КЛЮЧ_BYBIT=
СЕКРЕТ_BYBIT=

# --- Графики (PNG в Telegram / нефть BZUSDT) ---
# PRO story-chart по умолчанию; старый «full manual» только при SIGNAL_CHART_LEGACY=1
# SIGNAL_CHART_LEGACY=0
# UT-линии на нефти (по умолчанию выкл., чтобы не перекрывать сценарий)
# OIL_CHART_UT=0
# Короткая подпись (1–2 фразы) + на PNG только графика (паттерны, зоны, SMC)
# ED_MINIMAL_VOICE=1
# ED_CHART_VISUAL_ONLY=1
# SIGNAL_CHART_TV=1
# /set chart tv_annotated | annotated

# --- Прочее ---
ИНТЕРВАЛ_СКАНА_СЕК=1
ПАУЗА_СИГНАЛ_СЕК=90
КЛЮЧ_HORMUZ=
КЛЮЧ_X=
АДРЕС_REDIS=redis://redis:6379/0

# MT5 только Windows (нефть UKOUSD.s), если нужен Exact Cash:
# MT5_ПУТЬ=C:\Program Files\Bybit MT5 Terminal\terminal64.exe
# MT5_ЛОГИН=
# MT5_ПАРОЛЬ=
# MT5_СЕРВЕР=
