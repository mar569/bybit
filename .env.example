# Telegram bot token, get from @BotFather
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Telegram admin user id; only this user can control the bot
TELEGRAM_ADMIN_ID=123456789
# Optional: send signal alerts to a group/channel instead of admin DM (not both)
# Leave empty — signals go to TELEGRAM_ADMIN_ID private chat with the bot
# Pump/dump signals AND liquidation alerts (REKT-style) use this chat when set.
# 1) Add bot to the group
# 2) Send any message in the group
# 3) Open https://api.telegram.org/bot<TOKEN>/getUpdates and find "chat":{"id":-100...}
TELEGRAM_ALERT_CHAT_ID=

# Smart analysis chat: post-liquidation deep dives AND early anomaly radar (one chat).
# REQUIRED for analysis + anomaly messages — copy to .env and fill in.
# Liquidation analysis: strong coins (OI≥500k), liq from $10k, price move ≥2%.
# Anomalies (pump→dump, OI, funding): same chat, max ~3/min, ranked by importance.
# Steps:
#   1) Create a group/channel (can differ from TELEGRAM_ALERT_CHAT_ID)
#   2) Add the bot to that chat
#   3) Send any message there
#   4) Open https://api.telegram.org/bot<TOKEN>/getUpdates → find "chat":{"id":-100...}
#   5) Set TELEGRAM_ANALYSIS_CHAT_ID=-100xxxxxxxxxx
#   6) Restart bot → startup log should show analysis + anomaly ON
#   7) Test: /test_analysis in admin DM
TELEGRAM_ANALYSIS_CHAT_ID=

# Optional override: send anomalies to a different chat than analysis.
# Leave empty — anomalies go to TELEGRAM_ANALYSIS_CHAT_ID (recommended: one chat).
TELEGRAM_ANOMALY_CHAT_ID=

# Wave Watcher (Elliott 1–5 + Fib): dedicated chat or fallback to ANOMALY → ANALYSIS.
# Sends chart with global/local waves, Fib zone, entry/stop/TP, "what we wait next".
# Leave empty — uses TELEGRAM_ANOMALY_CHAT_ID, then TELEGRAM_ANALYSIS_CHAT_ID.
TELEGRAM_WAVE_CHAT_ID=

# Oil news & level alerts (Iran, US, Hormuz, crude). REQUIRED separate chat — set ID below.
# Exact Cash: MT5 UKOUSD.s (Windows only). Docker/Linux → BZUSDT fallback.
# Entry quality (default ON): session open block, anti-chase, close beyond level.
# oil_entry_session_filter=true
# oil_session_block_minutes=20
# oil_entry_chase_filter=true
# oil_entry_require_close=true
# Optional Windows MT5:
# MT5_TERMINAL_PATH=C:\Program Files\Bybit MT5 Terminal\terminal64.exe
# MT5_LOGIN=...
# MT5_PASSWORD=...
# MT5_SERVER=имя_сервера_из_MT5
# Labels: UKOUSD / USOIL.
# Enable in bot: panel «🛢 Нефть» or settings oil_news_enabled=true, then /oil for manual chart.
# Новостник: Google News (Иран/EIA/ОПЕК/Investing.com) + про-RSS OilPrice/EIA + прогнозы банков
# Fast-lane (default ON): WSJ/Reuters/Bloomberg/Investing/Blas/FT/NYT/White House/DoD/EIA
# → ‼️ КРИТИЧНО + Gemini (~каждые 60с). Toggle: oil panel «‼️ Fast» / oil_fastlane_enabled.
# Свежесть: ‼️ ≤4ч; обычные важные ≤24ч; жёсткий потолок 48ч (старше 2 суток — не шлём).
# + приоритет топ-аналитиков Javier Blas / John Kemp (Helima Croft, Amrita Sen).
# Commands: /oilwhy · /oilopen · /hormuz · /spr (EIA/SPR цифры) · /oilai <вопрос>
# Confluence setup (сильный LONG/SHORT) → TELEGRAM_MANUAL_TA_CHAT_ID; oil_setup_enabled=true.
# oil_pro_feeds_enabled=true (default) in settings.json
# Ормуз AIS: автопуш в Новостник при важном изменении (oil_hormuz_alerts_enabled).
# Сигналы входа (уровни/micro/bounce/confluence): oil_entry_signals_enabled в settings /
# кнопка «Входы» на панели Нефть (не зависит от сессии Bybit).
# Журнал сбылось/нет + лёгкое обучение: oil_outcome_learning_enabled (файл bot/oil_outcomes.json).
# Режим по умолчанию: только нефть UKOUSD.s (Bybit TradFi).
# Крипто-каналы (сигналы/ликвидации/волны/анализ) выключены — включи в панели «Каналы».
# Антиспам ручного TA: oil_setup_with_digest=false (не дублировать дайджест+вход);
# oil_ta_signal_gap_seconds=10800 (3ч); oil_setup_cooldown_seconds=14400 (4ч).
# Optional: HORMUZ_API_KEY for Hormuz Monitor traffic API (else straits.live + PortWatch)
TELEGRAM_OIL_NEWS_CHAT_ID=
HORMUZ_API_KEY=

# Manual TA chat: send a chart screenshot + ticker, pick 5m/10m/15m, get annotated analysis.
# Also receives oil UKOUSD/USOIL digest charts when oil monitor is enabled.
# 1) Create a Telegram group/channel for manual chart analysis
# 2) Add the bot to that chat
# 3) Get chat id via getUpdates (same as TELEGRAM_ALERT_CHAT_ID)
# 4) Set TELEGRAM_MANUAL_TA_CHAT_ID=-100xxxxxxxxxx
# 5) In that chat: photo + caption GRASSUSDT, or text GRASS 10m
TELEGRAM_MANUAL_TA_CHAT_ID=

# Optional exchange API keys for future authenticated features
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Free Gemini AI analyst (Google AI Studio: https://aistudio.google.com/apikey)
# Admin-only button «AI» on signals / TA. Also used for oil digest forecast if oil_forecast_gemini=true.
# Leave empty — oil forecast still works on rules only (без AI-комментария).
# Внимание: бесплатная квота МАЛЕНЬКАЯ. Авто-ИИ на каждую новость (oil_fastlane_gemini)
# быстро её сжигает — по умолчанию OFF; «Спросить ИИ» важнее.
GEMINI_API_KEY=
# Optional model override (default gemini-3.6-flash; auto-fallback to lite / 2.0-flash)
GEMINI_MODEL=gemini-3.6-flash

# Бесплатный запасной ИИ (Groq Llama) — если Gemini квота кончилась.
# Ключ: https://console.groq.com/keys  (лимиты обычно щедрее free Gemini)
# Бот сам переключится на Groq при 429 / паузе Gemini.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# Oil monitor: crash-алерты по цене UKOUSD идут в TELEGRAM_OIL_NEWS_CHAT_ID
# (пороги в settings.json: oil_crash_pct_15m/30m/60m). Wire: FinancialJuice + ForexLive RSS.
SCAN_INTERVAL_SECONDS=1
SIGNAL_COOLDOWN_SECONDS=90
