# Скопируйте:  cp .env.example .env
# Заполните секреты. Латиница (TELEGRAM_TOKEN) и русские имена (ТЕЛЕГРАМ_ТОКЕН) — эквивалентны.

# ========== Обязательно ==========
ТЕЛЕГРАМ_ТОКЕН=
ТЕЛЕГРАМ_ID_АДМИНА=
# Пусто = алерты сканера в личку админу
ТЕЛЕГРАМ_ЧАТ_АЛЕРТЫ=
# Опционально (если не нужен — оставьте пустым или закомментируйте)
# ТЕЛЕГРАМ_ЧАТ_АНАЛИЗ=
# ТЕЛЕГРАМ_ЧАТ_РУЧНОЙ_TA=
# ТЕЛЕГРАМ_ЧАТ_НЕФТЬ=
# Chat id: https://api.telegram.org/bot<ТОКЕН>/getUpdates

# ========== ИИ (опционально) ==========
КЛЮЧ_GEMINI=
МОДЕЛЬ_GEMINI=gemini-3.6-flash
КЛЮЧ_GROQ=
МОДЕЛЬ_GROQ=llama-3.3-70b-versatile
КЛЮЧ_RELAY=
МОДЕЛЬ_RELAY=gemini-3.6-flash
# АДРЕС_RELAY=https://api.relaymodels.com/v1
# ИИ_ПОРЯДОК=gemini,relay,groq

# ========== Рынок ==========
КЛЮЧ_COINGLASS=
ПОТОК_РЫНКА=auto
ЧТЕНИЕ_РЫНКА_ПО_ДОКАЗАТЕЛЬСТВАМ=true

# ========== Биржи (опционально) ==========
КЛЮЧ_BINANCE=
СЕКРЕТ_BINANCE=
КЛЮЧ_BYBIT=
СЕКРЕТ_BYBIT=

# ========== Инфра ==========
ИНТЕРВАЛ_СКАНА_СЕК=1
ПАУЗА_СИГНАЛ_СЕК=90
АДРЕС_REDIS=redis://redis:6379/0
КЛЮЧ_HORMUZ=
КЛЮЧ_X=

# ========== Графики и Telegram (важно) ==========
# Тип графика НЕ выбирается в .env и не через меню в боте.
# Крипта (сигнал + ручной /ta): один режим annotated — полный PNG + разметка TA.
# Источник задаётся в боте: /set chart annotated  и  /set manual_chart annotated
# (или bot/settings.json: signal_chart_source, manual_ta_chart_source).
#
# В .env ниже — только редкие переключатели. Если строк нет, работают дефолты в коде.
# Старые ED_* из прошлых версий можно удалить из своего .env — они больше не документируются здесь.
#
# ED_ENTRIES_ONLY=1          — в alert-канал в основном готовые входы (+ vertical WATCH по умолчанию)
# ED_MINIMAL_VOICE=0         — длинная подпись к PNG (1 = короткий текст, дефолт в коде)
# ED_CHART_MPL=1             — только matplotlib, без подложки TradingView
# ED_CHART_TV=0              — выкл. TV-подложку (если когда-то включали TV)
# OIL_CHART_UT=0             — UT-линии на нефтяных графиках
# ED_SIGNAL_CHART_PA=1       — сигналы: S/R 2px + паттерн/SMC/range (без trader-canvas каши)
# ED_SIGNAL_CHART_MAX_PATTERNS=3  — граф. фигуры на PNG (1–5, разные kind, conf≥0.52)
# ED_MANUAL_TA_PA=1          — /ta и Ed→anализ: тот же чистый S/R
# ED_SIGNAL_CHART_PA=0       — вернуть старый «налепленный» canvas (не рекомендуется)

# TA-Lib: в Docker ставится из requirements (wheel). Локально Windows — MSI ta-lib 0.8.x, затем pip install TA-Lib

# --- Hummingbot / Condor (исполнение сделок, отдельно от анализа) ---
# Установка API на хосте: bash deploy/hummingbot/install-api.sh
# Condor = второй Telegram-бот (condor.hummingbot.org), тот же API.
# Наш бот: /hbot — статус ботов и портфеля через REST.
# HUMMINGBOT_API_URL=http://host.docker.internal:8000
# HUMMINGBOT_API_USERNAME=
# HUMMINGBOT_API_PASSWORD=

# MT5 (Windows, Brent Cash UKOUSD.s — не работает в Linux/Docker):
# MT5_ПУТЬ=
# MT5_ЛОГИН=
# MT5_ПАРОЛЬ=
# MT5_СЕРВЕР=
